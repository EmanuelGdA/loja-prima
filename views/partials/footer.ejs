<!-- === MODAL DE LOGIN (DELAY + INTELIGENTE) === -->
<% if (!locals.isAuthenticated) { %>
    
    <!-- AVISO: Mudei o display para 'none' para começar invisível -->
    <div id="login-modal-overlay" style="
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);
        z-index: 99999; 
        display: none; /* COMEÇA ESCONDIDO */
        justify-content: center; align-items: center;
        animation: fadeIn 0.5s;
    ">
        <div style="
            background: white; padding: 30px; border-radius: 12px; text-align: center; 
            width: 90%; max-width: 400px; box-shadow: 0 10px 40px rgba(0,0,0,0.3);
            position: relative;
        ">
            <!-- Botão Fechar (X) -->
            <span onclick="fecharModalLogin()" 
                  style="position: absolute; top: 15px; right: 20px; font-size: 24px; cursor: pointer; color: #999;">
                  &times;
            </span>

            <h2 style="font-family: 'Playfair Display'; margin-bottom: 10px; color: #000;">Bem-vinda!</h2>
            <p style="color: #666; margin-bottom: 25px; font-size: 14px; line-height: 1.5;">
                Entre na sua conta para ver preços exclusivos, acompanhar pedidos e receber novidades.
            </p>
            
            <a href="/login" style="
                display: block; width: 100%; background: black; color: white; 
                padding: 12px; border-radius: 6px; font-weight: bold; text-decoration: none; margin-bottom: 10px; font-size: 14px;">
                FAZER LOGIN
            </a>
            
            <a href="/cadastro" style="
                display: block; width: 100%; border: 1px solid black; color: black; 
                padding: 12px; border-radius: 6px; font-weight: bold; text-decoration: none; font-size: 14px;">
                CRIAR CONTA
            </a>

            <p style="margin-top: 20px; font-size: 12px; color: #888; cursor: pointer; text-decoration: underline;" 
               onclick="fecharModalLogin()">
                Agora não, só quero dar uma olhadinha
            </p>
        </div>
    </div>

    <!-- SCRIPT DO TEMPORIZADOR -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Verifica em qual página estamos
            const path = window.location.pathname;

            // Se estiver na página de Login ou Cadastro, NÃO faz nada (sai da função)
            if (path.includes('/login') || path.includes('/cadastro')) {
                return;
            }

            // Configura o tempo de espera (5000 milissegundos = 5 segundos)
            // Você pode mudar o 5000 para 10000 (10 seg) se preferir
            setTimeout(() => {
                const modal = document.getElementById('login-modal-overlay');
                
                // Só mostra se o usuário ainda não fechou manualmente na mesma sessão (opcional, mas bom)
                if (modal && !sessionStorage.getItem('modalClosed')) {
                    modal.style.display = 'flex';
                }
            }, 5000); 
        });

        function fecharModalLogin() {
            document.getElementById('login-modal-overlay').style.display = 'none';
            // Salva na memória do navegador que ele fechou, para não abrir de novo na mesma navegação
            sessionStorage.setItem('modalClosed', 'true');
        }
    </script>
<% } %>
<!-- ========================================================== -->


<!-- SCRIPT OBRIGATÓRIO PARA O MENU FUNCIONAR -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        
        // 1. Menu Lateral (Abrir/Fechar)
        const menuBtn = document.querySelector('.mobile-menu-btn'); // Botão 3 riscos
        const closeBtn = document.querySelector('.close-menu-btn'); // Botão X dentro do menu
        const nav = document.querySelector('.main-nav');            // A gaveta
        const overlay = document.querySelector('.menu-overlay');    // Fundo escuro

        function toggleMenu() {
            if (nav) nav.classList.toggle('active');
            if (overlay) overlay.classList.toggle('active');
            
            // Trava a rolagem da página quando o menu está aberto
            if (document.body.style.overflow === 'hidden') {
                document.body.style.overflow = 'auto';
            } else {
                document.body.style.overflow = 'hidden';
            }
        }

        // Adiciona o evento de clique (se o elemento existir na tela)
        if (menuBtn) {
            menuBtn.addEventListener('click', (e) => {
                e.preventDefault();
                toggleMenu();
            });
        }
        
        if (closeBtn) closeBtn.addEventListener('click', toggleMenu);
        if (overlay) overlay.addEventListener('click', toggleMenu);


        // 2. Dropdown de Categorias no Celular (Clicar na setinha)
        const dropdownBtn = document.querySelector('.dropbtn');
        const dropdownLi = document.querySelector('.dropdown');

        if (dropdownBtn && window.innerWidth <= 768) {
            dropdownBtn.addEventListener('click', (e) => {
                e.preventDefault();
                if(dropdownLi) dropdownLi.classList.toggle('active');
            });
        }
    });
</script>

