<!-- SCRIPT DO MENU MOBILE (Adicionado Aqui) -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const menuBtn = document.querySelector('.mobile-menu-btn'); // 3 risquinhos
        const closeBtn = document.querySelector('.close-menu-btn'); // Botão X
        const nav = document.querySelector('.main-nav');            // A gaveta
        const overlay = document.querySelector('.menu-overlay');    // Fundo escuro

        function toggleMenu() {
            nav.classList.toggle('active');
            overlay.classList.toggle('active');
            // Trava a rolagem do fundo quando o menu abre
            document.body.style.overflow = nav.classList.contains('active') ? 'hidden' : 'auto';
        }

        if (menuBtn) menuBtn.addEventListener('click', (e) => { e.preventDefault(); toggleMenu(); });
        if (closeBtn) closeBtn.addEventListener('click', toggleMenu);
        if (overlay) overlay.addEventListener('click', toggleMenu); // Fecha se clicar fora
    });
</script>