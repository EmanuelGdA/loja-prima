    <!-- LOGICA DE LOGIN DIRETO (COM SUAS CHAVES REAIS) -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getAuth, signInWithPopup, GoogleAuthProvider } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";

        // SUAS CHAVES REAIS (Coladas aqui para funcionar em qualquer página)
       const firebaseConfig = {
  apiKey: "AIzaSyBZZFSFViRJdHbOFYergjUe2CzTxV3k65g",
  authDomain: "login.maelycristina.com.br",
  projectId: "maely-cristina-b0ce1",
  storageBucket: "maely-cristina-b0ce1.firebasestorage.app",
  messagingSenderId: "552721009488",
  appId: "1:552721009488:web:25b265e464d173cffb7a55",
  measurementId: "G-PSPG6F2CE5"
};

        const app = initializeApp(firebaseConfig);
        const auth = getAuth();
        const provider = new GoogleAuthProvider();

        // Essa função agora é global e chama o Google DIRETO
        window.loginWithGoogleFromModal = function() {
            signInWithPopup(auth, provider)
                .then((result) => {
                    // Pega o token e manda pro servidor
                    return result.user.getIdToken();
                })
                .then((token) => {
                    return fetch('/auth/google', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            // Tenta pegar o token CSRF se ele existir na página, senão vai vazio
                            'CSRF-Token': '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>'
                        },
                        body: JSON.stringify({ token: token })
                    });
                })
                .then(res => res.json())
                .then(data => {
                    if (data.status === 'success') {
                        // Recarrega a página atual já logado!
                        window.location.reload(); 
                    } else {
                        alert("Erro no servidor: " + data.message);
                    }
                })
                .catch((error) => {
                    console.error("Erro Google:", error);
                    alert("Erro ao conectar: " + error.message);
                });
        };
    </script>

    <!-- Timer do Modal -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const path = window.location.pathname;
            // Não mostra se já estiver na página de login (pra não ficar estranho)
            if (path.includes('/login')) return;

            // Timer de 5 segundos
            setTimeout(() => {
                const overlay = document.getElementById('login-modal-overlay');
                if (overlay && !sessionStorage.getItem('modalClosed')) {
                    overlay.style.display = 'flex';
                    setTimeout(() => overlay.classList.add('show'), 10);
                }
            }, 5000);
        });

        function fecharModalLogin() {
            const overlay = document.getElementById('login-modal-overlay');
            overlay.classList.remove('show');
            setTimeout(() => overlay.style.display = 'none', 300);
            sessionStorage.setItem('modalClosed', 'true');
        }
    </script>
<% } %>

