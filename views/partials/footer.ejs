<!-- Script Global do Whats -->
<script>
    function abrirWhatsGeral() {
        const phone = "5541999999999"; // COLOQUE O NÚMERO AQUI
        const msg = encodeURIComponent("Olá! Vim pelo site e gostaria de atendimento.");
        
        // Verifica se é celular
        const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);

        if (isMobile) {
            // Força o App no celular (sem abrir aba nova, direto pro app)
            window.location.href = `whatsapp://send?phone=${phone}&text=${msg}`;
        } else {
            // Web no PC
            window.open(`https://web.whatsapp.com/send?phone=${phone}&text=${msg}`, '_blank');
        }
    }
</script>