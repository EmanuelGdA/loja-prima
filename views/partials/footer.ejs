        .btn-google-modal img { width: 20px; }
        .btn-ignore {
            background: none; border: none; color: #999; font-size: 12px; text-decoration: underline; cursor: pointer; font-family: 'Montserrat', sans-serif;
        }

        /* Adicione este estilo para o novo botão */
