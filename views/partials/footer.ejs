<!-- SCRIPT PARA LIMPAR DADOS AO SAIR -->
<script>
    document.addEventListener("DOMContentLoaded", () => {
        // Pega todos os formulários de logout (do menu PC e Mobile)
        const logoutForms = document.querySelectorAll('form[action="/logout"]');

        logoutForms.forEach(form => {
            form.addEventListener('submit', () => {
                // Limpa os favoritos do navegador ao sair
                localStorage.removeItem('myFavorites');
                // Limpa o controle do modal de login para aparecer pro próximo usuário
                sessionStorage.removeItem('modalClosed');
            });
        });
    });
</script>

<!-- SCRIPT DE SINCRONIZAÇÃO DE FAVORITOS -->
<% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
<script>
    document.addEventListener("DOMContentLoaded", async () => {
        // Só roda se não tivermos sincronizado ainda nesta sessão para economizar dados
        // (Ou roda sempre para garantir, como é leve, vamos rodar sempre por segurança)
        try {
            const response = await fetch('/api/get-user-favorites');
            const cloudFavorites = await response.json();
            
            if (cloudFavorites && Array.isArray(cloudFavorites)) {
                // Mescla com o que já tem no local ou substitui. 
                // Vamos substituir para garantir que o banco é a verdade absoluta.
                localStorage.setItem('myFavorites', JSON.stringify(cloudFavorites));
                
                // Atualiza a bolinha do menu (mobile) se existir
                const badge = document.getElementById('mobileFavBadge');
                if (badge && cloudFavorites.length > 0) {
                    badge.innerText = cloudFavorites.length;
                    badge.style.display = 'flex';
                }
            }
        } catch (e) {
            console.log("Erro ao sincronizar favoritos");
        }
    });

    
</script>

<% } %>