<!-- views/partials/head.ejs -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pageTitle %></title>

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">

<!-- FontAwesome (Ícones) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<!-- Nosso CSS Principal -->
<link rel="stylesheet" href="/css/main.css">

<!-- views/partials/header.ejs -->
<header class="main-header">
    <!-- Barra de Avisos (Top Bar) -->
    <div class="top-bar">
        <p>FRETE GRÁTIS para todo o Brasil em compras acima de R$ 299,00</p>
    </div>

    <!-- Navegação Principal -->
    <div class="nav-container">
        <!-- Logo -->
        <div class="logo">
            <a href="/">Loja da Prima<span>.</span></a>
        </div>

        <!-- Menu Categorias -->
        <nav class="main-nav">
            <ul>
                <li><a href="/">Início</a></li>
                <li><a href="/colecao/lancamentos">Lançamentos</a></li>
                <li><a href="/colecao/vestidos">Vestidos</a></li>
                <li><a href="/colecao/promocao" class="promo-link">Sale</a></li>
            </ul>
        </nav>

        <!-- Ícones (Direita) -->
        <div class="user-actions">
            <a href="/search"><i class="fas fa-search"></i></a>
            
            <% if (isAuthenticated) { %>
                <a href="/user/dashboard"><i class="fas fa-user"></i></a>
                <form action="/logout" method="POST" style="display:inline;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn-logout"><i class="fas fa-sign-out-alt"></i></button>
                </form>
            <% } else { %>
                <a href="/login"><i class="far fa-user"></i></a>
            <% } %>

            <a href="/carrinho" class="cart-icon">
                <i class="fas fa-shopping-bag"></i>
                <span class="badge">0</span> <!-- Faremos a lógica do número depois -->
            </a>
        </div>
        
        <!-- Menu Mobile (Hambúrguer) -->
        <div class="mobile-menu-btn">
            <i class="fas fa-bars"></i>
        </div>
    </div>
</header>