<header class="main-header">
    
    <!-- 1. NAVEGAÇÃO E LOGO -->
    <div class="nav-container">
        <!-- Menu Mobile (Esquerda) -->
        <div class="mobile-menu-btn">
            <i class="fas fa-bars"></i>
        </div>

        <!-- Logo (Centro) -->
        <div class="logo">
            <a href="/" style="display: flex; align-items: center; gap: 10px; text-decoration: none;">
                <img src="/img/ui/logo.png" alt="Logo" style="height: 60px; width: auto;">
                <!-- O CSS esconde este texto no celular -->
                <span class="desktop-name" style="font-family: 'Playfair Display', serif; font-size: 35px; color: #000; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">
                    Maely Cristina
                </span>
            </a>
        </div>
        
        <!-- Menu Lateral (Drawer) -->
        <nav class="main-nav">
            <!-- Cabeçalho do Menu Mobile (Novo) -->
            <div class="mobile-nav-header">
                <span style="font-family: 'Playfair Display'; font-weight: bold; font-size: 18px;">MENU</span>
                <span class="close-menu-btn">&times;</span> <!-- Botão X -->
            </div>

            <ul>
                <li><a href="/">Início</a></li>
                
                <!-- === MENU DINÂMICO DE CATEGORIAS (DROPDOWN) === -->
                
                <!-- Link Principal que abre o Dropdown -->
                <li class="dropdown">
                    <a href="#" class="dropbtn">Categorias <i class="fas fa-chevron-down" style="font-size: 10px; margin-left: 5px;"></i></a>
                    
                    <!-- Conteúdo do Dropdown -->
                    <div class="dropdown-content">
                        <% if (typeof menuCategories !== 'undefined' && menuCategories.length > 0) { %>
                            <% menuCategories.forEach(cat => { %>
                                <div class="dropdown-item">
                                    <!-- Nome da Categoria Principal -->
                                    <a href="/colecao/<%= cat.id %>" class="cat-title"><%= cat.name %></a>
                                    
                                    <!-- Subcategorias -->
                                    <% if (cat.subcategories && cat.subcategories.length > 0) { %>
                                        <div class="sub-links">
                                            <% cat.subcategories.forEach(sub => { %>
                                                <!-- Link busca por categoria E texto da subcategoria -->
                                                <a href="/colecao/<%= cat.id %>/<%= sub %>"><%= sub %></a>
                                            <% }) %>
                                        </div>
                                    <% } %>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <span style="padding: 10px; display:block; color: #999;">Sem categorias</span>
                        <% } %>
                    </div>
                </li>
                <!-- ============================================== -->

                <li><a href="/colecao/lancamentos">Lançamentos</a></li>
                <li>
    <a href="/colecao/promocao" class="promo-link" style="color: #d9534f !important; font-weight: 800;">
        PROMOÇÕES
    </a>
</li>
                
                <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                    
                    <!-- BOTÃO ADMIN (DROPDOWN / GAVETA) -->
                    <li class="dropdown">
                        <a href="#" class="dropbtn" style="color: #c4a47c; font-weight: 800; letter-spacing: 1px;">
                            ADMIN <i class="fas fa-lock" style="font-size: 10px; margin-left: 5px;"></i>
                        </a>
                        
                        <!-- A GAVETA COM AS OPÇÕES -->
                        <div class="dropdown-content">
                            <!-- Link 1: Vendas -->
                            <div class="dropdown-item">
                                <a href="/admin/pedidos" class="cat-title" style="color: #333 !important;">GESTÃO DE VENDAS</a>
                            </div>

                            <!-- Link 2: Produtos -->
                            <div class="dropdown-item">
                                <a href="/admin/produtos" class="cat-title" style="color: #333 !important;">MEUS PRODUTOS</a>
                            </div>

                            <!-- Link 3: Banners -->
                            <div class="dropdown-item">
                                <a href="/admin/banners" class="cat-title" style="color: #333 !important;">BANNERS DO SITE</a>
                            </div>

                            <!-- Link 4: Cupons -->
                            <div class="dropdown-item">
                                <a href="/admin/cupons" class="cat-title" style="color: #333 !important;">CUPONS</a>
                            </div>

                            <div class="dropdown-item">
                               <a href="/admin/clientes" class="cat-title" style="color: #333 !important;">CLIENTES / MIMOS 🎁</a>
                            </div>

                            <div class="dropdown-item">
                                <a href="/admin/aniversariantes" class="cat-title" style="color: #333 !important;">ANIVERSARIANTES 🎂</a>
                            </div>
                        </div>
                    </li>

                <% } %>

                 <!-- BOTÃO DE SAIR (COM CLASSE PARA APARECER SÓ NO MOBILE) -->
                <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
                    <li class="mobile-only-item" style="margin-top: 20px; border-top: 1px solid #eee;">
        <a href="/logout" style="
            display: flex; align-items: center; gap: 10px;
            padding: 15px 25px; color: #d9534f; font-weight: bold;
            font-family: 'Montserrat', sans-serif; font-size: 14px;
            text-transform: uppercase; text-decoration: none; letter-spacing: 1px;">
            <i class="fas fa-sign-out-alt"></i> Sair da Conta
        </a>
    </li>
                <% } else { %>
                    <!-- SE NÃO TIVER LOGADO, MOSTRA ENTRAR (SÓ NO MOBILE) -->
                    <li class="mobile-only-item" style="margin-top: 20px; border-top: 1px solid #eee;">
                        <a href="/login" style="color: black; font-weight: bold; display: block; padding: 15px 25px;">
                            <i class="far fa-user"></i> Entrar / Cadastrar
                        </a>
                    </li>
                <% } %>

            </ul>
        </nav>

        <!-- Fundo Escuro (Overlay) - Adicione isso logo DEPOIS do </nav> -->
        <div class="menu-overlay"></div>

        <!-- Ícones (Direita) -->
        <div class="user-actions">
            <!-- Busca -->
            <form action="/search" method="GET" class="search-form">
                <input type="text" name="q" placeholder="Buscar...">
                <button type="submit"><i class="fas fa-search"></i></button>
            </form>
            
            <a href="/favoritos" title="Meus Favoritos">
                <i class="far fa-heart"></i>
            </a>

            <% if (isAuthenticated) { %>
                <a href="/pedidos" title="Meus Pedidos"><i class="fas fa-user"></i></a>
    
    <!-- LINK DE SAIR CORRIGIDO -->
    <a href="/logout" title="Sair" style="margin-left: 10px; color: #000; text-decoration: none; font-size: 16px;">
        <i class="fas fa-sign-out-alt"></i>
    </a>
            <% } else { %>
                <a href="/login"><i class="far fa-user"></i></a>
            <% } %>

            <a href="/carrinho" class="cart-icon">
                <i class="fas fa-shopping-bag"></i>
                <span class="badge"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>
            </a>
        </div>
    </div>

    <!-- 2. FAIXA DE FRETE ANIMADA -->
    <div class="top-bar-marquee">
        <div class="marquee-content">
            <span>FRETE GRÁTIS PARA TODO O BRASIL EM COMPRAS ACIMA DE R$ 499,00  •  ENVIAMOS PARA TODO O BRASIL</span>
        </div>
    </div>

    <!-- AVISO DE PERFIL INCOMPLETO -->
<% if (typeof isAuthenticated !== 'undefined' && isAuthenticated && isProfileIncomplete) { %>
    <div class="profile-alert-bar">
        <div class="container-alert">
            <i class="fas fa-gift"></i>
            <span>Olá! Complete seu cadastro para ganhar mimos.</span>
            <a href="/pedidos">Completar Agora</a>
        </div>
    </div>

    <style>
        .profile-alert-bar {
            background-color: #fff9db;
            color: #856404;
            padding: 10px 0;
            font-size: 12px;
            text-align: center;
            border-bottom: 1px solid #ffe066;
            font-family: 'Montserrat', sans-serif;
        }

        .container-alert {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap; /* Permite que os itens quebrem linha */
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 15px;
        }

        .profile-alert-bar i {
            margin-right: 8px;
            color: #d9ae50;
        }

        .profile-alert-bar a {
            color: #856404;
            font-weight: bold;
            text-decoration: underline;
            margin-left: 10px;
            text-transform: uppercase;
            font-size: 11px;
        }

        /* --- AJUSTE PARA CELULAR --- */
        @media (max-width: 600px) {
            .profile-alert-bar span {
                display: inline; /* Mantém o texto principal na linha do ícone */
            }
            .profile-alert-bar a {
                display: block; /* Força o link a ir para a linha de baixo */
                width: 100%;    /* Garante que ocupe a largura toda para centralizar */
                margin-left: 0; /* Remove a margem da esquerda que existia no desktop */
                margin-top: 5px; /* Dá um espacinho entre o texto e o botão */
            }
        }
    </style>
<% } %>

</header>