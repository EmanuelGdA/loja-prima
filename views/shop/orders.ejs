<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('../partials/head.ejs') %>
    <style>
        .orders-container { max-width: 800px; margin: 40px auto; padding: 0 20px; }
        .page-title { font-family: 'Playfair Display'; text-align: center; margin-bottom: 40px; }
        
        .orders-list { display: flex; flex-direction: column; gap: 20px; }

        .order-card { 
            background: white; 
            border: 1px solid #eee; 
            border-radius: 12px; /* Mais arredondado */
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0,0,0,0.03);
            transition: 0.3s;
        }

        /* Cabeçalho do Card */
        .order-header { 
            background: #f9f9f9;
            padding: 15px 20px; 
            border-bottom: 1px solid #eee;
            display: flex; 
            justify-content: space-between; 
            align-items: center;
        }

        .order-info { font-size: 14px; color: #555; display: flex; flex-direction: column; gap: 2px; }
        .order-id { font-weight: bold; color: #000; text-transform: uppercase; }
        .order-date { font-size: 12px; color: #888; }
        
        /* Badges de Status */
        .status-badge { 
            padding: 6px 12px; 
            border-radius: 20px; 
            font-size: 11px; 
            font-weight: bold; 
            text-transform: uppercase;
            white-space: nowrap; /* Não quebra linha */
        }
        .status-aguardando { background: #fff3cd; color: #856404; }
        .status-pago { background: #d1e7dd; color: #0f5132; }
        .status-enviado { background: #cff4fc; color: #055160; }
        .status-cancelado { background: #f8d7da; color: #842029; }

        /* Lista de Itens */
        .order-body { padding: 20px; }
        .item-row { 
            display: flex; justify-content: space-between; 
            margin-bottom: 10px; font-size: 14px; 
            border-bottom: 1px solid #f9f9f9; padding-bottom: 10px;
        }
        .item-row:last-child { border: none; padding-bottom: 0; }
        
        .order-total { 
            border-top: 1px solid #eee; 
            padding-top: 15px; margin-top: 10px; 
            text-align: right; font-size: 18px; font-weight: 700; color: var(--black); 
        }

        .no-orders { text-align: center; color: #888; margin-top: 50px; padding: 40px; }
        .btn-shop { background: black; color: white; padding: 10px 20px; border-radius: 30px; margin-top: 15px; display: inline-block; font-size: 13px; font-weight: bold; }

        /* --- RESPONSIVIDADE (Correção do Bug) --- */
        @media (max-width: 600px) {
            .order-header {
                flex-direction: column; /* Empilha os itens */
                align-items: flex-start; /* Alinha à esquerda */
                gap: 10px;
            }
            
            .order-info { width: 100%; }
            
            .status-badge {
                align-self: flex-start; /* Badge fica na esquerda */
                font-size: 10px;
            }

            .item-row { flex-direction: column; gap: 5px; }
            .item-price { font-weight: bold; }
        }
    </style>
</head>
<body>
    <%- include('../partials/header.ejs') %>

    <main class="orders-container">
        <h1 class="page-title">Meus Pedidos</h1>

        <% if (orders.length > 0) { %>
            <div class="orders-list">
                <% orders.forEach(order => { %>
                    <!-- Lógica de cores do status -->
                    <% 
                        let sClass = 'status-aguardando';
                        let sText = order.status || 'Pendente';
                        if(sText.includes('Pago') || sText.includes('Aprovado')) sClass = 'status-pago';
                        if(sText.includes('Enviado')) sClass = 'status-enviado';
                        if(sText.includes('Cancelado') || sText.includes('Recusado')) sClass = 'status-cancelado';
                    %>

                    <div class="order-card">
                        <!-- Cabeçalho (Data, ID, Status) -->
                        <div class="order-header">
                            <div class="order-info">
                                <span class="order-id">Pedido #<%= order.id.slice(0, 8) %>...</span>
                                <span class="order-date"><%= new Date(order.date).toLocaleDateString('pt-BR') %> às <%= new Date(order.date).toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'}) %></span>
                                
                               <!-- RASTREIO CLICÁVEL -->
<% if (order.trackingCode) { %>
    <a href="https://www.linkcorreios.com.br/<%= order.trackingCode %>" target="_blank" 
       style="color: #2ecc71; font-weight: bold; font-size: 12px; margin-top: 5px; display: inline-block; text-decoration: underline;">
        <i class="fas fa-search-location"></i> Rastrear: <%= order.trackingCode %>
    </a>
<% } %>
                            </div>
                            <span class="status-badge <%= sClass %>"><%= sText %></span>
                        </div>

                        <!-- Itens -->
                        <div class="order-body">
                            <% order.items.forEach(item => { %>
                                <div class="item-row">
                                    <span><%= item.qty %>x <%= item.title %> (Tam: <%= item.size %>)</span>
                                    <span class="item-price">R$ <%= (item.price * item.qty).toFixed(2).replace('.', ',') %></span>
                                </div>
                            <% }) %>
                            
                            <!-- Se tiver frete -->
                            <% if (order.shippingCost > 0) { %>
                                <div class="item-row" style="color: #666; font-size: 13px;">
                                    <span>Frete (<%= order.shippingMethod %>)</span>
                                    <span>R$ <%= order.shippingCost.toFixed(2).replace('.', ',') %></span>
                                </div>
                            <% } %>

                            <!-- Se tiver desconto -->
                            <% if (order.discountTotal && order.subtotal && order.subtotal > order.discountTotal) { %>
                                <div class="item-row" style="color: #2ecc71; font-size: 13px;">
                                    <span>Desconto Cupom</span>
                                    <span>- R$ <%= (order.subtotal - order.discountTotal).toFixed(2).replace('.', ',') %></span>
                                </div>
                            <% } %>

                            <div class="order-total">
                                Total: R$ <%= parseFloat(order.totalPrice).toFixed(2).replace('.', ',') %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="no-orders">
                <i class="fas fa-shopping-bag" style="font-size: 40px; margin-bottom: 15px; opacity: 0.2;"></i>
                <p>Você ainda não fez nenhum pedido.</p>
                <a href="/" class="btn-shop">Começar a comprar</a>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer.ejs') %>
</body>
</html>