<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('../partials/head.ejs') %>
    <style>
        .page-container { max-width: 900px; margin: 40px auto; padding: 0 20px; }
        .page-title { 
            font-family: 'Playfair Display', serif; 
            text-align: center; margin-bottom: 40px; font-size: 32px; 
        }

        /* CARD DO PEDIDO */
        .client-order-card {
            background: white; border: 1px solid #eee; border-radius: 12px;
            margin-bottom: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            overflow: hidden; transition: 0.3s;
        }
        .client-order-card:hover { border-color: #ddd; box-shadow: 0 8px 20px rgba(0,0,0,0.05); }

        /* CABEÇALHO (Clicável) */
        .card-header {
            padding: 20px; background: #fff; cursor: pointer;
            display: flex; justify-content: space-between; align-items: center;
            border-bottom: 1px solid transparent;
        }
        .card-header.active { border-bottom-color: #f0f0f0; background: #fafafa; }

        .header-left span { display: block; }
        .order-id { font-weight: 800; font-family: 'Montserrat'; font-size: 15px; color: #000; }
        .order-date { font-size: 12px; color: #888; margin-top: 2px; }

        .header-right { text-align: right; }
        .order-total { font-weight: 700; font-size: 16px; color: #000; display: block; }
        
        .expand-btn { font-size: 11px; color: #666; display: flex; align-items: center; justify-content: flex-end; gap: 5px; margin-top: 5px; }
        .arrow { transition: transform 0.3s; }
        .card-header.active .arrow { transform: rotate(180deg); }

        /* TAG DE STATUS */
        .status-tag {
            display: inline-block; padding: 4px 10px; border-radius: 4px;
            font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;
            margin-top: 5px;
        }
        .st-aguardando { background: #fff3cd; color: #856404; }
        .st-pago { background: #d1e7dd; color: #0f5132; }
        .st-enviado { background: #cff4fc; color: #055160; }
        .st-cancelado { background: #f8d7da; color: #842029; }
        .st-retirada { background: #e1bee7; color: #4a148c; } /* Roxo */

        /* CORPO (Detalhes) */
        .card-body { display: none; padding: 25px; animation: slideDown 0.3s; }
        .card-body.open { display: block; }

        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 25px; }
        
        .info-title { font-size: 11px; text-transform: uppercase; font-weight: 700; color: #999; margin-bottom: 10px; display: block; letter-spacing: 0.5px; }
        .info-text { font-size: 13px; color: #333; line-height: 1.5; margin-bottom: 4px; }
        .info-highlight { color: #000; font-weight: 600; }

        /* LISTA DE PRODUTOS */
        .order-items { border: 1px solid #f0f0f0; border-radius: 8px; overflow: hidden; }
        .item-row { display: flex; align-items: center; padding: 15px; border-bottom: 1px solid #f0f0f0; }
        .item-row:last-child { border: none; }
        
        .item-thumb { width: 50px; height: 65px; object-fit: cover; border-radius: 4px; background: #eee; margin-right: 15px; }
        
        .item-details { flex: 1; }
        .item-name { font-weight: 600; font-size: 13px; display: block; color: #000; }
        
        /* CORREÇÃO DA BOLINHA DE COR */
        .variant-tag { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; color: #666; margin-top: 3px; background: #f9f9f9; padding: 2px 8px; border-radius: 4px; }
        .color-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; border: 1px solid #ccc; }

        /* BOTÕES DE AÇÃO */
        .action-area { margin-top: 25px; border-top: 1px solid #f0f0f0; padding-top: 20px; text-align: right; }
        
        .btn-track { display: inline-flex; align-items: center; gap: 6px; color: #007bff; text-decoration: none; font-size: 13px; font-weight: 600; margin-right: 15px; }
        
        .btn-pay { 
            background: #27ae60; color: white; padding: 12px 30px; border-radius: 30px; 
            text-decoration: none; font-weight: 700; font-size: 12px; display: inline-block; 
            box-shadow: 0 4px 10px rgba(39, 174, 96, 0.3); transition: 0.2s;
        }
        .btn-pay:hover { background: #219150; transform: translateY(-2px); }

        .empty-state { text-align: center; padding: 80px 20px; color: #999; }

        @media (max-width: 600px) {
            .info-grid { grid-template-columns: 1fr; gap: 20px; }
            .action-area { text-align: center; display: flex; flex-direction: column; gap: 15px; }
            .btn-pay { width: 100%; }
        }
        @keyframes slideDown { from {opacity:0; transform:translateY(-10px);} to {opacity:1; transform:translateY(0);} }

        /* NOVOS ESTILOS: ABAS E PERFIL */
        .account-tabs { display: flex; justify-content: center; gap: 20px; margin-bottom: 30px; border-bottom: 1px solid #eee; }
        .tab-link { padding: 10px 20px; cursor: pointer; font-weight: 600; color: #999; border-bottom: 2px solid transparent; transition: 0.3s; font-family: 'Montserrat', sans-serif; font-size: 14px; }
        .tab-link.active { color: #000; border-bottom-color: #000; }
        
        .tab-content { display: none; }
        .tab-content.active { display: block; }

        .profile-card { 
            background: white; padding: 30px; border-radius: 12px; border: 1px solid #eee; 
            max-width: 500px; margin: 0 auto; box-shadow: 0 4px 15px rgba(0,0,0,0.03); 
        }
        .form-group-profile { margin-bottom: 20px; text-align: left; }
        .form-group-profile label { display: block; font-size: 11px; font-weight: bold; margin-bottom: 8px; color: #666; text-transform: uppercase; }
        .form-group-profile input { 
            width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 8px; 
            background: #f9f9f9; font-family: 'Montserrat'; box-sizing: border-box;
        }
        .form-group-profile input[readonly] { color: #999; cursor: not-allowed; }
        .btn-update { 
            width: 100%; background: black; color: white; padding: 15px; border-radius: 30px; 
            border: none; font-weight: bold; cursor: pointer; transition: 0.3s; 
        }
        .btn-update:hover { opacity: 0.8; }

        /* Estilo do Alerta de Sucesso */
.alert-success {
    background-color: #d4edda;
    color: #155724;
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 20px;
    border: 1px solid #c3e6cb;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    justify-content: center;
}

/* Deixa o Calendário (Input Date) mais bonito */
input[type="date"] {
    appearance: none;
    -webkit-appearance: none;
    color: #333;
    font-family: 'Montserrat', sans-serif;
    cursor: pointer;
    background-color: #f9f9f9;
}

/* Ajuste para o ícone do calendário ficar visível e clicável */
input[type="date"]::-webkit-calendar-picker-indicator {
    cursor: pointer;
    filter: invert(0.5); /* Deixa o ícone cinza elegante */
}
    </style>
</head>
<body>
    <%- include('../partials/header.ejs') %>

    <main class="page-container">
        <h1 class="page-title">Meus Pedidos</h1>

        <% if (successMessage && successMessage.length > 0) { %>
    <div class="alert-success" style="background: #d4edda; color: #155724; padding: 15px; border-radius: 8px; margin-bottom: 20px; text-align: center; border: 1px solid #c3e6cb; font-weight: bold;">
        <i class="fas fa-check-circle"></i> <%= successMessage %>
    </div>
<% } %>

        <!-- SELETOR DE ABAS -->
        <div class="account-tabs">
            <div class="tab-link active" onclick="openTab(event, 'tab-pedidos')">Meus Pedidos</div>
            <div class="tab-link" onclick="openTab(event, 'tab-dados')">Meus Dados</div>
        </div>

        <div id="tab-pedidos" class="tab-content active">

        <% if (orders.length > 0) { %>
            <div>
                <% orders.forEach(order => { %>
                    <% 
                        let sClass = 'st-aguardando';
                        if(order.status.includes('Pago')) sClass = 'st-pago';
                        if(order.status.includes('Enviado')) sClass = 'st-enviado';
                        if(order.status === 'Aguardando Retirada') sClass = 'st-retirada';
                        if(order.status.includes('Cancelado')) sClass = 'st-cancelado';
                    %>

                    <div class="client-order-card">
                        <!-- CABEÇALHO CLICÁVEL -->
                        <div class="card-header" onclick="toggleDetails('<%= order.id %>')">
                            <div class="header-left">
                                <span class="order-id">#<%= order.id.slice(0,6).toUpperCase() %></span>
<span class="order-date">
    <%= new Date(order.date).toLocaleDateString('pt-BR') %> às 
    <%= new Date(order.date).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) %>
</span>
                                <span class="status-tag <%= sClass %>"><%= order.status %></span>
                            </div>
                            <div class="header-right">
    <% 
        // LÓGICA DE EXIBIÇÃO INTELIGENTE:
        // Se o pedido está pendente, mostramos o valor base (peças + frete).
        // Se já foi pago, mostramos o valor final que foi cobrado.
        let valorExibicao = order.totalPrice;

        if (order.status === 'Aguardando Pagamento') {
            // Soma o valor base das peças (após cupom) + o custo do frete
            const basePecas = order.baseProdutos || order.subtotal;
            valorExibicao = basePecas + (order.shippingCost || 0);
        }
    %>
    <span class="order-total">R$ <%= parseFloat(valorExibicao).toFixed(2).replace('.', ',') %></span>
    <div class="expand-btn">
        Ver detalhes <i class="fas fa-chevron-down arrow" id="arrow-<%= order.id %>"></i>
    </div>
</div>
                        </div>

                        <!-- CORPO (Detalhes) -->
                        <div class="card-body" id="body-<%= order.id %>">
                            
                            <div class="info-grid">
                                <!-- CORREÇÃO 1: ENDEREÇO OU RETIRADA -->
                                <div>
                                    <span class="info-title">Entrega</span>
                                    
                                    <% if (order.shippingMethod && order.shippingMethod.includes('Retirar')) { %>
                                        <!-- CASO SEJA RETIRADA -->
    <div class="info-text" style="color: #0f5132; background: #e8f5e9; padding: 15px; border-radius: 8px; border: 1px solid #c3e6cb; line-height: 1.4;">
        <strong style="display:block; margin-bottom:8px; font-size: 14px;">
            <i class="fas fa-map-marker-alt"></i> Ponto de Retirada:
        </strong>
        
        <span style="display: block; font-weight: 600; color: #000;">Loja Maely Cristina</span>
        <span style="display: block;">Rua Curupis, 2001 - Portão</span>
        <span style="display: block; margin-bottom: 8px;">Curitiba - PR</span>

        <small style="display: block; border-top: 1px dashed #c3e6cb; padding-top: 8px; font-size: 12px;">
            <strong>Horário:</strong> Seg-Sex 10h às 17h<br>
            <span style="margin-left: 51px;">Sábado 10h às 14h</span>
        </small>

        <small style="display: block; margin-top: 12px; font-style: italic; color: #27ae60; font-size: 11px; border-top: 1px solid rgba(0,0,0,0.05); padding-top: 8px;">
            <i class="fas fa-info-circle"></i> A loja entrará em contato após a confirmação do pagamento para agendar a retirada.
        </small>
    </div>

                                    <% } else { %>
                                        <!-- CASO SEJA ENVIO (CORREIOS/LOGGI) -->
                                        <div class="info-text">
                                            <%= order.address.rua %>, <%= order.address.numero %><br>
                                            <%= order.address.bairro %><br>
                                            <%= order.address.cidade %>/<%= order.address.estado %><br>
                                            CEP: <%= order.address.cep %>
                                        </div>
                                        <div class="info-text" style="margin-top: 5px; color: #666; font-size: 12px;">
                                            Método: <%= order.shippingMethod %>
                                        </div>
                                    <% } %>
                                </div>

                                <div>
                                    <span class="info-title">Pagamento</span>
                                    <div class="info-text">Método: <strong style="text-transform: uppercase;"><%= order.paymentMethod %></strong></div>
                                    <div class="info-text">Frete: R$ <%= (order.shippingCost || 0).toFixed(2).replace('.', ',') %></div>
                                </div>
                            </div>

                            <span class="info-title">Produtos</span>
                            <div class="order-items">
                                <% order.items.forEach(item => { %>
                                    <div class="item-row">
                                        <!-- FOTO (Se tiver, senão usa ícone) -->
                                        <% if(item.imageUrl) { %>
                                            <img src="<%= item.imageUrl %>" class="item-thumb">
                                        <% } else { %>
                                            <div class="item-thumb" style="display:flex;align-items:center;justify-content:center;"><i class="fas fa-tshirt"></i></div>
                                        <% } %>

                                        <!-- Procure este trecho e substitua -->
<div class="item-details">
    <span class="item-name">
        <!-- ADICIONADO: Quantidade x Nome -->
        <%= item.qty %>x <%= item.title %>
    </span>
    
    <div class="variant-tag">
        <span>Tam: <%= item.size %></span>
        <% if(item.color && item.color !== 'Única') { %>
            <span style="color:#ddd;">|</span>
            <% if(item.color.startsWith('#')) { %>
                <span class="color-dot" style="background-color: <%= item.color %>;"></span>
            <% } else { %>
                Cor: <%= item.color %>
            <% } %>
        <% } %>
    </div>
</div>

<span style="font-weight: 600; font-size: 13px; text-align: right;">
    <!-- Exibe o total daquela linha (Preço x Qtd) -->
    R$ <%= (item.price * item.qty).toFixed(2).replace('.', ',') %>
    <br>
    <small style="font-weight: 400; color: #888; font-size: 10px;">
        unid: R$ <%= item.price.toFixed(2).replace('.', ',') %>
    </small>
</span>
                                    </div>
                                <% }) %>
                            </div>

                            <!-- BOTÕES DE AÇÃO -->
                            <div class="action-area">
                                <!-- Rastreio (Se tiver) -->
                                <% if (order.trackingCode) { %>
                                    <a href="https://www.linkcorreios.com.br/<%= order.trackingCode %>" target="_blank" class="btn-track">
                                        <i class="fas fa-truck"></i> Rastrear Entrega
                                    </a>
                                <% } %>

                                <!-- Pagar Agora (Se estiver pendente) -->
                                <% if (order.status === 'Aguardando Pagamento') { %>
                                    <span style="font-size: 12px; color: #888; margin-right: 10px;">Ainda não pagou?</span>
                                    <a href="/pagar-pedido/<%= order.id %>" class="btn-pay">
                                        <i class="fas fa-wallet"></i> PAGAR AGORA
                                    </a>
                                <% } %>
                            </div>

                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <h3>Nenhum pedido encontrado.</h3>
                <a href="/" style="text-decoration: underline;">Voltar à loja</a>
            </div>

        <% } %>

        </div> <!-- FECHA A ABA DE PEDIDOS -->

<!-- ADICIONE TODO ESSE BLOCO: ABA DE MEUS DADOS -->
<div id="tab-dados" class="tab-content">
    <div class="profile-card">
        <form action="/perfil/atualizar" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            
            <div class="form-group-profile">
                <label>E-mail (Login)</label>
                <input type="text" value="<%= user.email %>" readonly>
            </div>

            <div class="form-group-profile">
                <label>Nome Completo</label>
                <input type="text" name="name" value="<%= user.name %>" required>
            </div>

            <!-- WHATSAPP E DATA DE NASCIMENTO -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                <div class="form-group-profile">
                    <label>WhatsApp</label>
                    <input type="text" name="phone" value="<%= user.phone || '' %>" placeholder="(00) 00000-0000" oninput="maskPhone(this)" required>
                </div>
                <div class="form-group-profile" style="background: #fff9db; padding: 10px; border-radius: 8px; border: 1px solid #ffe066;">
                    <label style="color: #856404; font-size: 10px;">🎁 Aniversário</label>
                    <input type="date" name="birthday" value="<%= user.birthday || '' %>" required style="background: white; border-color: #ffe066; padding: 8px;">
                </div>
            </div>

            <!-- ENDEREÇO PARA MIMOS -->
            <h3 style="font-size: 14px; margin: 20px 0 15px; border-bottom: 1px solid #eee; padding-bottom: 5px;">Endereço para Mimos 🏠</h3>
            
            <div class="form-group-profile">
                <label>CEP</label>
                <input type="text" name="cep" id="cep" value="<%= user.cep || '' %>" placeholder="00000-000" oninput="maskCEP(this)" onblur="buscarCepPerfil()" required>
            </div>

            <div style="display: grid; grid-template-columns: 3fr 1fr; gap: 10px;">
                <div class="form-group-profile">
                    <label>Rua</label>
                    <input type="text" name="rua" id="rua" value="<%= user.rua || '' %>" required>
                </div>
                <div class="form-group-profile">
                    <label>Nº</label>
                    <input type="text" name="numero" value="<%= user.numero || '' %>" required>
                </div>
            </div>

            <div class="form-group-profile">
                <label>Bairro</label>
                <input type="text" name="bairro" id="bairro" value="<%= user.bairro || '' %>" required>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <div class="form-group-profile">
                    <label>Cidade</label>
                    <input type="text" name="cidade" id="cidade" value="<%= user.cidade || '' %>" required>
                </div>
                <div class="form-group-profile">
                    <label>Estado</label>
                    <input type="text" name="estado" id="estado" value="<%= user.estado || '' %>" required maxlength="2">
                </div>
            </div>

            <button type="submit" class="btn-update">SALVAR MEUS DADOS</button>
        </form>
    </div>
</div>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
    // 1. Lógica do Acordeão de Pedidos (Mantida)
    function toggleDetails(id) {
        const body = document.getElementById('body-' + id);
        const arrow = document.getElementById('arrow-' + id);
        const header = body.previousElementSibling;

        if (body && arrow && header) {
            body.classList.toggle('open');
            header.classList.toggle('active');
        }
    }

    // 2. Lógica de Troca de Abas (Mantida)
    function openTab(evt, tabName) {
        var i, tabcontent, tablinks;
        tabcontent = document.getElementsByClassName("tab-content");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].classList.remove("active");
        }
        tablinks = document.getElementsByClassName("tab-link");
        for (i = 0; i < tablinks.length; i++) {
            tablinks[i].classList.remove("active");
        }
        document.getElementById(tabName).classList.add("active");
        if (evt) {
            evt.currentTarget.classList.add("active");
        }
    }

    // 3. Máscara de WhatsApp (NOVA)
    function maskPhone(i) {
        let v = i.value.replace(/\D/g, ""); // Remove tudo que não é número
        if (v.length > 11) v = v.substring(0, 11); // Limita a 11 dígitos
        
        v = v.replace(/^(\d{2})(\d)/g, "($1) $2"); // Coloca parênteses no DDD
        
        // Se tem 11 dígitos (celular novo), o traço fica após o 5º número do corpo
        if (v.length > 9) {
            v = v.replace(/(\d{5})(\d)/, "$1-$2");
        } else {
            // Se tem 10 (fixo), o traço fica após o 4º
            v = v.replace(/(\d{4})(\d)/, "$1-$2");
        }
        i.value = v;
    }

    // 4. Máscara de CEP (Mantida)
    function maskCEP(i) {
        i.value = i.value.replace(/\D/g, "").replace(/^(\d{5})(\d)/, "$1-$2").substring(0, 9);
    }

    // 5. Busca de CEP Automática (Mantida e Melhorada)
    async function buscarCepPerfil() {
        const cep = document.getElementById('cep').value.replace(/\D/g, '');
        if (cep.length === 8) {
            try {
                const response = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
                const data = await response.json();
                if (!data.erro) {
                    document.getElementById('rua').value = data.logradouro;
                    document.getElementById('bairro').value = data.bairro;
                    document.getElementById('cidade').value = data.localidade;
                    document.getElementById('estado').value = data.uf;
                } else {
                    alert("CEP não encontrado.");
                }
            } catch (err) {
                console.error("Erro ao buscar CEP:", err);
            }
        }
    }

    // 6. Inteligência de Aba: Se houver mensagem de sucesso, abre na aba "Meus Dados"
    window.onload = function() {
        <% if (typeof successMessage !== 'undefined' && successMessage) { %>
            // Simula o clique na aba de dados para o usuário ver a confirmação lá
            const tabBtnDados = document.querySelector('.tab-link[onclick*="tab-dados"]');
            if (tabBtnDados) tabBtnDados.click();
        <% } %>
    };

    // Este código roda assim que a página termina de carregar
window.onload = function() {
    // Se existir uma mensagem de sucesso na tela...
    <% if (successMessage && successMessage.length > 0) { %>
        // 1. Procura o botão da aba "Meus Dados"
        const btnDados = document.querySelector('.tab-link[onclick*="tab-dados"]');
        
        // 2. Clica nele automaticamente
        if (btnDados) {
            btnDados.click();
        }
        
    <% } %>
};
</script>
</body>
</html>