<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('../partials/head.ejs') %>
    <style>
        .page-container { max-width: 900px; margin: 40px auto; padding: 0 20px; }
        .page-title { 
            font-family: 'Playfair Display', serif; 
            text-align: center; 
            margin-bottom: 40px; 
            font-size: 32px;
        }

        .client-order-card {
            background: white;
            border: 1px solid #f0f0f0;
            border-radius: 12px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            transition: 0.3s;
            overflow: hidden;
        }
        
        /* Efeito visual ao passar o mouse */
        .card-header:hover { background: #fdfdfd; }

        /* CABEÇALHO (CLICÁVEL) */
        .card-header {
            padding: 20px;
            background: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer; /* Mãozinha do mouse */
            border-bottom: 1px solid transparent;
            transition: 0.3s;
        }
        /* Quando aberto, coloca borda */
        .card-header.active { border-bottom-color: #eee; background: #fafafa; }

        .header-left { display: flex; flex-direction: column; gap: 5px; }
        .order-number { font-weight: 800; font-family: 'Montserrat', sans-serif; color: #000; font-size: 14px; }
        .order-date { font-size: 12px; color: #888; }

        .header-right { text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
        .order-total { display: block; font-weight: 700; font-size: 16px; color: var(--accent-color); }
        
        /* Badges de Status */
        .status-badge { 
            padding: 4px 10px; border-radius: 20px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;
            margin-bottom: 5px; display: inline-block;
        }
        .st-pagar { background: #FFF4E5; color: #B76E00; }
        .st-ok { background: #EDF7ED; color: #1E4620; }
        .st-env { background: #E5F6FD; color: #014361; }
        .st-cancel { background: #FFEBEE; color: #C62828; }

        /* --- O INDICADOR VISUAL (SETA) --- */
        .expand-indicator {
            font-size: 11px;
            color: #999;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 5px;
            margin-top: 5px;
        }
        .toggle-icon { transition: transform 0.3s ease; font-size: 12px; }
        
        /* Gira a setinha quando ativo */
        .card-header.active .toggle-icon { transform: rotate(180deg); color: var(--black); }
        .card-header.active .expand-indicator { color: var(--black); }


        /* CORPO (DETALHES) */
        .card-body { display: none; padding: 25px; animation: slideDown 0.3s; background: #fff; }
        .card-body.open { display: block; }

        /* GRID DE INFORMAÇÕES */
        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 25px; }
        .info-box h4 { font-size: 11px; text-transform: uppercase; color: #999; margin-bottom: 8px; font-weight: 700; }
        .info-box p { font-size: 13px; color: #333; line-height: 1.5; margin-bottom: 3px; }

        /* PRODUTOS */
        .product-item { display: flex; gap: 15px; padding: 15px 0; border-bottom: 1px solid #f5f5f5; align-items: center; }
        .product-item:last-child { border: none; }
        .product-thumb { width: 60px; height: 60px; border-radius: 6px; object-fit: cover; border: 1px solid #eee; }
        .product-details { flex: 1; }
        .product-name { font-weight: 600; font-size: 13px; display: block; }
        .product-meta { font-size: 12px; color: #888; }
        .product-price { font-weight: 700; font-size: 14px; }

        .track-btn { display: block; margin-top: 15px; background: #2ecc71; color: white; text-align: center; padding: 12px; border-radius: 6px; text-decoration: none; font-weight: bold; font-size: 13px; transition: 0.2s; }
        .empty-state { text-align: center; padding: 60px 20px; }
        .btn-start { background: black; color: white; padding: 12px 30px; border-radius: 30px; text-decoration: none; font-weight: bold; font-size: 12px; display: inline-block; margin-top: 15px; }

        @keyframes slideDown { from {opacity:0; transform:translateY(-10px);} to {opacity:1; transform:translateY(0);} }
        @media (max-width: 600px) {
            .info-grid { grid-template-columns: 1fr; gap: 15px; }
            .order-number { font-size: 12px; }
        }
    </style>
</head>
<body>
    <%- include('../partials/header.ejs') %>

    <main class="page-container">
        <h1 class="page-title">Meus Pedidos</h1>

        <% if (orders.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 15px;">
                <% orders.forEach(order => { %>
                    <% 
                        let sClass = 'st-pagar';
                        let sIcon = 'fa-clock';
                        if (order.status.includes('Pago') || order.status.includes('Preparando')) { sClass = 'st-ok'; sIcon = 'fa-check'; }
                        if (order.status.includes('Enviado') || order.status.includes('Entregue')) { sClass = 'st-env'; sIcon = 'fa-truck'; }
                        if (order.status.includes('Cancelado')) { sClass = 'st-cancel'; sIcon = 'fa-times'; }
                    %>

                    <div class="client-order-card">
                        
                        <!-- CLIQUE AQUI (GATILHO) -->
                        <div class="card-header" onclick="toggleOrder('<%= order.id %>')">
                            
                            <!-- Esquerda: Número e Data -->
                            <div class="header-left">
                                <span class="order-number">#<%= order.id.slice(0,6).toUpperCase() %></span>
                                <span class="order-date"><%= new Date(order.date).toLocaleDateString('pt-BR') %></span>
                                <span class="status-badge <%= sClass %>" style="margin-top: 5px; width: fit-content;">
                                    <i class="fas <%= sIcon %>"></i> <%= order.status %>
                                </span>
                            </div>

                            <!-- Direita: Preço e Botão Expandir -->
                            <div class="header-right">
                                <span class="order-total">R$ <%= parseFloat(order.totalPrice).toFixed(2).replace('.', ',') %></span>
                                
                                <!-- ELEMENTO VISUAL NOVO -->
                                <span class="expand-indicator">
                                    Ver detalhes <i class="fas fa-chevron-down toggle-icon" id="icon-<%= order.id %>"></i>
                                </span>
                            </div>
                        </div>

                        <div class="card-body" id="body-<%= order.id %>">
                            
                            <% if (order.trackingCode) { %>
                                <a href="https://www.linkcorreios.com.br/<%= order.trackingCode %>" target="_blank" class="track-btn">
                                    <i class="fas fa-box-open"></i> RASTREAR ENTREGA (<%= order.trackingCode %>)
                                </a>
                                <hr style="margin: 20px 0; border: 0; border-top: 1px solid #f0f0f0;">
                            <% } %>

                            <div class="info-grid">
                                <div class="info-box">
                                    <h4>Endereço</h4>
                                    <p><%= order.address.rua %>, <%= order.address.numero %></p>
                                    <p><%= order.address.bairro %></p>
                                    <p><%= order.address.cidade %> - <%= order.address.estado %></p>
                                    <p>CEP: <%= order.address.cep %></p>
                                </div>
                                <div class="info-box">
                                    <h4>Pagamento</h4>
                                    <p>Método: <%= order.paymentMethod %></p>
                                    <p>Frete: R$ <%= (order.shippingCost || 0).toFixed(2).replace('.', ',') %></p>
                                    <% if(order.discountTotal && order.subtotal > order.discountTotal) { %>
                                        <p style="color: green;">Desconto aplicado!</p>
                                    <% } %>
                                </div>
                            </div>

                            <div class="info-box">
                                <h4>Itens</h4>
                                <div>
                                    <% order.items.forEach(item => { %>
                                        <div class="product-item">
                                            <% if (item.imageUrl) { %>
                                                <img src="<%= item.imageUrl %>" class="product-thumb">
                                            <% } else { %>
                                                <div class="product-thumb" style="background:#eee; display:flex; align-items:center; justify-content:center;"><i class="fas fa-tshirt"></i></div>
                                            <% } %>
                                            
                                            <div class="product-details">
                                                <span class="product-name"><%= item.title %></span>
                                                <span class="product-meta">
    Tam: <%= item.size %> 
    <% if (item.color) { %> | Cor: <%= item.color %> <% } %> 
    | Qtd: <%= item.qty %>
</span>
                                            </div>
                                            <div class="product-price">
                                                R$ <%= (item.price * item.qty).toFixed(2).replace('.', ',') %>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>

                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <i class="far fa-sad-tear" style="font-size: 50px; color: #ddd; margin-bottom: 20px;"></i>
                <h3 style="margin-bottom: 10px;">Você ainda não fez compras</h3>
                <a href="/" class="btn-start">IR PARA A LOJA</a>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        function toggleOrder(id) {
            const body = document.getElementById('body-' + id);
            // Pega o elemento pai do body (que é o card inteiro) e busca o cabeçalho
            const header = body.parentElement.querySelector('.card-header');
            
            body.classList.toggle('open');
            header.classList.toggle('active');
        }
    </script>
</body>
</html>