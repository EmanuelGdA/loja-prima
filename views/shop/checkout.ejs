<!DOCTYPE html>
<html lang="pt-br">
<head>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsencrypt/3.2.1/jsencrypt.min.js"></script>
    <%- include('../partials/head.ejs') %>
    <link rel="stylesheet" href="/css/checkout.css">
    <style>
        .payment-methods { display: flex; gap: 10px; margin-bottom: 15px; }
        .method-option { 
            flex: 1; border: 1px solid #ccc; padding: 15px; border-radius: 4px; 
            cursor: pointer; background: white; text-align: center; display: block;
        }
        .method-option:has(input:checked) { 
            border-color: black; background: #f0f0f0; font-weight: bold; 
        }
        .method-option input:checked + span { font-weight: bold; }
    </style>
</head>
<body>
    <header class="simple-header">
        
        <!-- 1. SETA VOLTAR (Fica na Esquerda) -->
        <a href="/carrinho" class="back-link">
            <i class="fas fa-arrow-left"></i> 
            <span class="back-text">Voltar</span>
        </a>

        <!-- (LOGO FOI REMOVIDA DAQUI) -->

        <!-- 2. CADEADO (Fica na Direita) -->
        <div class="secure-badge">
            <i class="fas fa-lock"></i> 
            <span>Checkout Seguro</span>
        </div>

    </header>

    <main class="checkout-container">
        
        <form action="/criar-pedido" method="POST" class="checkout-form" id="paymentForm">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <!-- Campos que guardam o frete escolhido para enviar pro servidor -->
            <input type="hidden" name="shippingCost" id="shippingCostInput" value="0">
            <input type="hidden" name="shippingMethod" id="shippingMethodInput" value="A combinar">

            <div class="column">
                
                <!-- DADOS PESSOAIS (CPF É OBRIGATÓRIO) -->
                <h2>Dados Pessoais</h2>
                
                <div class="form-row">
                    <!-- CPF -->
                    <div class="form-group main">
                        <label>CPF (Obrigatório)</label>
                        <!-- Se o usuário já tiver salvo, preenche automático -->
                        <input type="text" name="cpf" placeholder="000.000.000-00" maxlength="14" 
                               value="<%= user.cpf || '' %>" required oninput="maskCPF(this)">
                    </div>

                    <!-- TELEFONE (NOVO) -->
                    <div class="form-group main">
                        <label>WhatsApp</label>
                        <input type="text" name="phone" placeholder="(00) 00000-0000" maxlength="15" 
                               value="<%= user.phone || '' %>" required oninput="maskPhone(this)">
                    </div>
                </div>

                <h2>Entrega</h2>
                <!-- ESCOLHA DO TIPO DE ENTREGA -->
                <div class="delivery-type-group">
                    <label>
                        <input type="radio" name="deliveryType" value="ship" class="delivery-radio" checked onchange="toggleDeliveryMode('ship')">
                        <span class="delivery-label"><i class="fas fa-truck"></i> Receber em Casa</span>
                    </label>
                    <label>
                        <input type="radio" name="deliveryType" value="pickup" class="delivery-radio" onchange="toggleDeliveryMode('pickup')">
                        <span class="delivery-label"><i class="fas fa-store"></i> Retirar na Loja</span>
                    </label>
                </div>

                <!-- BLOCO QUE APARECE SE FOR RETIRADA -->
                <div id="pickup-box" class="pickup-info">
                    <strong><i class="fas fa-map-marker-alt"></i> Ponto de Retirada:</strong><br>
                    Loja Maely Cristina<br>
                    Rua Exemplo, 123 - Portão, Curitiba<br>
                    <small>Horário: Seg-Sex 09h às 18h</small>
                </div>

                <div id="shipping-address-form">

                <div class="form-group">
                    <label>CEP</label>
                    <input type="text" name="cep" id="cep" placeholder="00000-000" maxlength="9" required onblur="buscarCep()">
                </div>

                <div class="form-row">
                    <div class="form-group main">
                        <label>Rua / Avenida</label>
                        <input type="text" name="rua" id="rua" required>
                    </div>
                    <div class="form-group small">
                        <label>Número</label>
                        <input type="text" name="numero" required>
                    </div>
                </div>

                <div class="form-group">
                    <label>Bairro</label>
                    <input type="text" name="bairro" id="bairro" required>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Cidade</label>
                        <input type="text" name="cidade" id="cidade" required>
                    </div>
                    <div class="form-group small">
                        <label>Estado</label>
                        <input type="text" name="estado" id="estado" required>
                    </div>
                </div>

                <div id="frete-options" style="margin-bottom: 30px; display: none;">
                 <h3>Opções de Entrega</h3>
                <div id="lista-frete">
        <!-- O JavaScript vai preencher aqui -->
                </div>
                </div>
                </div>
                
                <h2>Pagamento</h2>
                
                <div class="payment-methods">
                    <label class="method-option">
                        <input type="radio" name="paymentMethod" value="pix" checked onclick="togglePayment('pix')">
                        <span><i class="fab fa-pix"></i> PIX</span>
                    </label>
                    <label class="method-option">
                        <input type="radio" name="paymentMethod" value="credit_card" onclick="togglePayment('card')">
                        <span><i class="far fa-credit-card"></i> Cartão</span>
                    </label>
                </div>

                <!-- Formulário do Cartão (Criptografia no Front-End) -->
                <div id="card-form" style="display: none; background: white; padding: 20px; border-radius: 4px; margin-top: 15px; border: 1px solid #eee;">
                    
                    <!-- CAMPO SECRETO: Aqui vai o código criptografado que o servidor vai ler -->
                    <input type="hidden" name="encryptedCard" id="encryptedCardInput">

                    <div class="form-group">
                        <label>Número do Cartão</label>
                        <!-- MUDOU: Tiramos 'name' e pusemos 'id="cc-number"' -->
                        <input type="text" id="cc-number" placeholder="0000 0000 0000 0000" maxlength="19">
                    </div>
                    
                    <div class="form-group">
                        <label>Nome no Cartão</label>
                        <!-- Esse pode manter o name, não é secreto -->
                        <input type="text" name="cardHolder">
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Validade (MM/AA)</label>
                            <!-- MUDOU: id="cc-exp", sem name -->
                            <input type="text" id="cc-exp" placeholder="MM/AA" maxlength="5">
                        </div>
                        <div class="form-group">
                            <label>CVV</label>
                            <!-- MUDOU: id="cc-cvv", sem name -->
                            <input type="text" id="cc-cvv" placeholder="123" maxlength="4">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Parcelamento</label>
                        <!-- Esse mantém name, o servidor precisa saber -->
                        <select name="installments" style="width: 100%; padding: 10px;">
                            <option value="1">1x (À vista)</option>
                            <option value="2">2x</option>
                            <option value="3">3x</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="column summary-col">
                <div class="order-summary-box">
                    <h3>Resumo do Pedido</h3>
                    <% if (cart.items.length > 0) { %>
                        <% cart.items.forEach(item => { %>
                            <div class="summary-item">
                                <img src="<%= item.imageUrl %>" alt="<%= item.title %>">
                                <div>
                                    <p><%= item.title %> x <%= item.qty %></p>
                                    <small>Tam: <%= item.size %></small>
                                </div>
                                <span>R$ <%= (item.price * item.qty).toFixed(2).replace('.', ',') %></span>
                            </div>
                        <% }) %>
                    <% } %>
                    <hr>
                    <div class="totals">
                        <!-- Subtotal -->
                        <div class="row">
                            <span>Subtotal</span> 
                            <span>R$ <%= parseFloat(cart.totalPrice).toFixed(2).replace('.', ',') %></span>
                        </div>
                        
                        <!-- Linha de Desconto (Se tiver cupom) -->
                        <% if (cart.coupon && cart.totalWithDiscount) { %>
                            <div class="row" style="color: #2ecc71;">
                                <span>Desconto (<%= cart.coupon.code %>)</span>
                                <span>- R$ <%= (cart.totalPrice - cart.totalWithDiscount).toFixed(2).replace('.', ',') %></span>
                            </div>
                        <% } %>

                        <!-- Frete (COM ID NOVO) -->
                        <div class="row">
                            <span>Frete</span> 
                            <!-- Aqui é onde o valor vai aparecer -->
                            <span id="valorFreteVisual">-</span> 
                        </div>
                        
                        <hr style="margin: 10px 0; border: 0; border-top: 1px solid #eee;">

                        <!-- Total Final  -->
                        <div class="row total" style="margin-top: 5px;">
                            <span>Total</span> 
                            <span id="totalFinalDisplay">
                                <!-- CORREÇÃO AQUI TAMBÉM -->
                                R$ <%= (cart.coupon ? cart.totalWithDiscount : cart.totalPrice).toFixed(2).replace('.', ',') %>
                            </span>
                        </div>
                    </div>
                    <button type="submit" class="btn-finish">Finalizar Pedido</button>
                    <p class="secure-info"><i class="fas fa-shield-alt"></i> Ambiente Seguro</p>
                </div>
            </div>
        </form>
    </main>

    <script>

        // Máscara de Telefone
    function maskPhone(input) {
        let v = input.value.replace(/\D/g,'');
        v = v.replace(/^(\d{2})(\d)/g,"($1) $2");
        v = v.replace(/(\d)(\d{4})$/,"$1-$2");
        input.value = v;
    }

    // Máscara de CPF
    function maskCPF(input) {
        let v = input.value.replace(/\D/g,'');
        v = v.replace(/(\d{3})(\d)/,"$1.$2");
        v = v.replace(/(\d{3})(\d)/,"$1.$2");
        v = v.replace(/(\d{3})(\d{1,2})$/,"$1-$2");
        input.value = v;
    }
        
    // Se tiver desconto, usa ele. Se não, usa o total normal.
    const cartSubtotal = parseFloat('<%= (cart.totalWithDiscount || cart.totalPrice) %>');

    function buscarCep() {
        const cep = document.getElementById('cep').value.replace(/\D/g, '');
        
        if (cep.length === 8) {
            // 1. Busca Endereço (ViaCEP)
            fetch(`https://viacep.com.br/ws/${cep}/json/`)
                .then(res => res.json())
                .then(data => {
                    if (!data.erro) {
                        document.getElementById('rua').value = data.logradouro;
                        document.getElementById('bairro').value = data.bairro;
                        document.getElementById('cidade').value = data.localidade;
                        document.getElementById('estado').value = data.uf;
                        
                        // 2. CHAMA O CÁLCULO DE FRETE (Melhor Envio)
                        calcularFreteCarrinho(cep);
                    } else {
                        alert("CEP não encontrado.");
                    }
                });
        }
    }

    async function calcularFreteCarrinho(cep) {
        const listaDiv = document.getElementById('lista-frete');
        const container = document.getElementById('frete-options');
        
        listaDiv.innerHTML = 'Calculando entrega...';
        container.style.display = 'block';

        try {
            // Chama nossa API sem mandar ID de produto (para ele entender que é o carrinho)
            const response = await fetch('/api/frete', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'CSRF-Token': '<%= csrfToken %>' // Importante!
                },
                body: JSON.stringify({ cep: cep }) 
            });

            const opcoes = await response.json();

            if (opcoes.error || opcoes.length === 0) {
                listaDiv.innerHTML = '<span style="color:red">Não há entregas para este CEP.</span>';
                return;
            }

            // Monta os botões de escolha
            let html = '';
            opcoes.forEach((op, index) => {
                // O primeiro item já vem marcado (checked)
                const checked = index === 0 ? 'checked' : '';
                if(index === 0) selecionarFrete(op.preco, op.nome); // Seleciona o primeiro automaticamente

                html += `
                    <label style="display: flex; justify-content: space-between; padding: 10px; border: 1px solid #ddd; margin-bottom: 5px; cursor: pointer; border-radius: 4px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <input type="radio" name="freteRadio" ${checked} 
                                onchange="selecionarFrete(${op.preco}, '${op.nome}')">
                            <img src="${op.logo}" height="20">
                            <span>${op.nome}</span>
                        </div>
                        <div>
                            <strong>R$ ${op.preco.toFixed(2).replace('.', ',')}</strong>
                            <small>(${op.prazo} dias)</small>
                        </div>
                    </label>
                `;
            });
            listaDiv.innerHTML = html;

        } catch (error) {
            console.error(error);
            listaDiv.innerHTML = 'Erro ao calcular frete.';
        }
    }

    function selecionarFrete(valor, nome) {
        // 1. Atualiza os inputs escondidos (para o backend)
        document.getElementById('shippingCostInput').value = valor;
        document.getElementById('shippingMethodInput').value = nome;

        // 2. Atualiza o visual do FRETE (Usando o ID novo)
        const freteVisual = document.getElementById('valorFreteVisual');
        if (freteVisual) {
            freteVisual.innerText = 'R$ ' + valor.toFixed(2).replace('.', ',');
        }

        // 3. Atualiza o TOTAL
        const totalVisual = document.getElementById('totalFinalDisplay');
        if (totalVisual) {
            // Soma o (Produto com ou sem desconto) + Frete
            const novoTotal = cartSubtotal + valor;
            totalVisual.innerText = 'R$ ' + novoTotal.toFixed(2).replace('.', ',');
        }
    }

    // ... (Mantenha a função togglePayment aqui também) ...
    function togglePayment(method) {
        const cardForm = document.getElementById('card-form');
        const inputs = cardForm.querySelectorAll('input, select');

        if (method === 'card') {
            // Se escolheu Cartão: Mostra o formulário e torna os campos obrigatórios
            cardForm.style.display = 'block';
            inputs.forEach(i => i.setAttribute('required', 'true'));
        } else {
            // Se escolheu Pix: Esconde o formulário e tira a obrigatoriedade
            cardForm.style.display = 'none';
            inputs.forEach(i => i.removeAttribute('required'));
        }
    }

    function toggleDeliveryMode(mode) {
        const addressForm = document.getElementById('shipping-address-form');
        const pickupBox = document.getElementById('pickup-box');
        const freteOptions = document.getElementById('frete-options'); 
        
        // Pega todos os inputs de endereço para tirar o 'required'
        const addressInputs = addressForm.querySelectorAll('input');

        const costInput = document.getElementById('shippingCostInput');
        const methodInput = document.getElementById('shippingMethodInput');
        const freteVisual = document.getElementById('valorFreteVisual');
        const totalVisual = document.getElementById('totalFinalDisplay');

        if (mode === 'pickup') {
            // --- MODO RETIRADA ---
            addressForm.style.display = 'none';
            if(freteOptions) freteOptions.style.display = 'none';
            pickupBox.style.display = 'block';
            
            // O PULO DO GATO: Remove a obrigatoriedade dos campos escondidos
            addressInputs.forEach(input => input.removeAttribute('required'));

            // Zera o frete
            costInput.value = 0;
            methodInput.value = 'Retirar na Loja';
            
            if(freteVisual) freteVisual.innerText = 'Grátis';
            
            const novoTotal = cartSubtotal + 0;
            if(totalVisual) totalVisual.innerText = 'R$ ' + novoTotal.toFixed(2).replace('.', ',');
            
        } else {
            // --- MODO ENTREGA ---
            addressForm.style.display = 'block';
            pickupBox.style.display = 'none';
            if(document.getElementById('lista-frete').innerHTML !== '') {
                 if(freteOptions) freteOptions.style.display = 'block';
            }

            // Devolve a obrigatoriedade para o navegador validar
            addressInputs.forEach(input => input.setAttribute('required', 'true'));
            
            // (Opcional) Zera o frete visualmente até a pessoa calcular de novo
            // ou mantém o último cálculo se quiser.
        }
    }

    const form = document.getElementById('paymentForm');

    form.addEventListener('submit', async function(e) {
        // Se for PIX ou Retirada, deixa passar normal
        const method = document.querySelector('input[name="paymentMethod"]:checked').value;
        if (method !== 'credit_card') return;

        e.preventDefault(); // PAUSA O ENVIO DO FORMULÁRIO

        const btn = document.querySelector('.btn-finish');
        btn.innerText = 'Processando Segurança...';
        btn.disabled = true;

        try {
            // 1. Pede a chave pro servidor
            const response = await fetch('/api/pagseguro-key');
            const data = await response.json();
            
            // --- CORREÇÃO DA FORMATAÇÃO DA CHAVE (CLEAN KEY) ---
            let rawKey = data.key;
            
            // Remove cabeçalhos se já vierem, remove espaços e quebras de linha
            rawKey = rawKey.replace("-----BEGIN PUBLIC KEY-----", "")
                           .replace("-----END PUBLIC KEY-----", "")
                           .replace(/[\r\n\s]/g, "");

            // Monta a chave limpa e perfeita para o JSEncrypt
            const publicKey = `-----BEGIN PUBLIC KEY-----\n${rawKey}\n-----END PUBLIC KEY-----`;
            // --------------------------------------------------

            // 2. Pega os dados sensíveis
            const number = document.getElementById('cc-number').value.replace(/\s/g, '');
            const cvv = document.getElementById('cc-cvv').value;
            const exp = document.getElementById('cc-exp').value;
            
            const parts = exp.split('/');
            const mes = parts[0];
            let ano = parts[1];
            if (ano.length === 2) ano = "20" + ano;

            // 3. Monta o JSON exato que o PagSeguro V4 espera dentro da criptografia
            const cardData = {
                number: number,
                security_code: cvv,
                exp_month: mes,
                exp_year: ano,
                holder: { 
                    name: document.getElementsByName('cardHolder')[0].value 
                }
            };

            // 4. Criptografa
            const encrypt = new JSEncrypt();
            encrypt.setPublicKey(publicKey);
            const encrypted = encrypt.encrypt(JSON.stringify(cardData));

            if (!encrypted) {
                // Se falhar a criptografia, força um erro visível
                console.error("Falha ao gerar hash. Chave usada:", publicKey);
                throw new Error("Erro interno de criptografia.");
            }

            // 5. Coloca no campo escondido
            document.getElementById('encryptedCardInput').value = encrypted;

            // 6. Envia o formulário
            form.submit();

        } catch (error) {
            console.error(error);
            alert("Erro ao processar segurança: " + error.message);
            btn.innerText = 'Finalizar Pedido';
            btn.disabled = false;
        }
    });
</script>
</body>
</html>