<!DOCTYPE html>
<html lang="pt-br">
<head>
    <script src="https://sdk.mercadopago.com/js/v2"></script>
    <%- include('../partials/head.ejs') %>
    <link rel="stylesheet" href="/css/checkout.css">
    <style>

        /* --- SELECT DE PARCELAS BOUTIQUE --- */
.boutique-select-card {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid #ddd;
    border-radius: 8px; /* Cantos arredondados */
    background-color: #fff;
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    color: #333;
    outline: none;
    cursor: pointer;
    transition: 0.3s;
    
    /* Remove a seta padrão feia do navegador */
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    
    /* Adiciona uma seta customizada minimalista */
    background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23333%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E");
    background-repeat: no-repeat;
    background-position: right 15px center;
    background-size: 10px;
}

.boutique-select-card:focus {
    border-color: #000;
    box-shadow: 0 0 0 2px rgba(0,0,0,0.05);
}
        
        /* --- ESTILO NOVO DAS OPÇÕES DE FRETE --- */
        .shipping-option {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 8px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: 0.2s;
            background: white;
        }

        .shipping-option:hover {
            border-color: #aaa;
            background-color: #fcfcfc;
        }

        /* Quando selecionado (Input Radio dentro do label) */
        .shipping-option:has(input:checked) {
            border-color: black;
            background-color: #f9f9f9;
            box-shadow: 0 0 0 1px black;
        }

        .option-left { display: flex; align-items: center; gap: 12px; }
        
        /* Círculo do ícone */
        .icon-box {
            width: 35px; height: 35px;
            border-radius: 50%;
            background-color: #f0f0f0;
            display: flex; align-items: center; justify-content: center;
            font-size: 14px;
            color: #555;
        }

        .option-details { display: flex; flex-direction: column; }
        .option-name { font-weight: 600; font-size: 13px; color: #333; }
        .option-prazo { font-size: 11px; color: #777; }
        
        .option-price { font-weight: 700; font-size: 14px; color: #000; }

        .payment-methods { display: flex; gap: 10px; margin-bottom: 15px; }
        .method-option {
    display: flex;
    align-items: center; /* Alinha tudo no meio verticalmente */
    gap: 10px;           /* Espaço entre rádio, ícone e texto */
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 8px;
    cursor: pointer;
    transition: 0.3s;
}
        .method-option:has(input:checked) { 
            border-color: black; background: #f0f0f0; font-weight: bold; 
        }
        .method-option input:checked + span { font-weight: bold; }

        /* --- ESTILO DAS OPÇÕES DE FRETE (NOVO) --- */
        .shipping-option-card {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 15px;
            border: 1px solid #eee;
            border-radius: 8px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: 0.2s;
            background: white;
        }
        
        /* Quando o input (escondido) estiver marcado, muda o estilo da div */
        .shipping-option-card:has(input:checked) {
            border-color: #000;
            background-color: #f9f9f9;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }

        .ship-icon {
            width: 35px; height: 35px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 14px; margin-right: 12px;
        }

        .discount-tag {
    background-color: #e6f9ee; /* Verde clarinho de fundo fica mais elegante */
    color: #27ae60;            /* Verde forte no texto */
    font-size: 11px;
    padding: 4px 8px;
    border-radius: 4px;
    font-weight: bold;
    white-space: nowrap;      /* FORÇA O TEXTO A FICAR EM UMA LINHA SÓ */
    text-transform: uppercase;
}
    
        /* Container base do resumo */
.summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center; /* Alinha o texto e o valor na mesma linha */
    margin-bottom: 10px;
}

/* Estilo específico para a linha de desconto */
.discount-row {
    color: #27ae60 !important;
    font-weight: bold;
    margin-top: 5px;
}

.discount-label {
    line-height: 1.2; /* Deixa o texto principal e o small mais juntinhos */
    font-size: 14px;
}

.discount-label small {
    font-weight: normal;
    font-size: 11px;
    color: #2ecc71;
    display: block; /* Faz o texto pequeno ficar logo abaixo do nome */
}

.discount-value {
    white-space: nowrap; /* Impede que o valor (R$) quebre linha */
    font-size: 15px;
}


        
    </style>
</head>
<body>
    <header class="simple-header">
        
        <!-- 1. SETA VOLTAR (Fica na Esquerda) -->
        <a href="/carrinho" class="back-link">
            <i class="fas fa-arrow-left"></i> 
            <span class="back-text">Voltar</span>
        </a>

        <!-- (LOGO FOI REMOVIDA DAQUI) -->

        <!-- 2. CADEADO (Fica na Direita) -->
        <div class="secure-badge">
            <i class="fas fa-lock"></i> 
            <span>Checkout Seguro</span>
        </div>

    </header>

    <main class="checkout-container">
        
        <form action="/criar-pedido" method="POST" class="checkout-form" id="paymentForm">
            <!-- Inputs ocultos para o Mercado Pago -->
            <input type="hidden" name="cardToken" id="cardToken">
            <input type="hidden" name="paymentMethodId" id="paymentMethodId">
            <input type="hidden" name="issuerId" id="issuerId">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <!-- Campos que guardam o frete escolhido para enviar pro servidor -->
            <input type="hidden" name="shippingCost" id="shippingCostInput" value="0">
            <input type="hidden" name="shippingMethod" id="shippingMethodInput" value="A combinar">

            <div class="column">
                
                <!-- DADOS PESSOAIS (CPF É OBRIGATÓRIO) -->
                <h2>Dados Pessoais</h2>
                
                <div class="form-row">
                    <!-- CPF -->
                    <div class="form-group main">
                        <label>CPF (Obrigatório)</label>
                        <!-- Se o usuário já tiver salvo, preenche automático -->
                        <input type="text" name="cpf" placeholder="000.000.000-00" maxlength="14" 
                               value="<%= user.cpf || '' %>" required oninput="maskCPF(this)">
                    </div>

                    <!-- TELEFONE (NOVO) -->
                    <div class="form-group main">
                        <label>WhatsApp</label>
                        <input type="text" name="phone" placeholder="(00) 00000-0000" maxlength="15" 
                               value="<%= user.phone || '' %>" required oninput="maskPhone(this)">
                    </div>
                </div>

                <h2>Entrega</h2>
                <!-- ESCOLHA DO TIPO DE ENTREGA -->
                <div class="delivery-type-group">
                    <label>
                        <input type="radio" name="deliveryType" value="ship" class="delivery-radio" checked onchange="toggleDeliveryMode('ship')">
                        <span class="delivery-label"><i class="fas fa-truck"></i> Receber em Casa</span>
                    </label>
                    <label>
                        <input type="radio" name="deliveryType" value="pickup" class="delivery-radio" onchange="toggleDeliveryMode('pickup')">
                        <span class="delivery-label"><i class="fas fa-store"></i> Retirar na Loja</span>
                    </label>
                </div>

                <!-- BLOCO QUE APARECE SE FOR RETIRADA -->
<div id="pickup-box" class="pickup-info">
    <strong><i class="fas fa-map-marker-alt"></i> Ponto de Retirada:</strong>
    
    <span style="display: block; margin-top: 5px;">Loja Maely Cristina</span>
    <span style="display: block;">Rua Curupis, 2001 - Portão, Curitiba</span>

    <small style="display: block; margin-top: 8px;">
        <strong>Horário:</strong> Seg-Sex 10h às 17h<br>
        <span style="margin-left: 51px;">Sábado 10h às 14h</span>
    </small>

    <small style="display: block; margin-top: 10px; font-style: italic; color: #555;">
        A loja entrará em contato após a confirmação do pagamento para agendar a retirada.
    </small>
</div>

                <div id="shipping-address-form">

                <div class="form-group">
                    <label>CEP</label>
                    <input type="text" name="cep" id="cep" placeholder="00000-000" maxlength="9" required onblur="buscarCep()">
                </div>

                <div class="form-row">
                    <div class="form-group main">
                        <label>Rua / Avenida</label>
                        <input type="text" name="rua" id="rua" required>
                    </div>
                    <div class="form-group small">
                        <label>Número</label>
                        <input type="text" name="numero" required>
                    </div>
                </div>

                <div class="form-group">
                    <label>Bairro</label>
                    <input type="text" name="bairro" id="bairro" required>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Cidade</label>
                        <input type="text" name="cidade" id="cidade" required>
                    </div>
                    <div class="form-group small">
                        <label>Estado</label>
                        <input type="text" name="estado" id="estado" required>
                    </div>
                </div>

                <div id="frete-options" style="margin-bottom: 30px; display: none;">
                 <h3>Opções de Entrega</h3>
                <div id="lista-frete">
        <!-- O JavaScript vai preencher aqui -->
                </div>
                </div>
                </div>
                
                <h2>Pagamento</h2>
                
                <div class="payment-methods">
                    <label class="method-option">
                        <!-- Clicou aqui, manda 'pix' pro script -->
                        <input type="radio" name="paymentMethod" value="pix" checked onclick="togglePayment('pix')">
                        <span><i class="fab fa-pix"></i> PIX</span>
                        <span class="discount-tag">5% de Desconto</span>
                    </label>
                    <label class="method-option">
                        <!-- CORREÇÃO: Clicou aqui, manda 'credit_card' pro script -->
                        <input type="radio" name="paymentMethod" value="credit_card" onclick="togglePayment('credit_card')">
                        <span><i class="far fa-credit-card"></i> Cartão</span>
                    </label>
                </div>

                <!-- Formulário do Cartão (Confirme se o ID está card-form) -->
                <div id="card-form" style="display: none; background: white; padding: 20px; border-radius: 4px; margin-top: 15px; border: 1px solid #eee;">
                    
                    <!-- CAMPO SECRETO: Aqui vai o código criptografado que o servidor vai ler -->
                    <input type="hidden" name="encryptedCard" id="encryptedCardInput">

                    <!-- NOVO: Escolha da Função (Crédito/Débito) -->
                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="margin-bottom: 5px; display: block;">Função do Cartão</label>
                        <div style="display: flex; gap: 15px;">
                            <label style="display: flex; align-items: center; gap: 5px; cursor: pointer;">
                                <input type="radio" name="cardType" value="credit" checked onchange="resetInstallments()">
                                Crédito
                            </label>
                            <label style="display: flex; align-items: center; gap: 5px; cursor: pointer;">
                                <input type="radio" name="cardType" value="debit" onchange="resetInstallments()">
                                Débito
                            </label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Número do Cartão</label>
                        <!-- MUDOU: Tiramos 'name' e pusemos 'id="cc-number"' -->
                        <input type="text" id="cc-number" placeholder="0000 0000 0000 0000" maxlength="19" oninput="maskCardNumber(this)">
                    </div>
                    
                    <div class="form-group">
                        <label>Nome no Cartão</label>
                        <!-- Esse pode manter o name, não é secreto -->
                        <input type="text" name="cardHolder" placeholder="COMO NO CARTÃO" oninput="this.value = this.value.toUpperCase()">
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Validade (MM/AA)</label>
                            <!-- MUDOU: id="cc-exp", sem name -->
                            <input type="text" id="cc-exp" placeholder="MM/AA" maxlength="5" oninput="maskDate(this)">
                        </div>
                        <div class="form-group">
                            <label>CVV</label>
                            <!-- MUDOU: id="cc-cvv", sem name -->
                            <input type="text" id="cc-cvv" placeholder="123" maxlength="4" oninput="maskCVV(this)">
                        </div>
                    </div>

                    
                    <div class="form-group" id="installments-container" style="display: none;">
                        <label style="font-weight: bold; margin-bottom: 5px; display: block;">Parcelamento</label>
                        <select name="installments" id="installments" class="boutique-select-card">
                            <!-- O JS preenche aqui -->
                        </select>
                    </div>
                </div> 
                
                </div>
            </div>

            <div class="column summary-col">
                <div class="order-summary-box">
                    <h3>Resumo do Pedido</h3>
                    <% if (cart.items.length > 0) { %>
                        <% cart.items.forEach(item => { %>
                            <div class="summary-item">
                                <img src="<%= item.imageUrl %>" alt="<%= item.title %>">
                                <div>
                                    <p><%= item.title %> x <%= item.qty %></p>
                                    <small>Tam: <%= item.size %></small>
                                </div>
                                <span>R$ <%= (item.price * item.qty).toFixed(2).replace('.', ',') %></span>
                            </div>
                        <% }) %>
                    <% } %>
                    <hr>
                    <div class="totals">
                        <!-- Subtotal -->
                        <div class="row">
                            <span>Subtotal</span> 
                            <span>R$ <%= parseFloat(cart.totalPrice).toFixed(2).replace('.', ',') %></span>
                        </div>
                        
                        <!-- Linha de Desconto (Se tiver cupom) -->
                        <% if (cart.coupon && cart.totalWithDiscount) { %>
                            <div class="row" style="color: #2ecc71;">
                                <span>Desconto (<%= cart.coupon.code %>)</span>
                                <span>- R$ <%= (cart.totalPrice - cart.totalWithDiscount).toFixed(2).replace('.', ',') %></span>
                            </div>
                        <% } %>

                        <!-- Frete (COM ID NOVO) -->
                        <div class="row">
                            <span>Frete</span> 
                            <!-- Aqui é onde o valor vai aparecer -->
                            <span id="valorFreteVisual">-</span> 
                        </div>

                        <div class="summary-row discount-row" id="pix-discount-row" style="display: none;">
    <span class="discount-label">
        Desconto PIX <br>
        <small>(5% sobre o produto)</small>
    </span>
    <span id="valorDescontoPixVisual" class="discount-value">- R$ 0,00</span>
</div>
                        
                        <hr style="margin: 10px 0; border: 0; border-top: 1px solid #eee;">

                        <!-- Total Final  -->
                        <div class="row total" style="margin-top: 5px;">
                            <span>Total</span> 
                            <span id="totalFinalDisplay">
                                <!-- CORREÇÃO AQUI TAMBÉM -->
                                R$ <%= (cart.coupon ? cart.totalWithDiscount : cart.totalPrice).toFixed(2).replace('.', ',') %>
                            </span>
                        </div>
                    </div>
                    <button type="submit" class="btn-finish">Finalizar Pedido</button>
                    <p class="secure-info"><i class="fas fa-shield-alt"></i> Ambiente Seguro</p>
                </div>
            </div>
        </form>
    </main>

   

<script>

    // Impede que o formulário seja enviado ao apertar "Enter" nos campos
window.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && e.target.nodeName === 'INPUT') {
        e.preventDefault();
        return false;
    }
});

    // Valor dos produtos (Fixo)
    const cartSubtotal = parseFloat('<%= (cart.totalWithDiscount || cart.totalPrice) %>');

    // --- MÁSCARAS ---
    function maskPhone(i){ i.value = i.value.replace(/\D/g,'').replace(/^(\d{2})(\d)/g,"($1) $2").replace(/(\d)(\d{4})$/,"$1-$2"); }
    function maskCPF(i){ i.value = i.value.replace(/\D/g,'').replace(/(\d{3})(\d)/,"$1.$2").replace(/(\d{3})(\d)/,"$1.$2").replace(/(\d{3})(\d{1,2})$/,"$1-$2"); }

    // --- MÁSCARAS DE CARTÃO DE CRÉDITO ---

    // 1. Máscara do Número (0000 0000 0000 0000)
    function maskCardNumber(i) {
        let v = i.value.replace(/\D/g, ""); // Remove tudo que não é dígito
        v = v.substring(0, 16); // Limita a 16 números
        v = v.replace(/(\d{4})(\d)/, "$1 $2");
        v = v.replace(/(\d{4})(\d)/, "$1 $2");
        v = v.replace(/(\d{4})(\d)/, "$1 $2");
        i.value = v;
        
        // Dica Extra: Se quiser disparar a busca de parcelas automático quando terminar
        if (v.length >= 7) { 
            // O evento 'keyup' original já cuida disso, então não precisa mexer aqui
        }
    }

    // 2. Máscara da Validade (MM/AA)
    function maskDate(i) {
        let v = i.value.replace(/\D/g, "");
        if (v.length > 2) {
            v = v.replace(/^(\d{2})(\d)/, "$1/$2");
        }
        i.value = v;
    }

    // 3. Máscara do CVV (Só números)
    function maskCVV(i) {
        i.value = i.value.replace(/\D/g, "");
    }

    // --- LÓGICA DE TROCA DE ENTREGA (BLINDADA) ---
    function toggleDeliveryMode(mode) {
        const addressForm = document.getElementById('shipping-address-form');
        const pickupBox = document.getElementById('pickup-box');
        const freteOptions = document.getElementById('frete-options'); 
        const addressInputs = addressForm.querySelectorAll('input');
        
        // Elementos de Valores
        const costInput = document.getElementById('shippingCostInput');
        const methodInput = document.getElementById('shippingMethodInput');
        const freteVisual = document.getElementById('valorFreteVisual');
        const totalVisual = document.getElementById('totalFinalDisplay');

        if (mode === 'pickup') {
            // >>> MODO RETIRADA (FORÇA ZERO) <<<
            
            // 1. Esconde coisas de correio
            addressForm.style.display = 'none';
            if(freteOptions) freteOptions.style.display = 'none';
            
            // 2. Mostra caixa da loja
            pickupBox.style.display = 'block';
            
            // 3. Tira obrigatoriedade do endereço
            addressInputs.forEach(input => input.removeAttribute('required'));

            // 4. FORÇA VALORES (Isso evita o bug)
            costInput.value = 0; 
            methodInput.value = 'Retirar na Loja';
            
            // 5. Atualiza Visual na hora
            freteVisual.innerText = 'Grátis';
            atualizarTotalGeral(); 
            
            // 6. Desmarca qualquer opção de frete que estava selecionada lá embaixo
            const radios = document.querySelectorAll('input[name="freteRadio"]');
            radios.forEach(r => r.checked = false);

        } else {
            // >>> MODO ENTREGA <<<
            
            // 1. Mostra campos
            addressForm.style.display = 'block';
            pickupBox.style.display = 'none';
            
            // 2. Torna obrigatório
            addressInputs.forEach(input => input.setAttribute('required', 'true'));
            
            // 3. SEGREDO ANTI-BUG: 
            // Se já tem CEP digitado, recalcula o frete imediatamente para recuperar o valor
            const cepAtual = document.getElementById('cep').value.replace(/\D/g, '');
            if (cepAtual.length === 8) {
                // Chama o cálculo de novo
                calcularFreteCarrinho(cepAtual); 
            } else {
                // Se não tem CEP, reseta visualmente para "traço"
                if(freteOptions) freteOptions.style.display = 'none';
                freteVisual.innerText = '-';
                totalVisual.innerText = 'R$ ' + cartSubtotal.toFixed(2).replace('.', ',');
                costInput.value = 0;
            }
        }
    }

    // --- LÓGICA DE CÁLCULO (MELHOR ENVIO) ---
    function buscarCep() {
        // Se a pessoa estiver no modo "Retirar", ignora a busca de CEP para não bugar
        const modoAtual = document.querySelector('input[name="deliveryType"]:checked').value;
        if(modoAtual === 'pickup') return;

        const cep = document.getElementById('cep').value.replace(/\D/g, '');
        if (cep.length === 8) {
            fetch(`https://viacep.com.br/ws/${cep}/json/`)
                .then(res => res.json())
                .then(data => {
                    if (!data.erro) {
                        // Preenche endereço
                        document.getElementById('rua').value = data.logradouro;
                        document.getElementById('bairro').value = data.bairro;
                        document.getElementById('cidade').value = data.localidade;
                        document.getElementById('estado').value = data.uf;
                        // Chama frete
                        calcularFreteCarrinho(cep);
                    } else { alert("CEP não encontrado."); }
                });
        }
    }

    async function calcularFreteCarrinho(cep) {
        const listaDiv = document.getElementById('lista-frete');
        const container = document.getElementById('frete-options');
        
        // Limpa lista anterior e mostra "Calculando"
        listaDiv.innerHTML = '<div style="padding:10px; color:#666;">Calculando... <i class="fas fa-spinner fa-spin"></i></div>';
        container.style.display = 'block';

        try {
            const response = await fetch('/api/frete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'csrf-token': '<%= csrfToken %>' },
                body: JSON.stringify({ cep: cep }) 
            });
            const opcoes = await response.json();
            
            if (opcoes.error || opcoes.length === 0) { listaDiv.innerHTML = 'Sem entrega para este CEP.'; return; }

            let html = '';
            let algumMarcado = false;
            
            opcoes.forEach((op) => {
                // FILTRO: Esconde opção "Retirar" da lista (já tem botão em cima)
                if (op.id === 'local_retirada' || op.nome.toLowerCase().includes('retirar')) return;

                // Marca automaticamente o PRIMEIRO da lista
                let checked = '';
                if (!algumMarcado) {
                    checked = 'checked';
                    selecionarFrete(op.preco, op.nome); // Já atualiza o valor
                    algumMarcado = true;
                }

                // Ícones
                let icon = 'fa-truck'; let bgIcon='#f5f5f5'; let colorIcon='#555';
                if (op.nome.toLowerCase().includes('moto')) { icon='fa-motorcycle'; bgIcon='#fff3e0'; colorIcon='#e67e22'; }
                else if (op.logo && op.logo.startsWith('http')) { icon = 'img'; }

                let prazoTxt = (op.prazo == 0) ? 'Hoje' : op.prazo + ' dias';
                
                // HTML do ícone
                let iconHTML = icon === 'img' ? `<img src="${op.logo}" style="height:15px;width:auto;">` : `<i class="fas ${icon}"></i>`;

                html += `
                    <label class="shipping-option-card">
                        <div style="display:flex; align-items:center;">
                            <input type="radio" name="freteRadio" ${checked} onchange="selecionarFrete(${op.preco}, '${op.nome}')" style="margin-right:10px; accent-color:black;">
                            
                            <div class="ship-icon" style="background:${bgIcon}; color:${colorIcon}; display:flex; align-items:center; justify-content:center; width:35px; height:35px; border-radius:50%; margin-right:10px;">
                                ${iconHTML}
                            </div>

                            <div style="display:flex; flex-direction:column;">
                                <span style="font-size:13px; font-weight:700; color:#333;">${op.nome}</span>
                                <span style="font-size:11px; color:#888;">Chega em ${prazoTxt}</span>
                            </div>
                        </div>
                        
                        <div style="font-weight:700; font-size:14px; color:#000;">
                            R$ ${op.preco.toFixed(2).replace('.', ',')}
                        </div>
                    </label>
                `;
            });
            
            if(html === '') {
                 listaDiv.innerHTML = '<div style="padding:10px; font-size:13px; color:#666;">Utilize a opção <strong>Retirar na Loja</strong> no topo.</div>';
            } else {
                 listaDiv.innerHTML = html;
            }

        } catch (error) { console.error(error); listaDiv.innerHTML = 'Erro no frete.'; }
    }

    // Função que atualiza os totais na tela
    function selecionarFrete(valor, nome) {
        // Se estiver no modo "Retirar", ignora cliques na lista de baixo (segurança extra)
        const modoAtual = document.querySelector('input[name="deliveryType"]:checked').value;
        if(modoAtual === 'pickup') return; 

        document.getElementById('shippingCostInput').value = valor;
        document.getElementById('shippingMethodInput').value = nome;
        
        const freteVisual = document.getElementById('valorFreteVisual');
        if(freteVisual) freteVisual.innerText = 'R$ ' + valor.toFixed(2).replace('.', ',');
        
        const totalVisual = document.getElementById('totalFinalDisplay');
        if(totalVisual) {
            atualizarTotalGeral(); 
        }
    }

    // --- LÓGICA DE PAGAMENTO (Abas Pix/Cartão) ---
    function togglePayment(method) {
        const cardForm = document.getElementById('card-form');
        const inputs = cardForm.querySelectorAll('input, select');
        if (method === 'credit_card' || method === 'card') {
            cardForm.style.display = 'block';
            inputs.forEach(i => i.setAttribute('required', 'true'));
        } else {
            cardForm.style.display = 'none';
            inputs.forEach(i => i.removeAttribute('required'));
        }

        atualizarTotalGeral(); 
    }

    // --- ENVIO DO FORMULÁRIO (Criptografia) ---
    // (Apenas inicialização básica se necessário)
    // O SDK V2 não exige muito setup manual se usar a versão transparente,
    // mas vamos manter o fluxo do seu código anterior que já estava bom.
    // Lembre-se de ter importado a SDK no Head.

    const mp = new MercadoPago('APP_USR-3dabc9c8-dabf-49c1-b624-22b483b99a4f'); // SUA CHAVE PÚBLICA
    
    // --- FUNÇÃO QUE ATUALIZA AS PARCELAS (VERSÃO CORRIGIDA) ---
async function updateInstallments() {
    const type = document.querySelector('input[name="cardType"]:checked').value;
    const installContainer = document.getElementById('installments-container');
    const select = document.getElementById('installments');
    
    const cardNumber = document.getElementById('cc-number').value.replace(/\s/g, '');
    if (cardNumber.length < 6) return;

    const bin = cardNumber.substring(0, 6);
    let freteValor = parseFloat(document.getElementById('shippingCostInput').value) || 0;
    
    // cartSubtotal já inclui o desconto de 5% se for o caso (se você implementou a lógica de recalcular)
    const totalFinal = cartSubtotal + freteValor;

    try {
        // 1. Pergunta ao Mercado Pago quais métodos esse cartão aceita
        const paymentMethods = await mp.getPaymentMethods({ bin: bin });
        if (paymentMethods.results.length === 0) return;

        // --- LOGICA DE SELEÇÃO DE DÉBITO OU CRÉDITO (FORÇANDO DÉBITO) ---
        let method;

        if (type === 'debit') {
            // 1. Tenta achar o ID de débito oficial (ex: debvisa, debmaster)
            method = paymentMethods.results.find(m => m.payment_type_id === 'debit_card');
            
            let finalMethodId;

            if (!method) {
                // SE NÃO ACHOU: Pegamos o ID da bandeira (ex: 'master') e forçamos o prefixo 'deb'
                let brandId = paymentMethods.results[0].id; 
                finalMethodId = brandId.startsWith('deb') ? brandId : 'deb' + brandId;
                
                console.log("Forçando ID de débito manual:", finalMethodId);
                method = paymentMethods.results[0]; // Usamos os dados da bandeira como base
            } else {
                finalMethodId = method.id;
            }

            // 2. Trava o visual em 1x
            select.innerHTML = '<option value="1">1x no Débito (À vista)</option>';
            installContainer.style.display = 'block';
            
            // 3. Preenche os campos com o ID forçado
            document.getElementById('paymentMethodId').value = finalMethodId;
            if (method.issuer) document.getElementById('issuerId').value = method.issuer.id;

            return; 
        }

        // --- SE FOR CRÉDITO ---
        method = paymentMethods.results.find(m => m.payment_type_id === 'credit_card') || paymentMethods.results[0];
        
        // Preenche os campos escondidos
        document.getElementById('paymentMethodId').value = method.id;
        if (method.issuer) document.getElementById('issuerId').value = method.issuer.id;

        // 2. Busca as parcelas no Mercado Pago (Só para crédito)
        const installments = await mp.getInstallments({
            amount: totalFinal.toFixed(2),
            bin: bin,
            paymentTypeId: 'credit_card'
        });

        select.innerHTML = ''; 
        
        if (installments.length > 0) {
            const opcoes = installments[0].payer_costs;
            opcoes.forEach(opt => {
                const option = document.createElement('option');
                option.value = opt.installments;
                option.text = opt.recommended_message; 
                select.appendChild(option);
            });
            installContainer.style.display = 'block'; 
        }

    } catch (error) {
        console.log("Erro ao identificar cartão/parcelas:", error);
    }
}

    // --- GATILHO DO CVV (SÓ RODA QUANDO PREENCHER O CÓDIGO) ---
    document.getElementById('cc-cvv').addEventListener('input', function(e) {
        const cvv = e.target.value;
        // Quando digitar 3 números do CVV, busca as parcelas
        if (cvv.length >= 3) {
            updateInstallments();
        }
    });

    // Função para resetar se trocar de Crédito para Débito
    function resetInstallments() {
        const cvv = document.getElementById('cc-cvv').value;
        if(cvv.length >= 3) {
            updateInstallments(); // Atualiza na hora se já tiver preenchido tudo
        }
    }


  // 1. Defina a trava fora de tudo
let processandoPedido = false;

const form = document.getElementById('paymentForm');

form.addEventListener('submit', async function(e) {
    // Para o envio padrão do navegador imediatamente
    e.preventDefault(); 

    // Se já estiver processando, não faz absolutamente nada
    if (processandoPedido) return false;

    const method = document.querySelector('input[name="paymentMethod"]:checked').value;
    const btn = document.querySelector('.btn-finish');

    // Ativa a trava e muda o visual
    processandoPedido = true;
    btn.disabled = true;
    btn.innerText = 'Processando...';
    btn.style.opacity = '0.5';
    btn.style.cursor = 'not-allowed';

    if (method === 'pix') {
        // Se for PIX, envia o formulário original manualmente
        form.submit();
        return;
    }

    // --- LÓGICA DE CARTÃO ---
    try {
        const tokenObj = await mp.createCardToken({
            cardNumber: document.getElementById('cc-number').value.replace(/\s/g, ''),
            cardholderName: document.getElementsByName('cardHolder')[0].value,
            cardExpirationMonth: document.getElementById('cc-exp').value.split('/')[0],
            cardExpirationYear: "20" + document.getElementById('cc-exp').value.split('/')[1],
            securityCode: document.getElementById('cc-cvv').value,
            identificationType: "CPF",
            identificationNumber: document.getElementsByName('cpf')[0].value.replace(/\D/g, '')
        });

        if (tokenObj && tokenObj.id) {
            document.getElementById('cardToken').value = tokenObj.id;
            
            // O SEGREDO: Usamos o método submit() do protótipo para evitar 
            // que o evento de 'submit' deste listener seja disparado de novo
            HTMLFormElement.prototype.submit.call(form);
        } else {
            throw new Error("Token não gerado.");
        }

    } catch (error) {
        console.error("Erro no token:", error);
        alert("Dados do cartão inválidos. Verifique os números e o CVV.");
        
        // Se deu erro, liberamos o botão para o cliente tentar de novo
        processandoPedido = false;
        btn.disabled = false;
        btn.innerText = 'Finalizar Pedido';
        btn.style.opacity = '1';
        btn.style.cursor = 'pointer';
    }
});

 function atualizarTotalGeral() {
    const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked').value;
    const shippingCost = parseFloat(document.getElementById('shippingCostInput').value) || 0;
    
    const discountRow = document.getElementById('pix-discount-row');
    const discountVisual = document.getElementById('valorDescontoPixVisual');
    const totalVisual = document.getElementById('totalFinalDisplay');

    let valorDesconto = 0;
    let valorProdutosFinal = cartSubtotal; 

    if (paymentMethod === 'pix') {
        valorDesconto = cartSubtotal * 0.05; 
        valorProdutosFinal = cartSubtotal - valorDesconto;
        if(discountRow) discountRow.style.display = 'flex';
        if(discountVisual) discountVisual.innerText = '- R$ ' + valorDesconto.toFixed(2).replace('.', ',');
    } else {
        if(discountRow) discountRow.style.display = 'none';
    }

    const totalFinal = valorProdutosFinal + shippingCost;
    totalVisual.innerText = 'R$ ' + totalFinal.toFixed(2).replace('.', ',');

    // --- CORREÇÃO DO BUG 2: ATUALIZAR PARCELAS ---
    // Se não for PIX e o usuário já tiver digitado o início do cartão, 
    // precisamos avisar o Mercado Pago que o valor total mudou para ele refazer as parcelas.
    const cardNumber = document.getElementById('cc-number').value.replace(/\s/g, '');
    if (paymentMethod !== 'pix' && cardNumber.length >= 6) {
        updateInstallments(); 
    }
}
</script>
