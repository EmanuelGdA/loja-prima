<!DOCTYPE html>
<html lang="pt-br">
<head>
    <!-- Inclui o Head (Meta tags, CSS, Fontes) -->
    <%- include('../partials/head.ejs') %>
</head>
<body>
    
    <!-- Inclui o Header (Menu, Logo) -->
    <%- include('../partials/header.ejs') %>

    <main>
        
        <!-- === LÓGICA DO BANNER === -->
        <% if (path === '/') { %>
            <!-- Adicionei id="heroBanner" aqui para o Script funcionar -->
            <section class="hero-banner" id="heroBanner" onclick="window.location.href='#destaques'" style="cursor: pointer;">
                <div class="hero-content">
                    <h2>Nova Coleção</h2>
                    <h1>Elegância &<br>Sofisticação</h1>
                    <p>Peças exclusivas selecionadas para você.</p>
                    <a href="#destaques" class="btn-hero">Ver Coleção</a>
                </div>
            </section>
        <% } %>
        <!-- ======================== -->

        <!-- Conteúdo específico da Home -->
        <section class="products-section" id="destaques">
            
            <h2 class="section-title">
                <%= (typeof path !== 'undefined' && (path === '/colecao' || path === '/search')) ? pageTitle : 'Destaques' %>
            </h2>
            
            <div class="product-grid">
                <% if (products.length > 0) { %>
                    <% products.forEach(p => { %>
                        <article class="product-card">
                            <a href="/produto/<%= p.id %>">
                                <div class="card-image">
                                    <img src="<%= p.imageUrl %>" alt="<%= p.title %>">
                                    <button class="btn-quick-view">Ver Detalhes</button>
                                </div>
                                <div class="card-info">
                                    <h3><%= p.title %></h3>
                                    <p class="category">
                                        <%= p.category %> 
                                        <% if(p.subcategory) { %> | <%= p.subcategory %> <% } %>
                                    </p>
                                    <div class="price">R$ <%= parseFloat(p.price).toFixed(2).replace('.', ',') %></div>
                                </div>
                            </a>
                        </article>
                    <% }) %>
                <% } else { %>
                    <div class="no-products" style="grid-column: 1 / -1; text-align: center;">
                        <p>Nenhum produto encontrado.</p>
                        <% if (typeof path !== 'undefined' && path !== '/') { %>
                            <a href="/" class="btn-cta" style="margin-top: 10px; display: inline-block;">Voltar para o Início</a>
                        <% } else { %>
                            <a href="/admin/adicionar-produto" class="btn-cta">Cadastrar Primeiro Produto</a>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <%- include('../partials/footer.ejs') %>

    <!-- === SCRIPT PARA TROCAR OS BANNERS (CARROSSEL) === -->
    <script>
        // 1. Lista de imagens para CELULAR (Verticais)
        // Certifique-se de que esses arquivos existem na pasta public/img
        const bannersMobile = [
            '/img/banner-mobile.png',  // Foto Principal
            '/img/banner-mobile.png',  // (Coloque outras fotos aqui quando tiver, ex: banner2.jpg)
        ];

        // 2. Lista de imagens para COMPUTADOR (Horizontais)
        const bannersDesktop = [
            'https://images.unsplash.com/photo-1496747611176-843222e1e57c?q=80&w=2073', // Foto 1
            'https://images.unsplash.com/photo-1483985988355-763728e1935b?q=80&w=2070'  // Foto 2
        ];

        let currentBannerIndex = 0;
        const heroBanner = document.getElementById('heroBanner');

        function changeBanner() {
            if (!heroBanner) return;

            // Verifica se a tela é de celular (menor que 768px)
            const isMobile = window.innerWidth <= 768;
            
            // Escolhe qual lista de fotos usar
            const images = isMobile ? bannersMobile : bannersDesktop;

            // Troca a imagem de fundo
            heroBanner.style.backgroundImage = `url('${images[currentBannerIndex]}')`;

            // Prepara o índice para a próxima foto (loop infinito)
            currentBannerIndex = (currentBannerIndex + 1) % images.length;
        }

        // Só roda o script se o banner existir na página (para não dar erro na busca)
        if (heroBanner) {
            changeBanner(); // Carrega a primeira imediatamente
            setInterval(changeBanner, 4000); // Troca a cada 4 segundos
        }
    </script>

</body>
</html>