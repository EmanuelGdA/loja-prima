<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('../partials/head.ejs') %>
    <link rel="stylesheet" href="/css/checkout.css">
</head>
<body>
    <header class="simple-header">
        <a href="/pedidos" class="back-link"><i class="fas fa-arrow-left"></i> Voltar</a>
        <div class="secure-badge"><i class="fas fa-lock"></i> Pagamento Seguro</div>
    </header>

    <main class="checkout-container">
        <div style="text-align: center; margin-bottom: 30px;">
            <h1>Realizar Pagamento</h1>
            <p>Pedido #<%= order.id.slice(0,6).toUpperCase() %> • Total: <strong>R$ <%= parseFloat(order.totalPrice).toFixed(2).replace('.', ',') %></strong></p>
        </div>

        <form action="/pagar-pedido/<%= order.id %>" method="POST" class="checkout-form" id="rePaymentForm">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="cpf" value="<%= order.user.cpf %>"> <!-- Usa o CPF salvo -->

            <div class="column">
                <h2>Escolha a forma de pagamento:</h2>
                
                <div class="payment-methods">
                    <label class="method-option">
                        <input type="radio" name="paymentMethod" value="pix" checked onclick="togglePayment('pix')">
                        <span><i class="fab fa-pix"></i> PIX (Aprovação Imediata)</span>
                    </label>
                    <label class="method-option">
                        <input type="radio" name="paymentMethod" value="credit_card" onclick="togglePayment('card')">
                        <span><i class="far fa-credit-card"></i> Cartão de Crédito</span>
                    </label>
                </div>

                <!-- Formulário do Cartão -->
                <div id="card-form" style="display: none; background: white; padding: 20px; border-radius: 4px; margin-top: 15px; border: 1px solid #eee;">
                    <div class="form-group">
                        <label>Número do Cartão</label>
                        <input type="text" name="cardNumber" placeholder="0000 0000 0000 0000" maxlength="19">
                    </div>
                    <div class="form-group"><label>Nome no Cartão</label><input type="text" name="cardHolder"></div>
                    <div class="form-row">
                        <div class="form-group"><label>Validade</label><input type="text" name="cardExpiration" placeholder="MM/AA"></div>
                        <div class="form-group"><label>CVV</label><input type="text" name="cardCvv" maxlength="4"></div>
                    </div>
                    <div class="form-group">
                        <label>Parcelamento</label>
                        <select name="installments">
                            <option value="1">1x (À vista)</option>
                            <option value="2">2x</option>
                            <option value="3">3x</option>
                        </select>
                    </div>
                </div>

                <button type="submit" class="btn-finish" style="margin-top: 20px;">Pagar Agora</button>
            </div>
        </form>
    </main>

    <%- include('../partials/footer.ejs') %>
    
    <script>
        function togglePayment(method) {
            const cardForm = document.getElementById('card-form');
            const inputs = cardForm.querySelectorAll('input, select');
            if (method === 'card') {
                cardForm.style.display = 'block';
                inputs.forEach(i => i.setAttribute('required', 'true'));
            } else {
                cardForm.style.display = 'none';
                inputs.forEach(i => i.removeAttribute('required'));
            }
        }
    </script>
</body>
</html>

