<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('../partials/head.ejs') %>
    <link rel="stylesheet" href="/css/product.css"> <!-- Vamos criar esse CSS logo abaixo -->
</head>
<body>
    <%- include('../partials/header.ejs') %>

    <main class="product-container">
        
        <!-- 1. GALERIA DE FOTOS (ESQUERDA) -->
        <div class="product-image">
            
            <!-- Foto Principal Grande -->
            <div class="main-image-container">
                <% 
                   // Pega a primeira imagem disponível ou a capa
                   let mainImg = (product.images && product.images.length > 0) ? product.images[0] : product.imageUrl; 
                %>
                <img src="<%= mainImg %>" id="zoomImage" alt="<%= product.title %>" onclick="openFullscreen(this.src)">
            </div>

            <!-- Miniaturas (Só aparece se tiver mais de 1 foto) -->
            <% if (product.images && product.images.length > 1) { %>
                <div class="thumbnails">
                    <% product.images.forEach((img, index) => { %>
                        <div class="thumb-box <%= index === 0 ? 'active' : '' %>" onclick="changeImage(this, '<%= img %>')">
                            <img src="<%= img %>">
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- 2. INFORMAÇÕES (DIREITA) -->
        <div class="product-info">
            <p style="font-size: 12px; color: #999; margin-bottom: 10px;">
                Home / <%= product.category %> / <%= product.subcategory || '' %>
            </p>
            
            <h1 class="product-title"><%= product.title %></h1>
            <% if (product.sku) { %><span class="sku">REF: <%= product.sku %></span><% } %>
            
            <!-- PREÇO -->
            <div class="price-container">
                <% if (product.promoPrice && product.originalPrice > product.promoPrice) { %>
                    <!-- TEM PROMOÇÃO -->
                    <span class="old-price">R$ <%= parseFloat(product.originalPrice).toFixed(2).replace('.', ',') %></span>
                    <span class="current-price">R$ <%= parseFloat(product.price).toFixed(2).replace('.', ',') %></span>
                    
                    <% let desc = Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100); %>
                    <span class="promo-tag"><%= desc %>% OFF</span>
                <% } else { %>
                    <!-- PREÇO NORMAL -->
                    <span class="current-price">R$ <%= parseFloat(product.price).toFixed(2).replace('.', ',') %></span>
                <% } %>

                <!-- Parcela -->
                <span class="installments">
                    ou em até 5x de R$ <%= (product.price / 5).toFixed(2).replace('.', ',') %> sem juros
                </span>
            </div>

            <!-- FORMULÁRIO DE ADICIONAR AO CARRINHO (ATUALIZADO) -->
            <!-- Adicionamos o id="addToCartForm" aqui para o script pegar -->
            <form action="/carrinho" method="POST" id="addToCartForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="productId" value="<%= product.id %>">

                <!-- SELETOR DE CORES -->
                <% if (product.colors && product.colors.length > 0) { %>
                    <div class="variation-group">
                        <label class="variation-label">Cor:</label>
                        <div class="color-options">
                            <% product.colors.forEach((cor, index) => { %>
                                <label class="color-option">
                                    <input type="radio" name="color" value="<%= cor %>" <%= index === 0 ? 'checked' : '' %>>
                                    <span class="color-circle" style="background-color: <%= cor %>;" title="<%= cor %>"></span>
                                </label>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <!-- SELETOR DE TAMANHOS -->
                <% if (product.sizes && product.sizes.length > 0) { %>
                    <!-- Adicionamos o id="sizeGroup" aqui para fazer ele tremer se der erro -->
                    <div class="variation-group" id="sizeGroup">
                        <label class="variation-label">Tamanho:</label>
                        <div class="size-options">
                            <% product.sizes.forEach((size, index) => { %>
                                <label class="size-option">
                                    <!-- IMPORTANTE: Removemos o 'required' nativo para usar nosso alerta bonito -->
                                    <input type="radio" name="size" value="<%= size %>">
                                    <span class="size-box"><%= size %></span>
                                </label>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <!-- BARRA DE FERRAMENTAS (Mantida) -->
                <div class="product-tools">
                    <button type="button" class="btn-tool-guide" onclick="toggleSizeGuide('open')">
                        <i class="fas fa-ruler-horizontal"></i> Guia de Medidas
                    </button>
                    <div class="tools-actions">
                        <button type="button" class="btn-icon-tool" onclick="shareProduct()" title="Compartilhar">
                            <i class="fas fa-share-alt"></i>
                        </button>
                        <button type="button" class="btn-icon-tool" id="favBtn" onclick="toggleFavorite('<%= product.id %>')" title="Amar">
                            <i class="far fa-heart" id="favIcon"></i>
                        </button>
                    </div>
                </div>

                <!-- LOGICA DE ESTOQUE (Mantida) -->
                <% if (product.stock > 0 && product.stock <= 5) { %>
                    <div class="stock-warning">
                        <i class="fas fa-exclamation-circle"></i>
                        Corra! Restam apenas <%= product.stock %> unidades.
                    </div>
                <% } else if (product.stock === 0) { %>
                    <div class="stock-warning" style="color: #666;">
                        <i class="fas fa-ban"></i> Produto Esgotado
                    </div>
                <% } %>

                <!-- BOTÃO COMPRAR (Visual Novo com Ícone) -->
                <button type="submit" class="btn-add-cart">
                    <i class="fas fa-shopping-bag"></i> ADICIONAR À SACOLA
                </button>
                
                <!-- BOTÃO WHATSAPP DO PRODUTO (Mantido) -->
                <button type="button" id="btnZapProduct" class="btn-whatsapp-product">
                    <i class="fab fa-whatsapp" style="font-size: 16px;"></i>
                    Dúvidas? Chame no WhatsApp
                </button>

                <!-- AVISO DE POSTAGEM (Mantido) -->
                <div class="handling-time-box">
                    <i class="fas fa-shipping-fast"></i>
                    <div>
                        <strong>Prazo de Postagem:</strong><br>
                        Enviamos seu pedido em até 2 dias úteis após a confirmação do pagamento.
                    </div>
                </div>
            </form>

            <!-- Script para montar a mensagem automática -->
            <script>
        // ... (suas funções de trocar imagem e frete continuam aqui) ...

        // SCRIPT NOVO DO WHATSAPP
        document.getElementById('btnZapProduct').addEventListener('click', function() {
            // SEU NÚMERO
            const phone = "5541996813385"; 
            
            const productName = "<%= product.title %>";
            const productLink = window.location.href;
            const msg = `Olá! Estou vendo o produto *${productName}* e tenho uma dúvida.\nLink: ${productLink}`;
            
            // Usa wa.me que é o padrão universal
            const url = `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;

            // Redireciona a página atual para o Whats (Funciona melhor no mobile)
            window.location.href = url;
        });
    </script>

            <!-- FRETE (Mantive o que já tínhamos feito) -->
            <div class="shipping-calc" style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee;">
                <label style="font-weight: bold; font-size: 13px;">Calcular Frete</label>
                <div style="display: flex; gap: 10px; margin-top: 5px;">
                    <input type="text" id="cepFrete" placeholder="00000-000" maxlength="9" style="padding: 8px; border: 1px solid #ddd; width: 150px;">
                    <button type="button" onclick="calcularFrete()" style="background: #333; color: white; border: none; padding: 0 15px; cursor: pointer;">OK</button>
                </div>
                <div id="resultadoFrete" style="margin-top: 10px; font-size: 13px;"></div>
            </div>

            <!-- DESCRIÇÃO -->
            <div style="margin-top: 30px;">
                <h3 style="font-size: 14px; text-transform: uppercase; border-bottom: 1px solid #ddd; padding-bottom: 5px;">Detalhes</h3>
                <p style="font-size: 14px; line-height: 1.6; color: #555; margin-top: 10px; white-space: pre-wrap;"><%= product.description %></p>
                <% if(product.material) { %>
                    <p style="font-size: 13px; margin-top: 10px;"><strong>Tecido:</strong> <%= product.material %></p>
                <% } %>
            </div>

        </div>
    </main>

    <!-- SEÇÃO DE AVALIAÇÕES -->
    <section class="reviews-section" style="max-width: 1200px; margin: 50px auto; padding: 0 20px;">
        <h2 style="font-family: 'Playfair Display'; margin-bottom: 20px; border-bottom: 1px solid #ddd; padding-bottom: 10px;">Avaliações das Clientes</h2>
        
        <!-- Lista de Comentários -->
        <div class="reviews-list" style="margin-bottom: 40px;">
            <% if (reviews && reviews.length > 0) { %>
                <% reviews.forEach(review => { %>
                    <div class="review-card" style="background: #f9f9f9; padding: 15px; margin-bottom: 15px; border-radius: 4px;">
                        <div style="display: flex; justify-content: space-between;">
                            <strong><%= review.userName %></strong>
                            <span style="color: #D4AF37;">
                                <% for(let i=0; i<review.rating; i++) { %>★<% } %>
                                <% for(let i=review.rating; i<5; i++) { %>☆<% } %>
                            </span>
                        </div>
                        <p style="margin-top: 5px; color: #555;"><%= review.comment %></p>
                        <small style="color: #999;"><%= new Date(review.date).toLocaleDateString('pt-BR') %></small>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="color: #777; font-style: italic;">Este produto ainda não tem avaliações. Seja a primeira a avaliar!</p>
            <% } %>
        </div>

        <!-- Formulário para Avaliar (Só aparece se logado) -->
        <% if (isAuthenticated) { %>
            <div class="review-form" style="background: white; border: 1px solid #eee; padding: 20px;">
                <h3>Deixe sua opinião</h3>
                <form action="/produto/avaliar" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="productId" value="<%= product.id %>">
                    
                    <div style="margin-bottom: 10px;">
                        <label>Nota:</label>
                        <select name="rating" style="padding: 5px;">
                            <option value="5">5 Estrelas (Amei!)</option>
                            <option value="4">4 Estrelas (Muito bom)</option>
                            <option value="3">3 Estrelas (Bom)</option>
                            <option value="2">2 Estrelas (Regular)</option>
                            <option value="1">1 Estrela (Ruim)</option>
                        </select>
                    </div>
                    
                    <div style="margin-bottom: 10px;">
                        <label>Comentário:</label>
                        <textarea name="comment" rows="3" style="width: 100%; padding: 10px;" required placeholder="O que você achou da peça?"></textarea>
                    </div>
                    
                    <button type="submit" style="background: black; color: white; border: none; padding: 10px 20px; cursor: pointer;">Enviar Avaliação</button>
                </form>
            </div>
        <% } else { %>
            <div style="background: #f0f0f0; padding: 15px; text-align: center;">
                <a href="/login" style="text-decoration: underline; font-weight: bold;">Faça login</a> para deixar uma avaliação.
            </div>
        <% } %>
    </section>

    <!-- SEÇÃO DE PRODUTOS RELACIONADOS -->
    <% if (relatedProducts && relatedProducts.length > 0) { %>
        <section class="related-products" style="max-width: 1400px; margin: 80px auto; padding: 0 5%;">
            <h2 class="section-title">Você também pode gostar</h2>
            
            <div class="product-grid">
                <% relatedProducts.forEach(p => { %>
                    <article class="product-card">
                        
                        <!-- PARTE DE CIMA: IMAGEM (Clicável) -->
                        <a href="/produto/<%= p.id %>" style="display: block; text-decoration: none;">
                            <div class="card-image">
                                <img src="<%= p.imageUrl %>" alt="<%= p.title %>">
                                
                                <!-- Etiquetas -->
                                <div class="product-badges">
                                    <% if (p.isNew) { %> <span class="badge-tag badge-new">New</span> <% } %>
                                    <% if (p.promoPrice) { %> 
                                        <% let desc = 0; try { desc = Math.round(((p.originalPrice - p.price) / p.originalPrice) * 100); } catch(e){} %>
                                        <% if(desc > 0) { %><span class="badge-tag badge-sale"><%= desc %>% OFF</span><% } %>
                                    <% } %>
                                </div>
                            </div>
                        </a>

                        <!-- PARTE DE BAIXO: FUNDO ROSA TOTAL (Texto + Botões) -->
                        <div class="card-content-rose">
                            
                            <!-- Texto (Clicável) -->
                            <a href="/produto/<%= p.id %>" style="text-decoration: none;">
                                <div class="card-info">
                                    <h3><%= p.title %></h3>
                                    
                                    <div class="price-container">
                                        <% if (p.promoPrice && p.originalPrice > p.promoPrice) { %>
                                            <span class="old-price" style="font-size: 12px; margin-bottom: -3px;">
                                                De: R$ <%= parseFloat(p.originalPrice).toFixed(2).replace('.', ',') %>
                                            </span>
                                            <span class="current-price promo" style="font-size: 18px;">
                                                Por: R$ <%= parseFloat(p.price).toFixed(2).replace('.', ',') %>
                                            </span>
                                        <% } else { %>
                                            <span class="current-price" style="font-size: 18px;">
                                                R$ <%= parseFloat(p.price).toFixed(2).replace('.', ',') %>
                                            </span>
                                        <% } %>
                                        
                                        <small style="font-size: 10px; color: #888; margin-top: 4px;">
                                            ou 5x de R$ <%= (p.price / 5).toFixed(2).replace('.', ',') %>
                                        </small>
                                    </div>
                                </div>
                            </a>

                            <!-- Botões Duplos -->
                            <div class="card-actions">
                                <a href="/produto/<%= p.id %>" class="btn-card btn-spy">ESPIAR</a>
                                <a href="/produto/<%= p.id %>" class="btn-card btn-buy">COMPRAR</a>
                            </div>
                        </div>

                    </article>
                <% }) %>
            </div>
        </section>
    <% } %>

    <!-- JANELA DE ZOOM (LIGHTBOX) -->
    <div id="fullscreenModal" class="lightbox-overlay" onclick="closeFullscreen()">
        <span class="lightbox-close">&times;</span>
        <img class="lightbox-content" id="fullscreenImg">
    </div>


    <%- include('../partials/footer.ejs') %>

    <script>

        // Função para trocar a imagem principal
    function changeImage(element, src) {
        // Troca a foto grande
        document.getElementById('zoomImage').src = src;
        
        // Remove a borda dos outros
        document.querySelectorAll('.thumb-box').forEach(el => el.classList.remove('active'));
        
        // Adiciona borda no clicado
        element.classList.add('active');
    }

    async function calcularFrete() {
        const cep = document.getElementById('cepFrete').value.replace(/\D/g, '');
        const resultadoDiv = document.getElementById('resultadoFrete');
        
        // Pega o ID do produto (certifique-se que as aspas estão aí por causa do EJS)
        const productId = "<%= product.id %>"; 

        if (cep.length !== 8) {
            resultadoDiv.innerHTML = '<span style="color: red;">CEP inválido</span>';
            return;
        }

        resultadoDiv.innerHTML = 'Calculando... <i class="fas fa-spinner fa-spin"></i>';

        try {
            const response = await fetch('/api/frete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'CSRF-Token': '<%= csrfToken %>' },
                // AQUI: NÃO enviamos isCheckout: true, pois queremos ver todas as opções
                body: JSON.stringify({ cep: cep, productId: productId }) 
            });

            const opcoes = await response.json();

            if (opcoes.error) {
                resultadoDiv.innerHTML = `<span style="color: red;">${opcoes.error}</span>`;
                return;
            }

            if (opcoes.length === 0) {
                resultadoDiv.innerHTML = 'Nenhuma opção de entrega encontrada.';
                return;
            }

            // --- VISUAL NOVO COM ÍCONES ---
            let html = '<div style="margin-top: 15px; border-top: 1px solid #eee;">';
            
            opcoes.forEach(op => {
                // 1. Lógica dos Ícones
                let iconHTML = '';
                let iconColor = '#f5f5f5'; // Cinza
                let textColor = '#555';

                if (op.nome.toLowerCase().includes('retirar')) {
                    iconHTML = '<i class="fas fa-store"></i>';
                    iconColor = '#e8f5e9'; // Verde Claro
                    textColor = '#2f855a';
                } else if (op.nome.toLowerCase().includes('motoboy')) {
                    iconHTML = '<i class="fas fa-motorcycle"></i>';
                    iconColor = '#fff3e0'; // Laranja Claro
                    textColor = '#e67e22';
                } else if (op.logo) {
                    iconHTML = `<img src="${op.logo}" style="height: 15px; width: auto;">`;
                } else {
                    iconHTML = '<i class="fas fa-truck"></i>';
                }

                // 2. Texto do Prazo
                let prazoTxt = (op.prazo == 0) ? 'Entrega Hoje' : `${op.prazo} dias úteis`;
                if(op.id === 'local_retirada') prazoTxt = 'Disponível Imediatamente';

                // 3. Texto do Preço
                let precoTxt = op.preco === 0 ? '<span style="color:#27ae60">Grátis</span>' : `R$ ${op.preco.toFixed(2).replace('.', ',')}`;

                html += `
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #f9f9f9;">
                        
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <!-- Ícone -->
                            <div style="
                                width: 35px; height: 35px; border-radius: 50%; 
                                background-color: ${iconColor}; color: ${textColor};
                                display: flex; align-items: center; justify-content: center;
                                font-size: 14px; flex-shrink: 0;
                            ">
                                ${iconHTML}
                            </div>
                            
                            <!-- Nome e Prazo -->
                            <div style="display: flex; flex-direction: column;">
                                <span style="font-size: 12px; font-weight: 700; color: #333; text-transform: uppercase;">
                                    ${op.nome}
                                </span>
                                <span style="font-size: 11px; color: #999;">
                                    ${prazoTxt}
                                </span>
                            </div>
                        </div>

                        <!-- Preço -->
                        <div style="font-weight: 700; font-size: 14px; color: #000;">
                            ${precoTxt}
                        </div>
                    </div>
                `;
            });
            html += '</div>';
            resultadoDiv.innerHTML = html;

        } catch (error) {
            console.error(error);
            resultadoDiv.innerHTML = '<span style="color: red;">Erro ao calcular.</span>';
        }
    }

        // Abre a foto em tela cheia
        function openFullscreen(src) {
            const modal = document.getElementById('fullscreenModal');
            const img = document.getElementById('fullscreenImg');
            
            img.src = src; // Pega a foto que foi clicada
            modal.style.display = "flex"; // Mostra a tela preta
            
            // Trava a rolagem da página de trás
            document.body.style.overflow = "hidden";
        }

        // Fecha a foto
        function closeFullscreen() {
            const modal = document.getElementById('fullscreenModal');
            modal.style.display = "none";
            document.body.style.overflow = "auto"; // Destrava a rolagem
        }
        
        // Mantém sua função de trocar miniaturas
        function changeImage(element, src) {
            document.getElementById('zoomImage').src = src;
            document.querySelectorAll('.thumb-box').forEach(el => el.classList.remove('active'));
            element.classList.add('active');
        }
    
</script>

<!-- === MODAL GUIA DE MEDIDAS (ESTILO APP) === -->
    <div id="sizeGuideModal" class="modal-overlay" onclick="toggleSizeGuide('close')">
        
        <div class="modal-content-app" onclick="event.stopPropagation()">
            <span class="close-app-btn" onclick="toggleSizeGuide('close')">&times;</span>
            
            <div class="modal-header">
                <h3>Tabela de Medidas</h3>
            </div>

            <% if (product.measures && product.measures.length > 0) { %>
                
                <span class="size-nav-label">Selecione um tamanho e verifique as medidas</span>

                <!-- 1. Botões de Tamanho (P, M, G...) -->
                <div class="size-scroller">
                    <% 
                        // Lógica Inteligente:
                        // 1. Lista de todos os possíveis tamanhos
                        const todosTamanhos = ['PP', 'P', 'M', 'G', 'GG', 'U'];
                        
                        // 2. Filtra apenas os que têm dados preenchidos (diferente de '-' e vazio)
                        const tamanhosValidos = todosTamanhos.filter(tam => {
                            // Verifica se ALGUMA linha de medida tem valor para esse tamanho
                            return product.measures.some(linha => linha[tam] && linha[tam].trim() !== '-' && linha[tam].trim() !== '');
                        });

                        // Fallback: Se por acaso tudo estiver vazio (erro), mostra todos pra não quebrar
                        const tamanhosFinais = tamanhosValidos.length > 0 ? tamanhosValidos : todosTamanhos;
                    %>
                    
                    <% tamanhosFinais.forEach((tam, index) => { %>
                        <!-- O clique chama a função para atualizar os números -->
                        <button class="size-btn-app" 
                                onclick="updateMeasuresApp('<%= tam %>', this)"
                                data-size="<%= tam %>">
                            <%= tam %>
                        </button>
                    <% }) %>
                </div>

                <div class="measure-title-bar">
                    Medidas da peça
                </div>

                <!-- 2. Lista de Valores (Atualizada via JS) -->
                <ul class="measure-list-app" id="measureListDisplay">
                    <!-- O JavaScript vai preencher aqui -->
                </ul>

                <!-- Dados Escondidos (JSON) para o Javascript ler -->
                <script>
                    const medidasData = <%- JSON.stringify(product.measures) %>;
                </script>

            <% } else { %>
                <p style="padding: 20px; color: #666;">Nenhuma medida específica cadastrada.</p>
            <% } %>

        </div>
        
    </div>


    <!-- SCRIPT DA TABELA INTERATIVA -->
    <script>

        // --- COMPARTILHAR ---
        async function shareProduct() {
            const data = {
                title: '<%= product.title %>',
                text: 'Olha que lindo este produto da Maely Cristina!',
                url: window.location.href
            };

            // Se o navegador suportar compartilhamento nativo (Celular)
            if (navigator.share) {
                try {
                    await navigator.share(data);
                } catch (err) { console.log('Cancelou compartilhar'); }
            } else {
                // Se for PC, copia o link para a área de transferência
                navigator.clipboard.writeText(window.location.href);
                alert("Link copiado! Pode enviar para as amigas.");
            }
        }

        // --- FAVORITAR (Coração) ---
        const prodId = "<%= product.id %>"; // ID do produto atual

        // Verifica se já deu like antes ao carregar a página
        function checkFavorite() {
            const favorites = JSON.parse(localStorage.getItem('myFavorites')) || [];
            const btn = document.getElementById('favBtn');
            const icon = document.getElementById('favIcon');

            if (favorites.includes(prodId)) {
                btn.classList.add('loved'); // Fica vermelho
                icon.classList.remove('far'); // Tira coração vazio
                icon.classList.add('fas');    // Põe coração cheio
            }
        }

        // Ação de clicar no coração (Atualizada)
        async function toggleFavorite(id) {
            // 1. Atualiza LocalStorage (Visual Imediato)
            let favorites = JSON.parse(localStorage.getItem('myFavorites')) || [];
            const btn = document.getElementById('favBtn');
            const icon = document.getElementById('favIcon');

            if (favorites.includes(id)) {
                favorites = favorites.filter(favId => favId !== id);
                btn.classList.remove('loved');
                icon.classList.remove('fas');
                icon.classList.add('far');
            } else {
                favorites.push(id);
                btn.classList.add('loved');
                icon.classList.remove('far');
                icon.classList.add('fas');
            }
            localStorage.setItem('myFavorites', JSON.stringify(favorites));

            // 2. Avisa o Servidor (Background)
            // Se estiver logado, salva no banco também
            try {
                await fetch('/api/toggle-favorite', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'csrf-token': '<%= csrfToken %>' },
                    body: JSON.stringify({ productId: id })
                });
            } catch (e) { console.log('Erro ao salvar no banco', e); }
        }

        // Roda a verificação ao entrar na página
        window.addEventListener('load', checkFavorite);

        // Função para abrir/fechar com Seleção Automática
        function toggleSizeGuide(action) {
            const modal = document.getElementById('sizeGuideModal');
            if(action === 'open') {
                modal.style.display = 'flex';
                document.body.style.overflow = 'hidden';
                
                // AJUSTE: Clica no PRIMEIRO botão de tamanho que estiver visível
                const primeiroBotao = document.querySelector('.size-btn-app');
                if(primeiroBotao) {
                    primeiroBotao.click();
                }
            } else {
                modal.style.display = 'none';
                document.body.style.overflow = 'auto';
            }
        }

        // Função que troca os números quando clica no tamanho
        function updateMeasuresApp(tamanho, btnElement) {
            // 1. Atualiza visual dos botões
            document.querySelectorAll('.size-btn-app').forEach(b => b.classList.remove('active'));
            btnElement.classList.add('active');

            // 2. Busca a lista onde vamos escrever
            const lista = document.getElementById('measureListDisplay');
            lista.innerHTML = '';

            // 3. Varre os dados e cria as linhas (Ex: Busto: 88 cm)
            if (typeof medidasData !== 'undefined') {
                medidasData.forEach(item => {
                    // Item.name é "Busto", Item[tamanho] é "88"
                    let valor = item[tamanho];
                    if (!valor || valor === '-') valor = '--'; 
                    // Se não tiver "cm" no texto, adicionamos
                    if (valor !== '--' && !valor.includes('cm')) valor += ' cm';

                    const li = document.createElement('li');
                    li.className = 'measure-item';
                    li.innerHTML = `
                        <span>${item.name}</span>
                        <span class="measure-value">
                            ${valor} <i class="fas fa-chevron-down"></i>
                        </span>
                    `;
                    lista.appendChild(li);
                });
            }
        }
    </script>

    <!-- ALERTA FLUTUANTE (TOAST) -->
    <div id="toast-warning"><i class="fas fa-exclamation-circle"></i> Por favor, selecione um tamanho.</div>

    <script>
        // SCRIPT DE VALIDAÇÃO DE TAMANHO
        document.getElementById('addToCartForm').addEventListener('submit', function(e) {
            // Verifica se existem tamanhos para escolher
            const sizeContainer = document.getElementById('sizeGroup');
            
            if (sizeContainer) {
                // Tenta achar um tamanho marcado
                const sizeSelected = document.querySelector('input[name="size"]:checked');
                
                if (!sizeSelected) {
                    e.preventDefault(); // CANCELA O ENVIO (Não recarrega a página)
                    
                    // 1. Mostra o Alerta (Toast)
                    const toast = document.getElementById("toast-warning");
                    toast.className = "show";
                    setTimeout(function(){ toast.className = toast.className.replace("show", ""); }, 3000); // Some depois de 3s
                    
                    // 2. Faz a área de tamanhos tremer (Shake effect)
                    sizeContainer.classList.add('shake-animation');
                    setTimeout(() => {
                        sizeContainer.classList.remove('shake-animation');
                    }, 500); // Remove a classe depois que tremer
                }
            }
        });
        
        // ... (seus outros scripts de zoom e whats continuam aqui) ...
    </script>


