<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('../partials/head.ejs') %>
    <link rel="stylesheet" href="/css/product.css"> <!-- Vamos criar esse CSS logo abaixo -->
</head>
<body>
    <%- include('../partials/header.ejs') %>

    <main class="product-container">
        
        <!-- 1. GALERIA DE FOTOS (ESQUERDA) -->
        <div class="product-image">
            
            <!-- Foto Principal Grande -->
            <div class="main-image-container">
                <% 
                   // Pega a primeira imagem disponível ou a capa
                   let mainImg = (product.images && product.images.length > 0) ? product.images[0] : product.imageUrl; 
                %>
                <img src="<%= mainImg %>" id="zoomImage" alt="<%= product.title %>">
            </div>

            <!-- Miniaturas (Só aparece se tiver mais de 1 foto) -->
            <% if (product.images && product.images.length > 1) { %>
                <div class="thumbnails">
                    <% product.images.forEach((img, index) => { %>
                        <div class="thumb-box <%= index === 0 ? 'active' : '' %>" onclick="changeImage(this, '<%= img %>')">
                            <img src="<%= img %>">
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- 2. INFORMAÇÕES (DIREITA) -->
        <div class="product-info">
            <p style="font-size: 12px; color: #999; margin-bottom: 10px;">
                Home / <%= product.category %> / <%= product.subcategory || '' %>
            </p>
            
            <h1 class="product-title"><%= product.title %></h1>
            <% if (product.sku) { %><span class="sku">REF: <%= product.sku %></span><% } %>
            
            <!-- PREÇO -->
            <div class="price-container">
                <% if (product.promoPrice && product.originalPrice > product.promoPrice) { %>
                    <!-- TEM PROMOÇÃO -->
                    <span class="old-price">R$ <%= parseFloat(product.originalPrice).toFixed(2).replace('.', ',') %></span>
                    <span class="current-price">R$ <%= parseFloat(product.price).toFixed(2).replace('.', ',') %></span>
                    
                    <% let desc = Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100); %>
                    <span class="promo-tag"><%= desc %>% OFF</span>
                <% } else { %>
                    <!-- PREÇO NORMAL -->
                    <span class="current-price">R$ <%= parseFloat(product.price).toFixed(2).replace('.', ',') %></span>
                <% } %>

                <!-- Parcela -->
                <span class="installments">
                    ou em até 6x de R$ <%= (product.price / 6).toFixed(2).replace('.', ',') %> sem juros
                </span>
            </div>

            <!-- FORMULÁRIO DE ADICIONAR AO CARRINHO -->
            <form action="/carrinho" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="productId" value="<%= product.id %>">

                <!-- SELETOR DE CORES (Dinâmico) -->
                <% if (product.colors && product.colors.length > 0) { %>
                    <div class="variation-group">
                        <label class="variation-label">Cor:</label>
                        <div class="color-options">
                            <% product.colors.forEach((cor, index) => { %>
                                <label class="color-option">
                                    <!-- A primeira cor vem marcada por padrão -->
                                    <input type="radio" name="color" value="<%= cor %>" <%= index === 0 ? 'checked' : '' %>>
                                    <!-- Exibe a bolinha colorida -->
                                    <span class="color-circle" style="background-color: <%= cor %>;" title="<%= cor %>"></span>
                                </label>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <!-- SELETOR DE TAMANHOS (Dinâmico) -->
                <% if (product.sizes && product.sizes.length > 0) { %>
                    <div class="variation-group">
                        <label class="variation-label">Tamanho:</label>
                        <div class="size-options">
                            <% product.sizes.forEach((size, index) => { %>
                                <label class="size-option">
                                    <input type="radio" name="size" value="<%= size %>" required>
                                    <span class="size-box"><%= size %></span>
                                </label>
                            <% }) %>
                        </div>
                        <a href="#" style="font-size: 11px; text-decoration: underline; margin-top: 5px; display: block;">Guia de Medidas</a>
                    </div>
                <% } %>

                <!-- BOTÃO COMPRAR -->
                <button type="submit" class="btn-add-cart" 
                    style="width: 100%; background: #000; color: white; padding: 15px; border: none; font-weight: bold; cursor: pointer; text-transform: uppercase;">
                    Adicionar à Sacola
                </button>
                
            </form>

            <!-- BOTÃO ZAP PRODUTO -->
            <button type="button" id="btnZapProduct" class="btn-whatsapp-product">
    <i class="fab fa-whatsapp" style="font-size: 16px;"></i>
    Dúvidas? Chame no WhatsApp
</button>

            <!-- Script para montar a mensagem automática -->
            <script>
        // ... (suas funções de trocar imagem e frete continuam aqui) ...

        // SCRIPT NOVO DO WHATSAPP
        document.getElementById('btnZapProduct').addEventListener('click', function() {
            // SEU NÚMERO
            const phone = "5541996813385"; 
            
            const productName = "<%= product.title %>";
            const productLink = window.location.href;
            const msg = `Olá! Estou vendo o produto *${productName}* e tenho uma dúvida.\nLink: ${productLink}`;
            
            // Usa wa.me que é o padrão universal
            const url = `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;

            // Redireciona a página atual para o Whats (Funciona melhor no mobile)
            window.location.href = url;
        });
    </script>

            <!-- FRETE (Mantive o que já tínhamos feito) -->
            <div class="shipping-calc" style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee;">
                <label style="font-weight: bold; font-size: 13px;">Calcular Frete</label>
                <div style="display: flex; gap: 10px; margin-top: 5px;">
                    <input type="text" id="cepFrete" placeholder="00000-000" maxlength="9" style="padding: 8px; border: 1px solid #ddd; width: 150px;">
                    <button type="button" onclick="calcularFrete()" style="background: #333; color: white; border: none; padding: 0 15px; cursor: pointer;">OK</button>
                </div>
                <div id="resultadoFrete" style="margin-top: 10px; font-size: 13px;"></div>
            </div>

            <!-- DESCRIÇÃO -->
            <div style="margin-top: 30px;">
                <h3 style="font-size: 14px; text-transform: uppercase; border-bottom: 1px solid #ddd; padding-bottom: 5px;">Detalhes</h3>
                <p style="font-size: 14px; line-height: 1.6; color: #555; margin-top: 10px; white-space: pre-wrap;"><%= product.description %></p>
                <% if(product.material) { %>
                    <p style="font-size: 13px; margin-top: 10px;"><strong>Tecido:</strong> <%= product.material %></p>
                <% } %>
            </div>

        </div>
    </main>

    <!-- SEÇÃO DE AVALIAÇÕES -->
    <section class="reviews-section" style="max-width: 1200px; margin: 50px auto; padding: 0 20px;">
        <h2 style="font-family: 'Playfair Display'; margin-bottom: 20px; border-bottom: 1px solid #ddd; padding-bottom: 10px;">Avaliações das Clientes</h2>
        
        <!-- Lista de Comentários -->
        <div class="reviews-list" style="margin-bottom: 40px;">
            <% if (reviews && reviews.length > 0) { %>
                <% reviews.forEach(review => { %>
                    <div class="review-card" style="background: #f9f9f9; padding: 15px; margin-bottom: 15px; border-radius: 4px;">
                        <div style="display: flex; justify-content: space-between;">
                            <strong><%= review.userName %></strong>
                            <span style="color: #D4AF37;">
                                <% for(let i=0; i<review.rating; i++) { %>★<% } %>
                                <% for(let i=review.rating; i<5; i++) { %>☆<% } %>
                            </span>
                        </div>
                        <p style="margin-top: 5px; color: #555;"><%= review.comment %></p>
                        <small style="color: #999;"><%= new Date(review.date).toLocaleDateString('pt-BR') %></small>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="color: #777; font-style: italic;">Este produto ainda não tem avaliações. Seja a primeira a avaliar!</p>
            <% } %>
        </div>

        <!-- Formulário para Avaliar (Só aparece se logado) -->
        <% if (isAuthenticated) { %>
            <div class="review-form" style="background: white; border: 1px solid #eee; padding: 20px;">
                <h3>Deixe sua opinião</h3>
                <form action="/produto/avaliar" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="productId" value="<%= product.id %>">
                    
                    <div style="margin-bottom: 10px;">
                        <label>Nota:</label>
                        <select name="rating" style="padding: 5px;">
                            <option value="5">5 Estrelas (Amei!)</option>
                            <option value="4">4 Estrelas (Muito bom)</option>
                            <option value="3">3 Estrelas (Bom)</option>
                            <option value="2">2 Estrelas (Regular)</option>
                            <option value="1">1 Estrela (Ruim)</option>
                        </select>
                    </div>
                    
                    <div style="margin-bottom: 10px;">
                        <label>Comentário:</label>
                        <textarea name="comment" rows="3" style="width: 100%; padding: 10px;" required placeholder="O que você achou da peça?"></textarea>
                    </div>
                    
                    <button type="submit" style="background: black; color: white; border: none; padding: 10px 20px; cursor: pointer;">Enviar Avaliação</button>
                </form>
            </div>
        <% } else { %>
            <div style="background: #f0f0f0; padding: 15px; text-align: center;">
                <a href="/login" style="text-decoration: underline; font-weight: bold;">Faça login</a> para deixar uma avaliação.
            </div>
        <% } %>
    </section>

    <!-- SEÇÃO DE PRODUTOS RELACIONADOS -->
    <% if (relatedProducts && relatedProducts.length > 0) { %>
        <section class="related-products" style="max-width: 1400px; margin: 80px auto; padding: 0 5%;">
            <h2 class="section-title">Você também pode gostar</h2>
            
            <div class="product-grid">
                <% relatedProducts.forEach(p => { %>
                    <article class="product-card">
                        
                        <!-- PARTE DE CIMA: IMAGEM (Clicável) -->
                        <a href="/produto/<%= p.id %>" style="display: block; text-decoration: none;">
                            <div class="card-image">
                                <img src="<%= p.imageUrl %>" alt="<%= p.title %>">
                                
                                <!-- Etiquetas -->
                                <div class="product-badges">
                                    <% if (p.isNew) { %> <span class="badge-tag badge-new">New</span> <% } %>
                                    <% if (p.promoPrice) { %> 
                                        <% let desc = 0; try { desc = Math.round(((p.originalPrice - p.price) / p.originalPrice) * 100); } catch(e){} %>
                                        <% if(desc > 0) { %><span class="badge-tag badge-sale"><%= desc %>% OFF</span><% } %>
                                    <% } %>
                                </div>
                            </div>
                        </a>

                        <!-- PARTE DE BAIXO: FUNDO ROSA TOTAL (Texto + Botões) -->
                        <div class="card-content-rose">
                            
                            <!-- Texto (Clicável) -->
                            <a href="/produto/<%= p.id %>" style="text-decoration: none;">
                                <div class="card-info">
                                    <h3><%= p.title %></h3>
                                    
                                    <div class="price-container">
                                        <% if (p.promoPrice && p.originalPrice > p.promoPrice) { %>
                                            <span class="old-price" style="font-size: 12px; margin-bottom: -3px;">
                                                De: R$ <%= parseFloat(p.originalPrice).toFixed(2).replace('.', ',') %>
                                            </span>
                                            <span class="current-price promo" style="font-size: 18px;">
                                                Por: R$ <%= parseFloat(p.price).toFixed(2).replace('.', ',') %>
                                            </span>
                                        <% } else { %>
                                            <span class="current-price" style="font-size: 18px;">
                                                R$ <%= parseFloat(p.price).toFixed(2).replace('.', ',') %>
                                            </span>
                                        <% } %>
                                        
                                        <small style="font-size: 10px; color: #888; margin-top: 4px;">
                                            ou 3x de R$ <%= (p.price / 3).toFixed(2).replace('.', ',') %>
                                        </small>
                                    </div>
                                </div>
                            </a>

                            <!-- Botões Duplos -->
                            <div class="card-actions">
                                <a href="/produto/<%= p.id %>" class="btn-card btn-spy">ESPIAR</a>
                                <a href="/produto/<%= p.id %>" class="btn-card btn-buy">COMPRAR</a>
                            </div>
                        </div>

                    </article>
                <% }) %>
            </div>
        </section>
    <% } %>

    <%- include('../partials/footer.ejs') %>

    <script>

        // Função para trocar a imagem principal
    function changeImage(element, src) {
        // Troca a foto grande
        document.getElementById('zoomImage').src = src;
        
        // Remove a borda dos outros
        document.querySelectorAll('.thumb-box').forEach(el => el.classList.remove('active'));
        
        // Adiciona borda no clicado
        element.classList.add('active');
    }

    async function calcularFrete() {
        const cep = document.getElementById('cepFrete').value.replace(/\D/g, '');
        const resultadoDiv = document.getElementById('resultadoFrete');
        const productId = "<%= product.id %>"; 

        if (cep.length !== 8) {
            resultadoDiv.innerHTML = '<span style="color: red;">CEP inválido</span>';
            return;
        }

        resultadoDiv.innerHTML = 'Calculando... <i class="fas fa-spinner fa-spin"></i>';

        try {
            const response = await fetch('/api/frete', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    // AQUI ESTÁ A CORREÇÃO: Enviamos o token de segurança junto
                    'CSRF-Token': '<%= csrfToken %>' 
                },
                body: JSON.stringify({ cep, productId })
            });

            const opcoes = await response.json();

            if (opcoes.error) {
                resultadoDiv.innerHTML = `<span style="color: red;">${opcoes.error}</span>`;
                return;
            }

            if (opcoes.length === 0) {
                resultadoDiv.innerHTML = 'Nenhuma opção de entrega encontrada.';
                return;
            }

            // Monta a lista de fretes
            let html = '<ul style="list-style: none; padding: 0;">';
            opcoes.forEach(op => {
                html += `
                    <li style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #eee;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <img src="${op.logo}" height="20" alt="${op.nome}" style="max-width: 50px;">
                            <span style="font-size: 13px;">${op.nome}</span>
                        </div>
                        <div style="text-align: right;">
                            <strong>R$ ${op.preco.toFixed(2).replace('.', ',')}</strong><br>
                            <small style="color: #666;">${op.prazo} dias úteis</small>
                        </div>
                    </li>
                `;
            });
            html += '</ul>';
            resultadoDiv.innerHTML = html;

        } catch (error) {
            console.error(error);
            resultadoDiv.innerHTML = '<span style="color: red;">Erro ao calcular. Tente mais tarde.</span>';
        }
    }
</script>
</body>
</html>