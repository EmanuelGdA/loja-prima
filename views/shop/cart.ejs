<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <%- include('../partials/head.ejs') %>
    <link rel="stylesheet" href="/css/cart.css" />
    <!-- CSS novo -->
  </head>
  <body>
    <%- include('../partials/header.ejs') %>

    <main class="cart-container">
      <h1>Sua Sacola de Compras</h1>

      <!-- LÓGICA DA BARRA DE FRETE -->
        <% 
            const FRETE_GRATIS_LIMIT = 499.00;
            const atual = cart.totalPrice;
            const falta = FRETE_GRATIS_LIMIT - atual;
            let porcentagem = (atual / FRETE_GRATIS_LIMIT) * 100;
            if (porcentagem > 100) porcentagem = 100;
        %>

        <div class="free-shipping-container">
            <div class="progress-track">
                <div class="progress-fill" style="width: <%= porcentagem %>%;">
                    <div class="truck-icon-progress">
                        <i class="fas fa-shipping-fast"></i>
                    </div>
                </div>
            </div>

            <div class="shipping-msg <%= falta <= 0 ? 'success' : '' %>">
                <% if (falta > 0) { %>
                    Gaste mais <strong>R$ <%= parseFloat(falta).toFixed(2).replace('.', ',') %></strong> para aproveitar <strong>FRETE GRÁTIS!</strong>
                <% } else { %>
                    Parabéns! Você ganhou <strong>FRETE GRÁTIS</strong> para todo o Brasil! 🎉
                <% } %>
            </div>
        </div>

      <% if (cart.items.length > 0) { %>
      <div class="cart-content">
        <!-- Lista de Produtos -->
        <div class="cart-items">
          <table class="cart-table">
            <thead>
              <tr>
                <th>Produto</th>
                <th>Preço</th>
                <th>Qtd</th>
                <th>Total</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
                <% cart.items.forEach(item => { %>
                    <tr class="cart-item-row">
                        <!-- 1. PRODUTO + DETALHES (MOBILE SELETOR FICA AQUI) -->
                        <td class="product-col">
                            <div class="product-wrapper">
                                <a href="/produto/<%= item.productId %>">
                                    <img src="<%= item.imageUrl %>" alt="<%= item.title %>">
                                </a>
                                <div class="item-details">
                                    <strong><%= item.title %></strong>
                                    
                                    <div class="variant-info">
                                        <span>Tam: <%= item.size %></span>
                                        <% if(item.color && item.color !== 'Única') { %>
                                            <span class="color-dot" style="background-color: <%= item.color %>;" title="<%= item.color %>"></span>
                                        <% } %>
                                    </div>

                                    <!-- SELETOR DE QUANTIDADE (MOBILE) -->
                                    <!-- A classe 'mobile-qty' (crie se precisar esconder no PC) ou deixe assim -->
                                    <div class="quantity-control mobile-only-qty" style="margin-top: 10px;">
                                        
                                        <!-- Botão Menos -->
                                        <form action="/carrinho/diminuir" method="POST" style="display:inline;">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="productId" value="<%= item.productId %>">
                                            <input type="hidden" name="size" value="<%= item.size %>">
                                            <input type="hidden" name="color" value="<%= item.color || '' %>">
                                            <button type="submit" class="qty-btn minus">-</button>
                                        </form>

                                        <span class="qty-number"><%= item.qty %></span>

                                        <!-- Botão Mais -->
                                        <form action="/carrinho/aumentar" method="POST" style="display:inline;">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="productId" value="<%= item.productId %>">
                                            <input type="hidden" name="size" value="<%= item.size %>">
                                            <input type="hidden" name="color" value="<%= item.color || '' %>">
                                            <button type="submit" class="qty-btn plus">+</button>
                                        </form>
                                    </div>
                                    
                                    <!-- PREÇO (Aparece embaixo no celular) -->
                                    <div class="mobile-price">
                                        Total: R$ <%= (item.price * item.qty).toFixed(2).replace('.', ',') %>
                                    </div>
                                </div>
                            </div>
                        </td>

                        <!-- 2. COLUNAS DESKTOP -->
                        <td class="desktop-only">R$ <%= item.price.toFixed(2).replace('.', ',') %></td>
                        
                        <!-- SELETOR DE QUANTIDADE (DESKTOP) - SUBSTITUÍ O NÚMERO FIXO POR ISSO: -->
                        <td class="desktop-only">
                            <div class="quantity-control">
                                <form action="/carrinho/diminuir" method="POST" style="display:inline;">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="productId" value="<%= item.productId %>">
                                    <input type="hidden" name="size" value="<%= item.size %>">
                                    <input type="hidden" name="color" value="<%= item.color || '' %>">
                                    <button type="submit" class="qty-btn minus">-</button>
                                </form>
                                <span class="qty-number"><%= item.qty %></span>
                                <form action="/carrinho/aumentar" method="POST" style="display:inline;">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="productId" value="<%= item.productId %>">
                                    <input type="hidden" name="size" value="<%= item.size %>">
                                    <input type="hidden" name="color" value="<%= item.color || '' %>">
                                    <button type="submit" class="qty-btn plus">+</button>
                                </form>
                            </div>
                        </td>

                        <td class="desktop-only">
                            <strong>R$ <%= (item.price * item.qty).toFixed(2).replace('.', ',') %></strong>
                        </td>
                        
                        <!-- 3. BOTÃO REMOVER -->
                        <td class="action-col">
                            <form action="/carrinho-delete" method="POST">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="productId" value="<%= item.productId %>">
                                <input type="hidden" name="size" value="<%= item.size %>">
                                <input type="hidden" name="color" value="<%= item.color || '' %>">
                                <button type="submit" class="btn-remove">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Resumo do Pedido -->
        <div class="cart-summary">
          <h3>Resumo do Pedido</h3>

          <div class="summary-row">
            <span>Subtotal</span>
            <span
              >R$ <%= parseFloat(cart.totalPrice).toFixed(2).replace('.', ',')
              %></span
            >
          </div>

          <!-- === LÓGICA DO CUPOM (AQUI ESTÁ O QUE FALTAVA) === -->
          <% if (cart.coupon) { %>
          <!-- SE TIVER CUPOM APLICADO -->
          <div class="summary-row" style="color: #2ecc71; font-weight: bold">
            <span>Desconto (<%= cart.coupon.code %>)</span>
            <span
              >- R$ <%= (cart.totalPrice -
              cart.totalWithDiscount).toFixed(2).replace('.', ',') %></span
            >
          </div>

          <!-- Botão para Remover -->
          <form
            action="/carrinho/remover-cupom"
            method="POST"
            style="margin-bottom: 15px; text-align: right"
          >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button
              type="submit"
              style="
                background: none;
                border: none;
                font-size: 11px;
                color: red;
                text-decoration: underline;
                cursor: pointer;
              "
            >
              Remover cupom
            </button>
          </form>

          <% } else { %>
          <!-- SE NÃO TIVER CUPOM: MOSTRA O CAMPO -->
          <div style="margin: 15px 0">
            <label
              style="
                font-size: 12px;
                font-weight: bold;
                display: block;
                margin-bottom: 5px;
              "
              >Possui Cupom?</label
            >
            <form
              action="/carrinho/cupom"
              method="POST"
              style="display: flex; gap: 5px"
            >
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input
                type="text"
                name="couponCode"
                placeholder="Ex: PRIMA10"
                style="
                  flex: 1;
                  padding: 10px;
                  border: 1px solid #ddd;
                  border-radius: 4px;
                  text-transform: uppercase;
                "
              />
              <button
                type="submit"
                style="
                  background: black;
                  color: white;
                  border: none;
                  padding: 0 15px;
                  border-radius: 4px;
                  cursor: pointer;
                  font-weight: bold;
                "
              >
                OK
              </button>
            </form>
          </div>
          <% } %>
          <!-- ================================================= -->

          <div class="summary-row">
            <span>Frete</span>
            <span style="font-size: 12px; color: #666"
              >Calculado no Checkout</span
            >
          </div>

          <hr />

          <div class="summary-row total">
            <span>Total</span>
            <!-- CORREÇÃO: Se tem cupom, usa o valor com desconto. Se não, usa o cheio. -->
            <span
              >R$ <%= (cart.coupon ? cart.totalWithDiscount :
              cart.totalPrice).toFixed(2).replace('.', ',') %></span
            >
          </div>

          <a href="/checkout" class="btn-checkout">Finalizar Compra</a>
          <a href="/" class="btn-continue">Continuar Comprando</a>
        </div>
      </div>
      <% } else { %>
      <div class="empty-cart">
        <i class="fas fa-shopping-basket"></i>
        <h2>Sua sacola está vazia</h2>
        <p>Navegue pela loja e descubra nossas novidades.</p>
        <a href="/" class="btn-cta">Ver Coleção</a>
      </div>
      <% } %>
    </main>

    <%- include('../partials/footer.ejs') %>
  </body>
</html>
