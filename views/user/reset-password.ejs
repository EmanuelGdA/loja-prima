<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('../partials/head.ejs') %>
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
    <%- include('../partials/header.ejs') %>
    <main class="auth-container">
        <div class="auth-card">
            <h2 class="auth-title">Nova Senha</h2>
            <p class="auth-subtitle">Crie uma senha segura.</p>
            <% if (errorMessage.length > 0) { %><div class="alert error"><%= errorMessage %></div><% } %>
            <form action="/redefinir-senha" method="POST" class="auth-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="token" value="<%= token %>">
                <div class="input-group">
                    <label>Nova Senha</label>
                    <input type="password" name="password" required minlength="6">
                </div>
                <div class="input-group">
                    <label>Confirmar Senha</label>
                    <input type="password" name="confirmPassword" required>
                </div>
                <button type="submit" class="btn-black">ALTERAR SENHA</button>
            </form>
        </div>
    </main>
    <%- include('../partials/footer.ejs') %>
</body>
</html>