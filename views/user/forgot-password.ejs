<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('../partials/head.ejs') %>
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
    <%- include('../partials/header.ejs') %>
    <main class="auth-container">
        <div class="auth-card">
            <h2 class="auth-title">Recuperar Senha</h2>
            <p class="auth-subtitle">Digite seu e-mail para receber o link.</p>
            <% if (errorMessage.length > 0) { %><div class="alert error"><%= errorMessage %></div><% } %>
            <form action="/esqueci-senha" method="POST" class="auth-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="input-group">
                    <label>E-mail Cadastrado</label>
                    <input type="email" name="email" required>
                </div>
                <button type="submit" class="btn-black">ENVIAR LINK</button>
            </form>
            <div style="text-align: center; margin-top: 20px;">
                <a href="/login" style="font-size: 13px; text-decoration: underline;">Voltar para o Login</a>
            </div>
        </div>
    </main>
    <%- include('../partials/footer.ejs') %>
</body>
</html>