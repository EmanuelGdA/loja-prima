<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('../partials/head.ejs') %>
    <link rel="stylesheet" href="/css/auth.css">
    <style>
        /* Ajuste específico para o botão Google ficar bonito */
        .btn-google {
            width: 100%;
            background: white;
            color: #555;
            border: 1px solid #ddd;
            padding: 15px;
            border-radius: 50px; /* Redondinho */
            font-weight: bold;
            font-size: 15px;
            font-family: 'Montserrat', sans-serif;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            transition: 0.3s;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
        .btn-google:hover {
            background-color: #f8f8f8;
            border-color: #ccc;
            transform: translateY(-2px);
        }
        .btn-google img { width: 22px; }

        .auth-tabs { display: flex; border-bottom: 2px solid #eee; margin-bottom: 30px; }
    .tab-btn { flex: 1; padding: 15px; border: none; background: none; font-weight: bold; cursor: pointer; color: #999; }
    .tab-btn.active { color: #000; border-bottom: 2px solid #000; }
    .auth-content { display: none; }
    .auth-content.active { display: block; }
    .divider { margin: 25px 0; text-align: center; position: relative; }
    .divider::before { content: ""; position: absolute; left: 0; top: 50%; width: 100%; height: 1px; background: #eee; z-index: 1; }
    .divider span { background: white; padding: 0 15px; position: relative; z-index: 2; color: #999; font-size: 12px; }
    .form-group { text-align: left; margin-bottom: 15px; }
    .form-group label { display: block; font-size: 12px; font-weight: bold; margin-bottom: 5px; }
    .form-group input { width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 8px; }
    .btn-auth { width: 100%; padding: 15px; background: #000; color: #fff; border: none; border-radius: 50px; font-weight: bold; cursor: pointer; margin-top: 10px; }
    </style>
</head>
<body>
    <%- include('../partials/header.ejs') %>

    <main class="auth-container">
    <div class="auth-card">
        <!-- ABAS -->
        <div class="auth-tabs">
            <button class="tab-btn active" onclick="switchTab('login')">Entrar</button>
            <button class="tab-btn" onclick="switchTab('signup')">Criar Conta</button>
        </div>

        <!-- FORMULÁRIO DE LOGIN -->
        <div id="login-form" class="auth-content active">
            <h2 class="auth-title">Acesse sua conta</h2>
            <form action="/login" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                    <label>E-mail ou Telefone</label>
                    <input type="text" name="loginIdentifier" placeholder="seu@email.com ou (00) 00000-0000" required>
                </div>
                <div class="form-group">
                    <label>Senha</label>
                    <input type="password" name="password" required>
                </div>
                <button type="submit" class="btn-auth">ENTRAR</button>
            </form>
        </div>

        <!-- FORMULÁRIO DE CADASTRO -->
        <div id="signup-form" class="auth-content">
            <h2 class="auth-title">Crie sua conta</h2>
            <form action="/signup" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                    <label>Nome Completo</label>
                    <input type="text" name="name" required>
                </div>
                <div class="form-group">
                    <label>E-mail</label>
                    <input type="email" name="email" required>
                </div>
                <div class="form-group">
                    <label>Telefone</label>
                    <input type="text" name="phone" placeholder="(00) 00000-0000" oninput="maskPhone(this)" required>
                </div>
                <div class="form-group">
                    <label>Senha</label>
                    <input type="password" name="password" required>
                </div>
                <button type="submit" class="btn-auth">CRIAR MINHA CONTA</button>
            </form>
        </div>

        <div class="divider"><span>OU</span></div>

        <!-- GOOGLE (Sempre Visível) -->
        <button type="button" onclick="loginWithGoogle()" class="btn-google">
            <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="G">
            Continuar com Google
        </button>

        <% if (errorMessage) { %>
            <div class="auth-error" style="color: red; font-size: 13px; margin-top: 15px;"><%= errorMessage %></div>
        <% } %>
    </div>
</main>


    <%- include('../partials/footer.ejs') %>

    <!-- SCRIPTS DE INTERFACE E LOGICA -->
    <script>
        // 1. FUNÇÕES GLOBAIS (Interface)
        // Usamos window. para garantir que o HTML encontre as funções
        window.switchTab = function(type) {
            document.querySelectorAll('.auth-content').forEach(c => c.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            
            const targetForm = document.getElementById(type + '-form');
            if (targetForm) targetForm.classList.add('active');

            // Ativa o botão clicado
            if (window.event && window.event.currentTarget) {
                window.event.currentTarget.classList.add('active');
            }
        };

        window.maskPhone = function(i) {
            i.value = i.value.replace(/\D/g, '')
                .replace(/^(\d{2})(\d)/g, "($1) $2")
                .replace(/(\d)(\d{4})$/, "$1-$2");
        };
    </script>

    <!-- 2. SCRIPT DO FIREBASE (Módulo) -->
    <script type="module">
        // Importamos getApps e getApp para evitar o erro de "Duplicate App"
        import { initializeApp, getApps, getApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getAuth, signInWithPopup, GoogleAuthProvider } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";

        const firebaseConfig = {
  apiKey: "AIzaSyBZZFSFViRJdHbOFYergjUe2CzTxV3k65g",
  authDomain: "login.maelycristina.com.br",
  projectId: "maely-cristina-b0ce1",
  storageBucket: "maely-cristina-b0ce1.firebasestorage.app",
  messagingSenderId: "552721009488",
  appId: "1:552721009488:web:25b265e464d173cffb7a55",
  measurementId: "G-PSPG6F2CE5"
};

        // Inicialização protegida contra duplicidade
        const app = getApps().length === 0 ? initializeApp(firebaseConfig) : getApp();
        const auth = getAuth(app);
        const provider = new GoogleAuthProvider();

        // TORNA A FUNÇÃO DO GOOGLE GLOBAL (Obrigatório para o onclick funcionar)
        window.loginWithGoogle = function() {
            signInWithPopup(auth, provider)
                .then((result) => {
                    result.user.getIdToken().then((token) => {
                        sendTokenToServer(token);
                    });
                }).catch((error) => {
                    console.error("Erro Google:", error);
                    if(error.code !== 'auth/closed-by-user') {
                        alert("Erro ao conectar com Google: " + error.message);
                    }
                });
        };

        function sendTokenToServer(token) {
            fetch('/auth/google', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'CSRF-Token': '<%= csrfToken %>'
                },
                body: JSON.stringify({ token: token })
            })
            .then(res => res.json())
            .then(data => {
                if (data.status === 'success') {
                    window.location.href = '/';
                } else {
                    alert("Erro ao validar conta no servidor.");
                }
            })
            .catch(err => console.error("Erro fetch:", err));
        }
    </script>
</body>
</html>
