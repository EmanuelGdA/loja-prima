<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('../partials/head.ejs') %>
    <link rel="stylesheet" href="/css/auth.css">
    <style>
        /* Ajuste específico para o botão Google ficar bonito */
        .btn-google {
            width: 100%;
            background: white;
            color: #555;
            border: 1px solid #ddd;
            padding: 15px;
            border-radius: 50px; /* Redondinho */
            font-weight: bold;
            font-size: 15px;
            font-family: 'Montserrat', sans-serif;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            transition: 0.3s;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
        .btn-google:hover {
            background-color: #f8f8f8;
            border-color: #ccc;
            transform: translateY(-2px);
        }
        .btn-google img { width: 22px; }
    </style>
</head>
<body>
    <%- include('../partials/header.ejs') %>

    <main class="auth-container">
        <div class="auth-card" style="text-align: center;">
            
            <h2 class="auth-title">Bem-vindo(a)!</h2>
            <p class="auth-subtitle" style="margin-bottom: 40px;">
                Para sua segurança e facilidade, acesse usando sua conta Google.
                <br>Não precisa criar senha.
            </p>
            
            <!-- BOTÃO ÚNICO DO GOOGLE -->
            <button type="button" onclick="loginWithGoogle()" class="btn-google">
                <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="G">
                Continuar com Google
            </button>

            <p style="margin-top: 30px; font-size: 12px; color: #999;">
                Seus dados estão protegidos.
            </p>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

    <!-- SCRIPTS DO FIREBASE -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getAuth, signInWithPopup, GoogleAuthProvider } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";

       
        const firebaseConfig = {
            apiKey: "AIzaSyCqzer1uVrqaIw-orkgakBEG5QkYhTb4kw",
            authDomain: "loja-prima.firebaseapp.com",
            projectId: "loja-prima",
            storageBucket: "loja-prima.firebasestorage.app",
            messagingSenderId: "744309889992",
            appId: "1:744309889992:web:295585b36da4e3c1f43efd"
        };
        

        const app = initializeApp(firebaseConfig);
        const auth = getAuth();
        const provider = new GoogleAuthProvider();

        window.loginWithGoogle = function() {
            signInWithPopup(auth, provider)
                .then((result) => {
                    result.user.getIdToken().then((token) => {
                        sendTokenToServer(token);
                    });
                }).catch((error) => {
                    console.error(error);
                    alert("Erro ao conectar: " + error.message);
                });
        };

        function sendTokenToServer(token) {
            fetch('/auth/google', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'CSRF-Token': '<%= csrfToken %>'
                },
                body: JSON.stringify({ token: token })
            })
            .then(res => res.json())
            .then(data => {
                if (data.status === 'success') {
                    window.location.href = '/';
                } else {
                    alert("Erro no servidor.");
                }
            });
        }
    </script>
</body>
</html>