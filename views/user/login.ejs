<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('../partials/head.ejs') %>
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
    <%- include('../partials/header.ejs') %>

    <main class="auth-container">
        <div class="auth-card">
            <h2 class="auth-title">Bem-vindo(a)</h2>
            <p class="auth-subtitle">Entre com seus dados para continuar.</p>
            
            <% if (errorMessage.length > 0) { %>
                <div class="alert error"><%= errorMessage %></div>
            <% } %>
            <% if (successMessage.length > 0) { %>
                <div class="alert success"><%= successMessage %></div>
            <% } %>

            <form action="/login" method="POST" class="auth-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                
                <div class="input-group">
                    <label>E-mail</label>
                    <input type="email" name="email" required placeholder="exemplo@gmail.com">
                </div>
                <div class="input-group">
                    <label>Senha</label>
                    <input type="password" name="password" required placeholder="********">
                </div>
                
                <div style="text-align: right; margin-bottom: 20px;">
                    <a href="#" onclick="alert('Entre em contato com o suporte no WhatsApp para recuperar.');" style="font-size: 12px; color: #666; text-decoration: underline;">Esqueci minha senha</a>
                </div>

                <button type="submit" class="btn-black">ENTRAR</button>
            </form>

            <div class="auth-separator">
                <span>OU</span>
            </div>

            <div class="auth-links">
                <p>Ainda não tem conta?</p>
                <a href="/cadastro" class="btn-outline">CRIAR CONTA</a>
            </div>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>
</body>
</html>