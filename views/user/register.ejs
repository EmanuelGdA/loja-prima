<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('../partials/head.ejs') %>
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
    <%- include('../partials/header.ejs') %>

    <main class="auth-container">
        <div class="auth-card">
            <h2 class="auth-title">Crie sua Conta</h2>
            <p class="auth-subtitle">Preencha seus dados para acessar ofertas exclusivas.</p>

            <% if (errorMessage.length > 0) { %>
                <div class="alert error"><i class="fas fa-exclamation-circle"></i> <%= errorMessage %></div>
            <% } %>

            <form action="/cadastro" method="POST" class="auth-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="input-group">
                    <label>Nome Completo</label>
                    <input type="text" name="name" required placeholder="Seu nome">
                </div>

                <div class="input-group">
                    <label>E-mail</label>
                    <input type="email" name="email" required placeholder="seu@email.com">
                </div>

                <!-- CAMPO DE TELEFONE NOVO -->
                <div class="input-group">
                    <label>Celular / WhatsApp</label>
                    <input type="text" name="phone" id="phone" required placeholder="(99) 99999-9999" maxlength="15" onkeyup="maskPhone(this)">
                </div>

                <div class="input-group">
                    <label>Senha</label>
                    <input type="password" name="password" required placeholder="********" minlength="6">
                </div>

                <div class="input-group">
                    <label>Confirmar Senha</label>
                    <input type="password" name="confirmPassword" required placeholder="********">
                </div>

                <button type="submit" class="btn-black">CADASTRAR</button>
            </form>

            <div class="auth-links">
                <p>Já é cliente?</p>
                <a href="/login" class="link-bold">Fazer Login</a>
            </div>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        // Máscara simples para celular
        function maskPhone(input) {
            let v = input.value.replace(/\D/g,'');
            v = v.replace(/^(\d{2})(\d)/g,"($1) $2");
            v = v.replace(/(\d)(\d{4})$/,"$1-$2");
            input.value = v;
        }
    </script>
</body>
</html>