<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('../partials/head.ejs') %>
    <style>
        .admin-container { max-width: 1100px; margin: 40px auto; padding: 0 20px; }
        
        /* BLOCO 1: DASHBOARD (MÉTRICAS) */
        .dashboard-grid {
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); /* Responsivo automático */
            gap: 20px; 
            margin-bottom: 40px;
        }
        .dash-card {
            background: white; padding: 20px; border-radius: 12px;
            border: 1px solid #eee; box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            text-align: center;
        }
        .dash-number { font-size: 24px; font-weight: 800; color: #000; margin-bottom: 5px; display: block; }
        .dash-label { font-size: 12px; text-transform: uppercase; color: #888; font-weight: 600; letter-spacing: 1px; }

        /* BLOCO 2: BARRA DE FILTROS */
        .filter-bar { display: flex; gap: 10px; margin-bottom: 20px; overflow-x: auto; padding-bottom: 10px; }
        .filter-btn {
            background: white; border: 1px solid #ddd; padding: 8px 16px; border-radius: 20px;
            font-size: 13px; font-weight: 600; cursor: pointer; transition: 0.2s; white-space: nowrap;
        }
        .filter-btn:hover, .filter-btn.active { background: black; color: white; border-color: black; }

        /* BLOCO 3: CARD DO PEDIDO (ESTILO NOVO) */
        .orders-list { display: flex; flex-direction: column; gap: 15px; }
        
        .order-card { 
            background: white; border: 1px solid #eee; border-radius: 8px; 
            transition: 0.3s;
        }
        .order-card:hover { border-color: #ccc; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }

        /* Resumo (Sempre visível) */
        .order-summary { 
            padding: 20px; cursor: pointer; display: flex; justify-content: space-between; align-items: center;
        }
        
        .client-info h4 { margin: 0; font-size: 16px; font-weight: 700; color: #333; }
        .client-info small { color: #888; font-size: 12px; display: block; margin-top: 4px; }

        .order-meta { text-align: right; }
        .meta-price { font-weight: 800; font-size: 16px; display: block; margin-bottom: 5px; }
        
        /* Badges de Status Coloridos */
        .badge-status { padding: 4px 10px; border-radius: 4px; font-size: 10px; font-weight: bold; text-transform: uppercase; }
        .st-aguardando { background: #FFF4E5; color: #B76E00; } /* Laranja */
        .st-pago { background: #EDF7ED; color: #1E4620; } /* Verde */
        .st-enviado { background: #E5F6FD; color: #014361; } /* Azul */
        .st-cancelado { background: #FFEBEE; color: #C62828; } /* Vermelho */

        /* Detalhes (Abre ao clicar) */
        .order-details { display: none; padding: 20px; background: #f9f9f9; border-top: 1px solid #eee; }
        .order-details.open { display: block; animation: slideDown 0.3s; }

        /* Grid de informações internas (3 Colunas) */
        .details-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; font-size: 13px; margin-bottom: 20px; }
        .col-title { font-weight: bold; font-size: 11px; text-transform: uppercase; color: #999; margin-bottom: 8px; display: block; }
        .detail-row { margin-bottom: 4px; color: #333; word-break: break-word; }
        .detail-row strong { color: #000; }

        /* Tabela de Itens */
        .items-table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; border: 1px solid #eee; }
        .items-table th { text-align: left; background: #eee; padding: 10px; font-size: 11px; text-transform: uppercase; }
        .items-table td { padding: 10px; border-bottom: 1px solid #eee; font-size: 13px; }

        /* Ações (Formulário) */
        .action-bar { 
            background: white; padding: 15px; border-radius: 8px; margin-top: 20px; border: 1px solid #eee;
            display: flex; gap: 10px; align-items: center;
        }
        .tracking-input { flex: 1; padding: 10px; border: 1px solid #ccc; border-radius: 4px; }
        .status-select { padding: 10px; border: 1px solid #ccc; border-radius: 4px; }
        .btn-save { background: black; color: white; border: none; padding: 10px 20px; border-radius: 4px; font-weight: bold; cursor: pointer; }

        /* Responsividade */
        @media (max-width: 768px) {
            .details-grid { grid-template-columns: 1fr; } /* Vira 1 coluna no celular */
            .action-bar { flex-direction: column; }
            .tracking-input, .status-select, .btn-save { width: 100%; }
            .client-info h4 { font-size: 14px; }
        }

        /* CORREÇÃO DOS BOTÕES DE FILTRO NO CELULAR */
        .filter-bar {
            flex-wrap: wrap; /* Permite que os botões desçam para a próxima linha */
            overflow-x: visible; /* Tira a rolagem lateral */
            justify-content: center; /* Centraliza os botões */
            gap: 8px; /* Espaço entre eles */
        }

        .filter-btn {
            flex: 1 1 45%; /* Faz cada botão ocupar +/- metade da tela */
            text-align: center; /* Texto no meio */
            font-size: 11px; /* Letra um pouco menor para caber */
            padding: 10px 5px; /* Mais área para o dedo clicar */
            white-space: normal; /* Permite que o texto "A Enviar (Pagos)" quebre linha se precisar */
        }

        @keyframes slideDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>
    <%- include('../partials/header.ejs') %>

    <main class="admin-container">
        <h1 style="text-align: center; margin-bottom: 30px; font-family: 'Playfair Display';">Painel de Vendas</h1>

        <!-- 1. DASHBOARD (RESUMO DE NÚMEROS) -->
        <!-- Esses números 'stats' vêm do backend atualizado -->
        <div class="dashboard-grid">
            <div class="dash-card">
                <span class="dash-number" style="color: #2ecc71;">R$ <%= stats.totalSales.toFixed(2).replace('.', ',') %></span>
                <span class="dash-label">Faturamento (Real)</span>
            </div>
            <div class="dash-card">
                <span class="dash-number"><%= stats.paid %></span>
                <span class="dash-label">Para Enviar</span>
            </div>
            <div class="dash-card">
                <span class="dash-number" style="color: #f39c12;"><%= stats.pending %></span>
                <span class="dash-label">Aguardando Pag.</span>
            </div>
            <div class="dash-card">
                <span class="dash-number" style="color: #3498db;"><%= stats.shipped %></span>
                <span class="dash-label">Enviados</span>
            </div>
        </div>

        <!-- 2. BOTÕES DE FILTRO -->
        <div class="filter-bar">
            <button class="filter-btn active" onclick="filterOrders('todos')">Todos</button>
            <button class="filter-btn" onclick="filterOrders('pago')">A Enviar (Pagos)</button>
            <button class="filter-btn" onclick="filterOrders('pendente')">Pendentes</button>
            <button class="filter-btn" onclick="filterOrders('enviado')">Histórico Enviados</button>
        </div>

        <!-- 3. LISTA DE PEDIDOS DETALHADA -->
        <div class="orders-list">
            <% if (orders.length > 0) { %>
                <% orders.forEach(order => { %>
                    <!-- Lógica para definir a cor e o filtro do card -->
                    <% 
                        let filterClass = 'todos';
                        let s = order.status;
                        let badgeColor = 'st-aguardando';

                        if (s.includes('Pago') || s.includes('Preparando')) { filterClass += ' pago'; badgeColor = 'st-pago'; }
                        else if (s.includes('Aguardando')) { filterClass += ' pendente'; badgeColor = 'st-aguardando'; }
                        else if (s.includes('Enviado') || s.includes('Entregue')) { filterClass += ' enviado'; badgeColor = 'st-enviado'; }
                        else if (s.includes('Cancelado')) { badgeColor = 'st-cancelado'; }
                    %>

                    <div class="order-card <%= filterClass %>">
                        
                        <!-- RESUMO (Sempre Visível) -->
                        <div class="order-summary" onclick="toggleDetails('<%= order.id %>')">
                            <div class="client-info">
                                <h4><%= order.user.name %></h4>
                                <small>
                                    <%= new Date(order.date).toLocaleDateString('pt-BR') %> • 
                                    Pedido #<%= order.id.slice(0,6) %>...
                                </small>
                            </div>
                            <div class="order-meta">
                                <span class="meta-price">R$ <%= parseFloat(order.totalPrice).toFixed(2).replace('.', ',') %></span>
                                <span class="badge-status <%= badgeColor %>"><%= order.status %></span>
                            </div>
                        </div>

                        <!-- DETALHES (Abre ao Clicar) -->
                        <div class="order-details" id="detail-<%= order.id %>">
                            
                            <!-- Grid de Informações -->
                            <div class="details-grid">
                                <!-- Coluna Cliente -->
                                <div>
                                    <span class="col-title">Dados do Cliente</span>
                                    <div class="detail-row"><strong>Nome:</strong> <%= order.user.name %></div>
                                    <div class="detail-row"><strong>CPF:</strong> <%= order.user.cpf %></div>
                                    <div class="detail-row"><strong>Email:</strong> <%= order.user.email %></div>
                                </div>
                                
                                <!-- Coluna Financeiro -->
                                <div>
                                    <span class="col-title">Financeiro</span>
                                    <div class="detail-row"><strong>Forma:</strong> <%= order.paymentMethod %></div>
                                    <div class="detail-row"><strong>Subtotal:</strong> R$ <%= (order.subtotal || 0).toFixed(2) %></div>
                                    <% if(order.couponUsed) { %>
                                        <div class="detail-row" style="color: green;"><strong>Cupom:</strong> <%= order.couponUsed %></div>
                                    <% } %>
                                    <div class="detail-row"><strong>Total:</strong> R$ <%= order.totalPrice.toFixed(2) %></div>
                                </div>

                                <!-- Coluna Logística -->
                                <div>
                                    <span class="col-title">Entrega</span>
                                    <div class="detail-row"><strong>Método:</strong> <%= order.shippingMethod || 'Fixo' %></div>
                                    <div class="detail-row"><strong>Frete:</strong> R$ <%= (order.shippingCost || 0).toFixed(2) %></div>
                                    <div class="detail-row" style="margin-top:5px; font-size:12px; color:#555;">
                                        <%= order.address.rua %>, <%= order.address.numero %><br>
                                        <%= order.address.bairro %> - <%= order.address.cidade %>/<%= order.address.estado %><br>
                                        CEP: <%= order.address.cep %>
                                    </div>
                                </div>
                            </div>

                            <!-- Lista de Produtos -->
                            <table class="items-table">
                                <thead><tr><th>Produto</th><th>Tam</th><th>Qtd</th><th>Preço</th></tr></thead>
                                <tbody>
                                    <% order.items.forEach(item => { %>
                                        <tr>
                                            <td><%= item.title %></td>
                                            <td><%= item.size %></td>
                                            <td><%= item.qty %></td>
                                            <td>R$ <%= parseFloat(item.price).toFixed(2).replace('.', ',') %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>

                            <!-- Ações (Rastreio e Status) -->
                            <div class="action-bar">
                                <strong style="display:block; width:100%; margin-bottom:5px;">Atualizar Pedido:</strong>
                                
                                <form action="/admin/atualizar-status" method="POST" style="display:flex; gap:10px; width:100%; flex-wrap:wrap;">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="orderId" value="<%= order.id %>">
                                    
                                    <!-- CAMPO DE RASTREIO -->
                                    <input type="text" name="trackingCode" class="tracking-input" 
                                           placeholder="Cole o Cód. Rastreio aqui" 
                                           value="<%= order.trackingCode || '' %>">
                                    
                                    <!-- CAMPO DE STATUS -->
                                    <select name="status" class="status-select">
                                        <option value="Aguardando Pagamento" <%= order.status.includes('Aguardando') ? 'selected' : '' %>>Aguardando Pagamento</option>
                                        <option value="Pago / Preparando Envio" <%= order.status.includes('Pago') ? 'selected' : '' %>>Pago / Preparando</option>
                                        <option value="Enviado" <%= order.status.includes('Enviado') ? 'selected' : '' %>>Enviado</option>
                                        <option value="Entregue" <%= order.status.includes('Entregue') ? 'selected' : '' %>>Entregue</option>
                                        <option value="Cancelado" <%= order.status.includes('Cancelado') ? 'selected' : '' %>>Cancelado</option>
                                    </select>
                                    
                                    <button type="submit" class="btn-save">Salvar</button>
                                </form>
                            </div>

                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div style="text-align: center; padding: 50px; color: #999;">
                    <p>Nenhuma venda encontrada.</p>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

    <!-- SCRIPTS DE INTERAÇÃO -->
    <script>
        // Abre e fecha os detalhes
        function toggleDetails(id) {
            const el = document.getElementById('detail-' + id);
            el.classList.toggle('open');
        }

        // Filtra os pedidos na tela sem recarregar
        function filterOrders(status) {
            // Arruma a cor dos botões
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            event.target.classList.add('active');

            // Esconde ou mostra os cards
            const cards = document.querySelectorAll('.order-card');
            cards.forEach(card => {
                if (status === 'todos' || card.classList.contains(status)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }
    </script>
</body>
</html>