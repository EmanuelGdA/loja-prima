<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('../partials/head.ejs') %>
    <style>
        .admin-container { max-width: 1100px; margin: 40px auto; padding: 0 20px; }
        
        /* DASHBOARD */
        .dashboard-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px; margin-bottom: 40px;
        }
        .dash-card {
            background: white; padding: 20px; border-radius: 12px;
            border: 1px solid #eee; box-shadow: 0 4px 15px rgba(0,0,0,0.03); text-align: center;
        }
        .dash-number { font-size: 24px; font-weight: 800; color: #000; display: block; }
        .dash-label { font-size: 11px; text-transform: uppercase; color: #888; font-weight: 700; letter-spacing: 1px; margin-top: 5px;}

        /* FILTROS */
        .filter-bar { display: flex; gap: 10px; margin-bottom: 20px; overflow-x: auto; padding-bottom: 5px; }
        .filter-btn {
            background: white; border: 1px solid #ddd; padding: 8px 16px; border-radius: 20px;
            font-size: 12px; font-weight: 600; cursor: pointer; transition: 0.2s; white-space: nowrap;
        }
        .filter-btn:hover, .filter-btn.active { background: black; color: white; border-color: black; }

        /* LISTA DE PEDIDOS */
        .orders-list { display: flex; flex-direction: column; gap: 15px; }
        
        .order-card { 
            background: white; border: 1px solid #eee; border-radius: 10px; 
            transition: 0.3s; overflow: hidden;
        }
        .order-card:hover { border-color: #ccc; box-shadow: 0 5px 20px rgba(0,0,0,0.05); }

        /* RESUMO */
        .order-summary { 
            padding: 20px; cursor: pointer; display: flex; justify-content: space-between; align-items: center;
            background: #fff;
        }
        .order-summary:hover { background: #fafafa; }
        
        .client-info h4 { margin: 0; font-size: 15px; font-weight: 700; color: #111; }
        .client-info small { color: #666; font-size: 12px; display: block; margin-top: 2px; }

        .order-meta { text-align: right; }
        .meta-price { font-weight: 800; font-size: 16px; display: block; margin-bottom: 4px; color: #000; }
        
        .badge-status { padding: 4px 10px; border-radius: 4px; font-size: 10px; font-weight: bold; text-transform: uppercase; }
        .st-aguardando { background: #FFF4E5; color: #B76E00; }
        .st-pago { background: #EDF7ED; color: #1E4620; }
        .st-enviado { background: #E5F6FD; color: #014361; }
        .st-cancel { background: #FFEBEE; color: #C62828; }

        /* DETALHES */
        .order-details { display: none; padding: 25px; background: #fdfdfd; border-top: 1px solid #eee; }
        .order-details.open { display: block; animation: fadeIn 0.3s; }

        /* GRID DE INFORMAÇÕES (3 Colunas) */
        .details-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 30px; margin-bottom: 25px; }
        .col-title { font-weight: bold; font-size: 11px; text-transform: uppercase; color: #999; margin-bottom: 10px; display: block; border-bottom: 1px solid #eee; padding-bottom: 5px; }
        .detail-row { margin-bottom: 6px; font-size: 13px; color: #444; }
        .detail-row strong { color: #000; }
        .detail-row a { color: #007bff; text-decoration: underline; }

        /* TABELA DE ITENS (MELHORADA COM FOTO) */
        .items-table { width: 100%; border-collapse: collapse; margin-top: 10px; background: white; border-radius: 8px; border: 1px solid #eee; }
        .items-table th { text-align: left; background: #f8f8f8; padding: 12px; font-size: 11px; text-transform: uppercase; color: #555; }
        .items-table td { padding: 12px; border-bottom: 1px solid #eee; font-size: 13px; vertical-align: middle; }
        
        .item-thumb { width: 40px; height: 50px; object-fit: cover; border-radius: 4px; border: 1px solid #eee; margin-right: 10px; vertical-align: middle; }

        /* AÇÕES */
        .action-bar { 
            background: white; padding: 15px; border-radius: 8px; margin-top: 25px; border: 1px solid #eee;
            display: flex; gap: 10px; align-items: center; justify-content: space-between;
        }
        .tracking-input { flex: 1; padding: 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 13px; }
        .status-select { padding: 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 13px; }
        .btn-save { background: black; color: white; border: none; padding: 10px 25px; border-radius: 4px; font-weight: bold; cursor: pointer; }
        .btn-save:hover { background: #333; }

        @media (max-width: 768px) {
            .details-grid { grid-template-columns: 1fr; gap: 20px; }
            .action-bar form { flex-direction: column; width: 100%; }
            .tracking-input, .status-select, .btn-save { width: 100%; }
            
            /* Ajuste filtros mobile */
            .filter-bar { flex-wrap: wrap; overflow: visible; justify-content: center; }
            .filter-btn { flex: 1 1 45%; text-align: center; }
        }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(-5px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>
    <%- include('../partials/header.ejs') %>

    <main class="admin-container">
        <div style="text-align: center; margin-bottom: 30px;">
            <h1 style="font-family: 'Playfair Display'; font-size: 28px;">Painel de Vendas</h1>
        </div>

        <!-- 1. DASHBOARD -->
        <div class="dashboard-grid">
            <div class="dash-card">
                <span class="dash-number" style="color: #2ecc71;">R$ <%= stats.totalSales.toFixed(2).replace('.', ',') %></span>
                <span class="dash-label">Faturamento Total</span>
            </div>
            <div class="dash-card">
                <span class="dash-number"><%= stats.paid %></span>
                <span class="dash-label">Para Enviar</span>
            </div>
            <div class="dash-card">
                <span class="dash-number" style="color: #f39c12;"><%= stats.pending %></span>
                <span class="dash-label">Aguardando Pagamento</span>
            </div>
            <div class="dash-card">
                <span class="dash-number" style="color: #3498db;"><%= stats.shipped %></span>
                <span class="dash-label">Enviados / Finalizados</span>
            </div>
        </div>

        <!-- 2. FILTROS -->
        <div class="filter-bar">
            <button class="filter-btn active" onclick="filterOrders('todos', this)">Todos</button>
            <button class="filter-btn" onclick="filterOrders('pago', this)">A Enviar</button>
            <button class="filter-btn" onclick="filterOrders('pendente', this)">Pendentes</button>
            <button class="filter-btn" onclick="filterOrders('enviado', this)">Histórico</button>
        </div>

        <!-- 3. LISTA DE PEDIDOS -->
        <div class="orders-list">
            <% if (orders.length > 0) { %>
                <% orders.forEach(order => { %>

                    <% 
                        let filterClass = 'todos';
                        let s = order.status;
                        let badgeColor = 'st-aguardando';

                        if (s.includes('Pago') || s.includes('Preparando')) { filterClass += ' pago'; badgeColor = 'st-pago'; }
                        else if (s.includes('Aguardando')) { filterClass += ' pendente'; badgeColor = 'st-aguardando'; }
                        else if (s.includes('Enviado') || s.includes('Entregue')) { filterClass += ' enviado'; badgeColor = 'st-enviado'; }
                        else if (s.includes('Cancelado')) { filterClass += ' cancelado'; badgeColor = 'st-cancelado'; }
                    %>

                    <div class="order-card <%= filterClass %>">
                        
                        <!-- RESUMO -->
                        <div class="order-summary" onclick="toggleDetails('<%= order.id %>')">
                            <div class="client-info">
                                <h4><%= order.user.name %></h4>
                                <small><%= new Date(order.date).toLocaleDateString('pt-BR') %> • #<%= order.id.slice(0,6) %>...</small>
                            </div>
                            <div class="order-meta">
                                <span class="meta-price">R$ <%= parseFloat(order.totalPrice).toFixed(2).replace('.', ',') %></span>
                                <span class="badge-status <%= badgeColor %>"><%= order.status %></span>
                            </div>
                        </div>

                        <!-- DETALHES -->
                        <div class="order-details" id="detail-<%= order.id %>">
                            <div class="details-grid">
                                <!-- Coluna 1: Cliente -->
                                <div>
                                    <span class="col-title">Cliente</span>
                                    <div class="detail-row"><strong>Nome:</strong> <%= order.user.name %></div>
                                    <div class="detail-row"><strong>Email:</strong> <%= order.user.email %></div>
                                    <div class="detail-row"><strong>CPF:</strong> <%= order.user.cpf %></div>
                                    
                                    <!-- VISUALIZAÇÃO DO TELEFONE + BOTÃO CHAMAR -->
                                    <% if (order.user.phone) { %>
                                        <div class="detail-row" style="margin-top: 8px;">
                                            <strong>Tel:</strong> <%= order.user.phone %>
                                        </div>
                                        
                                        <!-- Botão Verde do WhatsApp -->
                                        <a href="https://wa.me/55<%= order.user.phone.replace(/\D/g, '') %>" 
                                           target="_blank"
                                           style="
                                               display: inline-flex; align-items: center; gap: 5px;
                                               background-color: #25d366; color: white; 
                                               padding: 6px 12px; border-radius: 4px; 
                                               text-decoration: none; font-size: 11px; font-weight: bold;
                                               margin-top: 5px;
                                           ">
                                            <i class="fab fa-whatsapp"></i> CHAMAR NO WhatsApp
                                        </a>
                                    <% } %>
                                    
                                </div>
                                
                                <!-- Coluna 2: Financeiro -->
                                <div>
                                    <span class="col-title">Financeiro</span>
                                    <div class="detail-row"><strong>Forma:</strong> <span style="text-transform:uppercase;"><%= order.paymentMethod %></span></div>
                                    <div class="detail-row"><strong>Subtotal:</strong> R$ <%= (order.subtotal || order.totalPrice).toFixed(2) %></div>
                                    
                                    <% if(order.discountTotal && order.subtotal > order.discountTotal) { %>
                                        <div class="detail-row" style="color: #27ae60;">
                                            <strong>Cupom (<%= order.couponUsed || 'ativo' %>):</strong> 
                                            - R$ <%= (order.subtotal - order.discountTotal).toFixed(2) %>
                                        </div>
                                    <% } %>
                                    
                                    <div class="detail-row"><strong>Frete:</strong> R$ <%= (order.shippingCost || 0).toFixed(2) %></div>
                                    <div class="detail-row" style="margin-top:5px; font-size:15px; color:#000;"><strong>TOTAL: R$ <%= order.totalPrice.toFixed(2) %></strong></div>
                                </div>

                                <!-- Coluna 3: Entrega (CORRIGIDA) -->
                                <div>
                                    <span class="col-title">Logística</span>
                                    <div class="detail-row"><strong>Método:</strong> <%= order.shippingMethod || 'Fixo' %></div>
                                    
                                    <div class="detail-row" style="margin-top:8px; padding:8px; background:#eee; border-radius:4px;">
                                        <!-- CORREÇÃO DO BUG DE ENDEREÇO VAZIO -->
                                        <% if (order.shippingMethod && order.shippingMethod.includes('Retirar')) { %>
                                            <strong style="color: #0f5132;"><i class="fas fa-store"></i> RETIRADA NA LOJA</strong>
                                            <br><small>O cliente irá buscar.</small>
                                        <% } else { %>
                                            <strong>Entrega em:</strong><br>
                                            <%= order.address.rua %>, <%= order.address.numero %><br>
                                            <%= order.address.bairro %><br>
                                            <%= order.address.cidade %> - <%= order.address.estado %><br>
                                            <strong>CEP:</strong> <%= order.address.cep %>
                                        <% } %>
                                    </div>

                                    <% if(order.trackingCode) { %>
                                        <div style="margin-top:5px;">
                                            <a href="https://www.linkcorreios.com.br/<%= order.trackingCode %>" target="_blank" style="color:#2ecc71; font-weight:bold; font-size:12px;">
                                                <i class="fas fa-truck"></i> Rastrear: <%= order.trackingCode %>
                                            </a>
                                        </div>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Tabela de Itens (COM FOTO E COR) -->
                            <span class="col-title" style="margin-bottom:5px;">Itens do Pedido</span>
                            <table class="items-table">
                                <tbody>
                                    <% order.items.forEach(item => { %>
                                        <tr>
                                            <td style="width: 50px;">
                                                <!-- Foto do Produto -->
                                                <img src="<%= item.imageUrl %>" class="item-thumb" alt="foto">
                                            </td>
                                            <td>
                                                <strong><%= item.title %></strong>
                                                <div style="font-size:11px; color:#666; margin-top:2px;">
                                                    <% if(item.color && item.color !== 'Única') { %>
                                                        <span style="display:inline-block; width:10px; height:10px; background:<%= item.color %>; border-radius:50%; border:1px solid #ccc; vertical-align:middle;"></span>
                                                    <% } %>
                                                    Tam: <%= item.size %> | Qtd: <%= item.qty %>
                                                </div>
                                            </td>
                                            <td style="text-align:right;"><strong>R$ <%= parseFloat(item.price).toFixed(2).replace('.', ',') %></strong></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>

                            <!-- Ações -->
                            <div class="action-bar">
                                <form action="/admin/atualizar-status" method="POST" style="display:flex; gap:10px; width:100%; flex-wrap:wrap; align-items:center;">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="orderId" value="<%= order.id %>">
                                    
                                    <strong style="white-space: nowrap;">Atualizar:</strong>
                                    
                                    <input type="text" name="trackingCode" class="tracking-input" 
                                           placeholder="Cole o Rastreio aqui" 
                                           value="<%= order.trackingCode || '' %>">
                                    
                                    <select name="status" class="status-select">
                                        <option value="Aguardando Pagamento" <%= order.status.includes('Aguardando') ? 'selected' : '' %>>Aguardando Pagamento</option>
                                        <option value="Pago / Preparando" <%= order.status.includes('Pago') ? 'selected' : '' %>>Pago / Preparando</option>
                                        <option value="Enviado" <%= order.status.includes('Enviado') ? 'selected' : '' %>>Enviado</option>
                                        <option value="Entregue" <%= order.status.includes('Entregue') ? 'selected' : '' %>>Entregue</option>
                                        <option value="Cancelado" <%= order.status.includes('Cancelado') ? 'selected' : '' %>>Cancelado</option>
                                    </select>
                                    
                                    <button type="submit" class="btn-save">Salvar</button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="text-align: center; padding: 40px; color: #999;">Nenhum pedido encontrado.</p>
            <% } %>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        function toggleDetails(id) {
            const el = document.getElementById('detail-' + id);
            el.classList.toggle('open');
        }

        function filterOrders(status, btn) {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const cards = document.querySelectorAll('.order-card');
            cards.forEach(card => {
                if (status === 'todos' || card.classList.contains(status)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }
    </script>
</body>
</html>