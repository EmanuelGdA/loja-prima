<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('../partials/head.ejs') %>
    <link rel="stylesheet" href="/css/auth.css">
    <style>
        .container { max-width: 600px; margin: 50px auto; padding: 20px; }
        .current-img-preview { margin-top: 10px; font-size: 13px; color: #666; }
        .current-img-preview a { color: blue; text-decoration: underline; }
        .frete-section { background: #f9f9f9; padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #eee; }
        .frete-title { font-weight: bold; margin-bottom: 10px; display: block; border-bottom: 1px solid #ddd; padding-bottom: 5px; font-size: 14px; }
        .frete-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    </style>
</head>
<body>
    <%- include('../partials/header.ejs') %>

    <main class="container">
        <h1 style="text-align: center; margin-bottom: 30px;">
            <%= editing ? 'Editar Produto' : 'Cadastrar Novo Produto' %>
        </h1>

        <!-- ATENÇÃO: O 'enctype' abaixo é OBRIGATÓRIO para envio de arquivos -->
        <form action="/admin/<%= editing ? 'editar-produto' : 'adicionar-produto' %>?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
            
           
            <% if (editing) { %>
                <input type="hidden" name="productId" value="<%= product.id %>">
                <input type="hidden" name="oldImageUrl" value="<%= product.imageUrl %>">
            <% } %>

            <div class="form-group">
                <label>Nome da Peça</label>
                <input type="text" name="title" value="<%= editing ? product.title : '' %>" required>
            </div>

            <!-- CAMPO DE UPLOAD DE IMAGEM -->
            <div class="form-group">
                <label>Foto do Produto (Do seu computador)</label>
                <input type="file" name="image" accept="image/*" <%= editing ? '' : 'required' %>>
                
                <% if (editing) { %>
                    <div class="current-img-preview">
                        Foto atual: <a href="<%= product.imageUrl %>" target="_blank">Ver imagem</a>
                        <br>
                        (Deixe em branco se não quiser trocar a foto)
                    </div>
                <% } %>
            </div>

            <!-- CATEGORIAS INTELIGENTES -->
            <div class="form-group">
                <label>Categoria Principal</label>
                <select name="categorySelect" id="catSelect" onchange="checkNewCat(this)" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px;">
                    <option value="vestidos" <%= (editing && product.category === 'vestidos') ? 'selected' : '' %>>Vestidos</option>
                    <option value="blusas" <%= (editing && product.category === 'blusas') ? 'selected' : '' %>>Blusas</option>
                    <option value="calcas" <%= (editing && product.category === 'calcas') ? 'selected' : '' %>>Calças</option>
                    <option value="conjuntos" <%= (editing && product.category === 'conjuntos') ? 'selected' : '' %>>Conjuntos</option>
                    <option value="acessorios" <%= (editing && product.category === 'acessorios') ? 'selected' : '' %>>Acessórios</option>
                    <option value="new" style="font-weight: bold; color: blue;">+ Criar Nova Categoria</option>
                </select>
                
                <!-- Input que aparece só se escolher "Criar Nova" -->
                <input type="text" name="newCategory" id="newCatInput" placeholder="Digite o nome da nova categoria" style="display: none; margin-top: 10px;">
            </div>

            <div class="form-group">
                <label>Sub-Categoria (Opcional)</label>
                <input type="text" name="subcategory" placeholder="Ex: Longo, Estampado, Festa..." value="<%= editing && product.subcategory ? product.subcategory : '' %>">
            </div>

            <div class="form-group">
                <label>Preço (R$)</label>
                <input type="number" name="price" step="0.01" value="<%= editing ? product.price : '' %>" required>
            </div>

            <!-- === INÍCIO DO CÓDIGO NOVO (FRETE) === -->
            <div class="frete-section">
                <span class="frete-title"><i class="fas fa-box"></i> Informações para Frete (Pacote)</span>
                
                <div class="frete-grid">
                    <div class="form-group">
                        <label>Peso (kg)</label>
                        <!-- Se estiver editando, mostra o peso salvo. Se for novo, sugere 0.3 -->
                        <input type="number" name="weight" step="0.001" placeholder="Ex: 0.300" 
                               value="<%= editing && product.weight ? product.weight : '0.3' %>" required>
                    </div>
                    <div class="form-group">
                        <label>Altura (cm)</label>
                        <input type="number" name="height" placeholder="Ex: 5" 
                               value="<%= editing && product.height ? product.height : '5' %>" required>
                    </div>
                    <div class="form-group">
                        <label>Largura (cm)</label>
                        <input type="number" name="width" placeholder="Ex: 20" 
                               value="<%= editing && product.width ? product.width : '20' %>" required>
                    </div>
                    <div class="form-group">
                        <label>Comprimento (cm)</label>
                        <input type="number" name="length" placeholder="Ex: 20" 
                               value="<%= editing && product.length ? product.length : '20' %>" required>
                    </div>
                </div>
                <small style="color: #666; font-size: 11px;">* Medidas aproximadas do pacote dobrado.</small>
            </div>
            <!-- === FIM DO CÓDIGO NOVO === -->

            <div class="form-group">
                <label>Descrição</label>
                <textarea name="description" rows="5" required><%= editing ? product.description : '' %></textarea>
            </div>

            <button type="submit" class="btn-auth" style="background: black;">
                <%= editing ? 'Salvar Alterações' : 'Cadastrar Produto' %>
            </button>
        </form>
    </main>

    <!-- Script para mostrar/esconder o campo de nova categoria -->
    <script>
        function checkNewCat(select) {
            const input = document.getElementById('newCatInput');
            if (select.value === 'new') {
                input.style.display = 'block';
                input.required = true;
                input.focus();
            } else {
                input.style.display = 'none';
                input.required = false;
                input.value = '';
            }
        }
        
        // Verifica ao carregar a página (caso esteja editando uma categoria customizada)
        window.onload = function() {
            const select = document.getElementById('catSelect');
            const editingCategory = "<%= editing ? product.category : '' %>";
            
            // Se a categoria salva não estiver na lista padrão, marcamos como "Nova" ou ajustamos (lógica simples)
            // Para simplificar, mantemos o select padrão. Se quiser algo avançado, teríamos que popular o select dinamicamente.
        };
    </script>

    <%- include('../partials/footer.ejs') %>
</body>
</html>