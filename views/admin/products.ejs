<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('../partials/head.ejs') %>
    <style>
        .admin-list { max-width: 1000px; margin: 40px auto; padding: 0 20px; }
        
        /* Cabeçalho da Página */
        .header-actions { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            margin-bottom: 30px; 
            border-bottom: 1px solid #eee;
            padding-bottom: 20px;
        }
        .header-actions h1 { font-family: 'Playfair Display'; font-size: 28px; margin: 0; }
        .btn-new { 
            background: black; color: white; padding: 12px 25px; 
            border-radius: 30px; font-size: 14px; font-weight: bold; 
            text-transform: uppercase; letter-spacing: 1px;
            display: flex; align-items: center; gap: 8px;
        }
        .btn-new:hover { background: #333; transform: translateY(-2px); }

        /* Lista de Produtos */
        .product-list { display: flex; flex-direction: column; gap: 15px; }

        .product-item { 
            background: white; 
            border: 1px solid #f0f0f0; 
            border-radius: 12px;
            padding: 15px; 
            display: flex; 
            align-items: center; 
            justify-content: space-between;
            box-shadow: 0 4px 10px rgba(0,0,0,0.03);
            transition: 0.2s;
        }
        .product-item:hover { box-shadow: 0 8px 15px rgba(0,0,0,0.08); }

        /* Informações do Produto */
        .prod-info { display: flex; align-items: center; gap: 20px; flex: 1; }
        
        .prod-thumb { 
            width: 70px; height: 70px; 
            border-radius: 8px; 
            object-fit: cover; 
            border: 1px solid #eee;
            background-color: #f9f9f9;
        }

        .prod-text strong { display: block; font-size: 16px; margin-bottom: 4px; color: #111; }
        .prod-text p { font-size: 13px; color: #666; margin: 0; }
        .prod-price { color: #000; font-weight: bold; font-family: 'Montserrat'; }

        /* Ações (Botões) */
        .actions { display: flex; gap: 10px; }
        
        .btn-action { 
            padding: 8px 16px; 
            border-radius: 6px; 
            font-size: 13px; 
            font-weight: 600; 
            border: none; 
            cursor: pointer;
            text-align: center;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: 0.2s;
        }
        .btn-edit { background: #fff3cd; color: #856404; border: 1px solid #ffeeba; }
        .btn-delete { background: #f8d7da; color: #842029; border: 1px solid #f5c6cb; }
        
        .btn-edit:hover { background: #ffe69c; }
        .btn-delete:hover { background: #f1aeb5; }

        /* --- RESPONSIVO PARA CELULAR --- */
        @media (max-width: 768px) {
            .header-actions { 
                flex-direction: column; 
                align-items: stretch; /* Estica para ocupar largura */
                gap: 15px; 
                text-align: center;
            }
            .btn-new { justify-content: center; width: 100%; }

            .product-item {
                flex-direction: column; /* Um item embaixo do outro */
                align-items: stretch;
                padding: 15px;
                gap: 15px;
            }

            .prod-info { margin-bottom: 0; } /* Foto e Texto em cima */
            
            .actions { 
                display: grid; 
                grid-template-columns: 1fr 1fr; /* Dois botões lado a lado ocupando tudo */
                gap: 10px;
                border-top: 1px solid #f5f5f5;
                padding-top: 15px;
            }
            
            .btn-action { justify-content: center; padding: 12px; }
        }
    </style>
</head>
<body>
    <%- include('../partials/header.ejs') %>

    <main class="admin-list">
        <div class="header-actions">
            <h1>Gerenciar Produtos</h1>
            <a href="/admin/adicionar-produto" class="btn-new">
                <i class="fas fa-plus"></i> Novo Produto
            </a>
        </div>

        <div class="product-list">
            <% if (products.length > 0) { %>
                <% products.forEach(prod => { %>
                    <div class="product-item">
                        <div class="prod-info">
                            <!-- Imagem -->
                            <img src="<%= prod.imageUrl %>" alt="<%= prod.title %>" class="prod-thumb">
                            
                            <!-- Texto -->
                            <div class="prod-text">
                                <strong><%= prod.title %></strong>
                                <p class="prod-price">R$ <%= parseFloat(prod.price).toFixed(2).replace('.', ',') %></p>
                                <p style="font-size: 11px; text-transform: uppercase; color: #999; margin-top: 3px;">
                                    <%= prod.category %>
                                </p>
                            </div>
                        </div>
                        
                        <!-- Botões de Ação -->
                        <div class="actions">
                            <a href="/admin/editar-produto/<%= prod.id %>" class="btn-action btn-edit">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                            
                            <form action="/admin/excluir-produto" method="POST" onsubmit="return confirm('Tem certeza que quer apagar?');" style="display:contents;">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="productId" value="<%= prod.id %>">
                                <button type="submit" class="btn-action btn-delete">
                                    <i class="fas fa-trash"></i> Excluir
                                </button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div style="text-align: center; padding: 50px; color: #666;">
                    <i class="fas fa-tshirt" style="font-size: 40px; margin-bottom: 10px; color: #ddd;"></i>
                    <p>Nenhum produto cadastrado.</p>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>
</body>
</html>