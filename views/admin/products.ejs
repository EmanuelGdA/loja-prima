<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('../partials/head.ejs') %>
    <style>
        .admin-list { max-width: 1000px; margin: 40px auto; padding: 20px; }
        .product-item { 
            display: flex; align-items: center; justify-content: space-between; 
            background: white; border: 1px solid #eee; padding: 15px; margin-bottom: 10px; border-radius: 4px;
        }
        .prod-info { display: flex; align-items: center; gap: 15px; }
        .prod-info img { width: 50px; height: 50px; object-fit: cover; border-radius: 4px; border: 1px solid #ddd; }
        .actions { display: flex; gap: 10px; }
        
        .btn-edit { background: #ffc107; color: black; padding: 8px 15px; border-radius: 4px; font-size: 13px; border: none; font-weight: bold; }
        .btn-delete { background: #dc3545; color: white; padding: 8px 15px; border-radius: 4px; font-size: 13px; border: none; cursor: pointer; font-weight: bold; }
        
        .header-actions { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
        .btn-new { background: black; color: white; padding: 10px 20px; border-radius: 4px; font-size: 14px; font-weight: bold; }
    </style>
</head>
<body>
    <%- include('../partials/header.ejs') %>

    <main class="admin-list">
        <div class="header-actions">
            <h1>Gerenciar Produtos</h1>
            <a href="/admin/adicionar-produto" class="btn-new">+ Novo Produto</a>
        </div>

        <% if (products.length > 0) { %>
            <% products.forEach(prod => { %>
                <div class="product-item">
                    <div class="prod-info">
                        <!-- Mostra a imagem pequena -->
                        <img src="<%= prod.imageUrl %>" alt="<%= prod.title %>">
                        <div>
                            <strong><%= prod.title %></strong>
                            <p style="font-size: 12px; color: #666;">
                                R$ <%= parseFloat(prod.price).toFixed(2).replace('.', ',') %> | <%= prod.category %>
                            </p>
                        </div>
                    </div>
                    
                    <div class="actions">
                        <!-- Botão Editar -->
                        <a href="/admin/editar-produto/<%= prod.id %>" class="btn-edit">Editar</a>
                        
                        <!-- Botão Excluir (Formulário para segurança) -->
                        <form action="/admin/excluir-produto" method="POST" onsubmit="return confirm('Tem certeza que quer apagar este produto?');">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="productId" value="<%= prod.id %>">
                            <button type="submit" class="btn-delete">Excluir</button>
                        </form>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div style="text-align: center; padding: 50px; background: #f9f9f9;">
                <p>Nenhum produto cadastrado.</p>
                <br>
                <a href="/admin/adicionar-produto" style="text-decoration: underline;">Cadastre o primeiro agora</a>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer.ejs') %>
</body>
</html>